{
"1":{"i": "Каждое уравнение приводим к одному основанию → линейная система.", "s": ["2^x · 2^(2y) = 2⁵ → x + 2y = 5.", "3^(2x) / 3^y = 3¹ → 2x − y = 1.", "y = 2x − 1 → x + 4x − 2 = 5 → x = 7/5, y = 9/5."], "n": ["D (1; 1) — 1 + 2 ≠ 5.", "A, B, E — не удовлетворяют системе."], "t": "Проверьте ответ в обоих уравнениях."},
"2":{"i": "Объёмы подобных тел ∝ k³.", "s": ["54/16 = 27/8 → k = ∛(27/8) = 3/2.", "Высота: 4 · 1,5 = 6 см."], "n": ["E (13,5) — умножили на 27/8.", "C (9) — на 9/4.", "B, D — неверно."], "t": "Из отношения объёмов → кубический корень."},
"3":{"i": "Возводим B в квадрат и делим степени.", "s": ["B² = 4 · 10⁻⁶.", "P = 4 · 10⁵ / (4 · 10⁻⁶) = 10¹¹."], "n": ["A — не стандартная форма.", "C, D, E — ошибки в степени."], "t": "10⁵ / 10⁻⁶ = 10¹¹."},
"4":{"i": "Виета + α² + β² = (α + β)² − 2αβ.", "s": ["α + β = 5/2, αβ = k/2.", "25/4 − k = 13/4 → k = 3."], "n": ["A, B, D, E — не дают 13/4."], "t": "Не забывайте делить на a = 2."},
"5":{"i": "Площади подобных треугольников ∝ k².", "s": ["S(ABC) = 16 + 33 = 49.", "AD/AB = √(16/49) = 4/7.", "AD : DB = 4 : 3."], "n": ["B (4 : 7) — AD : AB.", "A, E — отношение площадей.", "D — перевёрнуто."], "t": "DB = AB − AD → 7 − 4 = 3."},
"6":{"i": "Изолируем корень, возводим в квадрат.", "s": ["T/(2π) = √(L/g).", "T²/(4π²) = L/g.", "g = 4π²L/T²."], "n": ["A — перевёрнуто и π не в квадрате.", "B, D — L потеряна."], "t": "Проверка: g растёт при уменьшении T — ✓ (T в знаменателе)."},
"7":{"i": "Не пересекаются — параллельны: одинаковый наклон, разный свободный член.", "s": ["Наклоны: 5, 2, 5, −5.", "1 и 3: оба 5, перехваты −2 и 10 → параллельны."], "n": ["A, C, D — разные наклоны → пересекаются."], "t": "Наклоны 5 и −5 — не параллельны."},
"8":{"i": "Объём конуса + объём полушара.", "s": ["Конус: ⅓π · 36 · 8 = 96π.", "Полушар: ⅔π · 216 = 144π.", "240π."], "n": ["D — только конус.", "B — целый шар без конуса.", "C, E — неверно."], "t": "Полушар = ⅔πr³."},
"9":{"i": "Сокращаем вторую дробь, затем общий знаменатель.", "s": ["(x² − 4)/(x² + 5x + 6) = (x − 2)(x + 2)/((x + 2)(x + 3)) = (x − 2)/(x + 3).", "Общий знаменатель (x + 2)(x + 3).", "x(x + 3) − (x − 2)(x + 2) = x² + 3x − x² + 4 = 3x + 4.", "(3x + 4)/(x² + 5x + 6)."], "n": ["C — знак у 4.", "A, D — неверно."], "t": "−(x − 2)(x + 2) = −x² + 4 — следите за знаком."},
"11":{"i": "Касающиеся окружности: расстояния между центрами = суммы радиусов.", "s": ["AB = 8, AC = 5, BC = 7.", "По теореме косинусов в B: cos B = (64 + 49 − 25)/(2 · 8 · 7) = 88/112 = 11/14.", "∠ABC = arccos(11/14)."], "n": ["C — косинус для другого угла.", "A, D, E — «красивые» углы, не подходят."], "t": "Угол π/3 при A — проверка: 7² = 64 + 25 − 40 ✓."},
"14":{"i": "Серединный перпендикуляр: через середину, наклон −1/k.", "s": ["Середина: (1; 3).", "Наклон AB = −4/6 = −2/3 → перпендикуляр 3/2.", "y = 1,5(x − 1) + 3 = 1,5x + 1,5."], "n": ["B, E — наклон самого AB.", "C, D — неверный перехват."], "t": "Проверка: середина (1; 3) на прямой: 1,5 + 1,5 = 3 ✓."},
"15":{"i": "Порядок действий: скобки изнутри.", "s": ["5² − 3 · 7 = 25 − 21 = 4.", "2 · 4 + √625 = 8 + 25 = 33.", "4√33 + 12 = 4(√33 + 3)."], "n": ["A — забыли 12.", "B, D — неверный множитель."], "t": "Вынесите общий множитель 4."},
"17":{"i": "Высота из A делит основание пополам.", "s": ["Половина основания 6, высота √(100 − 36) = 8.", "tg B = 8/6 = 4/3."], "n": ["A — перевёрнуто.", "C, D — с гипотенузой.", "E — неверно."], "t": "6-8-10 — пифагорова тройка."},
"18":{"i": "Спорт — 7 частей из 14.", "s": ["1 часть = 2800/7 = 400.", "Всего 14 · 400 = 5600."], "n": ["A–D — неверное число частей."], "t": "Сумма частей 3 + 4 + 7 = 14."},
"20":{"i": "Сегмент = четверть круга − прямоугольный треугольник.", "s": ["Четверть: ¼ · 3,14 · 100 = 78,5.", "Треугольник: ½ · 10 · 10 = 50.", "Сегмент: 28,5 см²."], "n": ["D — вся четверть.", "C — треугольник.", "A — неверно."], "t": "Сегмент всегда = сектор − треугольник."},
"21":{"i": "Переносим 1 влево и решаем методом интервалов.", "s": ["(2x − 5)/(x + 3) − 1 = (x − 8)/(x + 3) ≤ 0.", "Нули: 8 (входит), −3 (выколота).", "−3 < x ≤ 8."], "n": ["B — противоположные промежутки.", "C — неверный корень.", "D, E — неполно."], "t": "Нельзя умножать на (x + 3) без учёта знака — используйте интервалы."},
"22":{"i": "Упрощаем суммы одинаковых степеней.", "s": ["4 · 4^x = 2² · 2^(2x) = 2^(2x+2).", "2 · 8^x = 2^(3x+1).", "2^(2x + 2 − 3x − 1) = 2^(1 − x) = 2¹⁰ → x = −9."], "n": ["E — знак.", "B, C, D — неверно."], "t": "4^x + 4^x + 4^x + 4^x = 4 · 4^x."},
"23":{"i": "Площадь сектора = ½ · r · дуга.", "s": ["27 = ½ · r · 9 → r = 6.", "Круг: 36π.", "Остаток: 36π − 27."], "n": ["A — весь круг.", "B, C — неверный радиус.", "E — неверно."], "t": "Удобная формула без угла: S = ½rl."},
"24":{"i": "Две точки пересечения ⇔ D > 0.", "s": ["x² + 3x − (4 + k) = 0.", "D = 9 + 4(4 + k) > 0 → 25 + 4k > 0 → k > −25/4."], "n": ["B — нет пересечения.", "C, D, E — ошибка в знаке."], "t": "Перенесите всё в одну сторону перед вычислением D."},
"25":{"i": "Возрасты 4s и s; через 20 лет отношение 2 : 1.", "s": ["4s + 20 = 2(s + 20) → 2s = 20 → s = 10, отец 40.", "Через 5 лет: 15 + 45 = 60."], "n": ["Остальные — сумма сейчас (50) или ошибки."], "t": "Через 5 лет прибавляем 5 к <b>каждому</b>."},
"26":{"i": "Действия с векторами покомпонентно.", "s": ["4a = (8; 12); −b = (−5; −6); 2c = (−8; −4).", "Сумма: (−5; 2)."], "n": ["C, D — ошибки знаков.", "A, E — неверно."], "t": "Считайте x и y отдельно."},
"27":{"i": "Вычитаем из прямоугольника четыре угловых треугольника.", "s": ["AB = 4a, BC = 3b → 12ab = 120 → ab = 10.", "Угловые треугольники: ½ · 3a · b, ½ · 2b · a, ½ · 3a · b, ½ · 2b · a.", "Сумма: 1,5ab + ab + 1,5ab + ab = 5ab = 50.", "EFGH = 120 − 50 = 70."], "n": ["A (50) — площадь треугольников.", "B, D — неверные отрезки."], "t": "Удобно задать стороны кратными знаменателям (4a, 3b)."},
"28":{"i": "n-й член = Sₙ − Sₙ₋₁.", "s": ["S₆ = 144 − 6 = 138.", "S₅ = 100 − 5 = 95.", "a₆ = 43."], "n": ["B (138) — это S₆.", "C, D, E — неверно."], "t": "aₙ = Sₙ − Sₙ₋₁ — универсальная формула."},
"29":{"i": "Числа 3k и 5k.", "s": ["(3k + 4)/(5k + 4) = 2/3 → 9k + 12 = 10k + 8 → k = 4.", "Меньшее: 12."], "n": ["A, C, D, E — не дают 2 : 3."], "t": "Проверка: 16/24 = 2/3 ✓."},
"30":{"i": "Полные квадраты.", "s": ["(x − 3)² − 9 + (y + 4)² − 16 = 0.", "(x − 3)² + (y + 4)² = 25 → центр (3; −4), r = 5."], "n": ["B, E — знаки.", "C, E — радиус = r².", "D — без деления на 2."], "t": "Окружность проходит через начало координат (свободного члена нет)."}
}
