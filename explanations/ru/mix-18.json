{
"1":{"i": "Приводим обе части к основанию 2.", "s": ["8^(x−1) = 2^(3x−3); 4^(x+1) = 2^(2x+2).", "3x − 3 = 2x + 2 → x = 5."], "n": ["A–D — не удовлетворяют: например, x = 3: 8² = 64 ≠ 4⁴ = 256."], "t": "Проверка: 8⁴ = 4096 = 4⁶ ✓."},
"2":{"i": "AC — диаметр, значит, углы B и D прямые. Заштриховано: круг − четырёхугольник ABCD.", "s": ["Треугольник ABC (30-60-90): BC = 6 → AC = 12 (r = 6), AB = 6√3.", "S(ABC) = ½ · 6 · 6√3 = 18√3.", "Треугольник ACD (45-45-90): AD = CD = 6√2 → S = 36.", "Заштриховано: 36π − (18√3 + 36)."], "n": ["C — посчитан только удвоенный ABC.", "D — знак у 18√3.", "A, E — неверно."], "t": "Вписанный угол, опирающийся на диаметр, — 90°."},
"3":{"i": "(n − 2) · 180°, затем делим на n.", "s": ["Сумма: 8 · 180° = 1440°.", "Каждый: 144°."], "n": ["A, C, D, E — неверное n."], "t": "Внешний угол 36° → внутренний 144°."},
"4":{"i": "6s² = s³.", "s": ["s = 6."], "n": ["A, B, D, E — не удовлетворяют."], "t": "Классика: у куба со стороной 6 площадь и объём = 216."},
"5":{"i": "Центр — середина диаметра.", "s": ["((−2 + 4)/2; (3 − 1)/2) = (1; 1)."], "n": ["B, C, D, E — ошибки в среднем."], "t": "Середина = среднее координат."},
"6":{"i": "Считаем каждую величину.", "s": ["w: простые, кратные 3 — только 3 → 1.", "x: квадраты не бывают простыми → 0.", "y: 11, 13, 17, 19 → 4.", "z: нечётные простые < 10: 3, 5, 7 → 3.", "Сумма 8."], "n": ["B, D — посчитали 2 нечётным или 9 простым.", "A, E — неверно."], "t": "2 — единственное чётное простое."},
"7":{"i": "Подставляем a = 4, b = 9.", "s": ["b² = 81; a + √b = 4 + 3 = 7.", "81/7."], "n": ["C — √9 = 4?", "A — без знаменателя.", "D, E — неверно."], "t": "√9 = 3."},
"8":{"i": "Площади подобных ∝ k².", "s": ["k = 6/4 = 1,5 → k² = 2,25.", "20 · 2,25 = 45."], "n": ["A (30) — умножили на k.", "B, D, E — неверно."], "t": "Высоты тоже соответствуют коэффициенту подобия."},
"9":{"i": "Взвешенное среднее.", "s": ["Суммы: 20 · 70 = 1400; 30 · 80 = 2400.", "3800/50 = 76."], "n": ["B (75) — простое среднее 70 и 80, без учёта размеров классов.", "A, D, E — неверно."], "t": "Больший класс сильнее влияет на среднее."},
"11":{"i": "Боковая поверхность конуса πrl, l — образующая.", "s": ["l = √(25 + 144) = 13.", "π · 5 · 13 = 65π."], "n": ["A — высота вместо образующей.", "D — 2πrl.", "C, E — неверно."], "t": "Боковая поверхность использует образующую, а не высоту."},
"12":{"i": "Найдём угол в точке B между направлениями.", "s": ["Обратно на A — пеленг 060° + 180° = 240°.", "На C — 150°.", "Угол: 240° − 150° = 90°.", "AC = √(40² + 30²) = 50 км."], "n": ["B (70) — сложили расстояния.", "C, D, E — неверный угол."], "t": "Обратный пеленг = пеленг ± 180°."},
"13":{"i": "Сначала g, затем f.", "s": ["g(5) = √5.", "f(√5) = 5 + 3 = 8."], "n": ["D — f(5) − 3?", "A, C, E — неверный порядок."], "t": "(√5)² = 5."},
"14":{"i": "Прямой угол между касательной и радиусом; высота в прямоугольном треугольнике.", "s": ["OT = √(169 − 144) = 5.", "OD = OT²/OP = 25/13.", "TD = OT · PT / OP = 60/13.", "S = ½ · 25/13 · 60/13 = 750/169."], "n": ["C — без ½.", "A, B, E — неверно."], "t": "Высота к гипотенузе: h = ab/c."},
"15":{"i": "a⁶b³ = (a²b)³.", "s": ["(a²b)³ = 125.", "(125 − 5)/5 = 24."], "n": ["E (124) — без деления.", "D (25) — (a²b)².", "A, B — неверно."], "t": "Ищите выражение через данную комбинацию."},
"16":{"i": "Обгон = отрыв на один круг (400 м).", "s": ["Скорость сближения: 5 − 3 = 2 м/с.", "400/2 = 200 с."], "n": ["A (80) — 400/5.", "B (133,3) — 400/3.", "D, E — неверно."], "t": "В одну сторону — разность скоростей."},
"17":{"i": "Теорема косинусов, затем периметр.", "s": ["BC² = 25 + 64 − 2 · 5 · 8 · ½ = 49 → BC = 7.", "P = 5 + 8 + 7 = 20."], "n": ["A — без одной стороны.", "B, D, E — неверно."], "t": "5-7-8 с углом 60° — частый «красивый» треугольник."},
"18":{"i": "Разложение на простые множители.", "s": ["24 = 2³ · 3; 90 = 2 · 3² · 5; 120 = 2³ · 3 · 5.", "НОК: 2³ · 3² · 5 = 360.", "НОД: 2 · 3 = 6."], "n": ["B, E — НОД 12 не делит 90.", "C, D — неверный НОК."], "t": "НОК — максимальные степени, НОД — минимальные."},
"19":{"i": "(x − 3)(x + 2) ≥ 0.", "s": ["Корни −2 и 3.", "Ветви вверх, ≥ 0 снаружи: x ≤ −2 или x ≥ 3."], "n": ["A — промежуток для ≤ 0.", "C, D — неверные корни.", "E — только граничные точки."], "t": "≥ 0 при ветвях вверх — вне корней."},
"20":{"i": "Полные квадраты.", "s": ["(x − 2)² + (y + 3)² = 3 + 4 + 9 = 16 → r = 4."], "n": ["D — r².", "E — √16 = 4, но записано не в простейшем виде.", "A, B — неверно."], "t": "r² = свободный член после переноса."},
"21":{"i": "Умножаем на сопряжённое √5 + 1.", "s": ["(√5 − 1)(√5 + 1) = 4.", "4(√5 + 1)/4 = √5 + 1."], "n": ["B — забыли сократить.", "D — неверно сократили.", "C, E — неверно."], "t": "Сопряжённое убирает корень."},
"22":{"i": "Уравнение по количеству спирта.", "s": ["0,1 · 20 + 0,4b = 0,2(20 + b).", "2 + 0,4b = 4 + 0,2b → b = 10 л."], "n": ["Остальные — не дают 20%."], "t": "Правило рычага: (20 − 10) : (40 − 20) = 1 : 2 → B вдвое меньше A."},
"23":{"i": "Внешний угол вписанного четырёхугольника равен противоположному внутреннему.", "s": ["∠ABC = 180° − 110° = 70°.", "∠CBE = 180° − 70° = 110°."], "n": ["A (70°) — это ∠ABC.", "B, C, E — неверно."], "t": "Внешний угол = противолежащий внутренний."},
"24":{"i": "x² = x + 2.", "s": ["x² − x − 2 = 0 → (x − 2)(x + 1) = 0 → x = 2, −1."], "n": ["C, D — знаки.", "A, E — неверно."], "t": "Проверка: x = −1: 1 = 1 ✓."},
"25":{"i": "Последовательные проценты.", "s": ["10 000 · 0,8 = 8000.", "8000 · 1,15 = 9200 → −8%."], "n": ["B — сложили −20% + 15% = −5%.", "C, D, E — неверно."], "t": "Рост считается от уже уменьшенной цены."},
"26":{"i": "Сумма арифметической прогрессии: n(a₁ + aₙ)/2.", "s": ["8 · (4 + 18)/2 = 88."], "n": ["C — без деления на 2.", "A — делили на 4.", "D, E — неверно."], "t": "Не нужна разность — достаточно первого и последнего."},
"27":{"i": "Записываем f(g(x)) и сравниваем.", "s": ["2(3x − 4) + k = 6x − 8 + k.", "−8 + k = −5 → k = 3."], "n": ["A — знак.", "B, D, E — неверно."], "t": "Сравнивайте свободные члены."},
"28":{"i": "Изолируем корень; проверяем корни.", "s": ["√(4x − 4) = 9 − x.", "4x − 4 = 81 − 18x + x² → x² − 22x + 85 = 0 → x = 5 или 17.", "x = 17: 9 − 17 < 0 ✗. x = 5: √16 = 4 ✓."], "n": ["A–D — не удовлетворяют уравнению."], "t": "Подстановка вариантов здесь самая быстрая."},
"30":{"i": "Параллелограмм с равными диагоналями — прямоугольник.", "s": ["Равные диагонали → все углы прямые.", "Это прямоугольник (не обязательно квадрат)."], "n": ["A — квадрат требует ещё равных сторон.", "C — ромб: перпендикулярные диагонали.", "D, E — неверно."], "t": "Равные диагонали — прямоугольник; перпендикулярные — ромб."}
}
