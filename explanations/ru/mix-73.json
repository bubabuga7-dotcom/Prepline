{
"1":{"i": "2 * 1 = 4 + 1 = 5.", "s": ["3 * 5 = 9 + 5 = 14. Ответ B."], "n": ["A — 9 + 3."], "t": "Сначала скобки."},
"2":{"i": "2¹⁶ − 16 = 16(2¹² − 1) = 16 · 4095.", "s": ["4095 = 3² · 5 · 7 · 13 → наибольший простой 13. Ответ C."], "n": ["D — 17 делит 2¹⁶ + 1."], "t": "2¹² − 1 = (2⁶ − 1)(2⁶ + 1)."},
"3":{"i": "x = 1: f(1 + f(1)) = f(5) = 4f(1).", "s": ["f(5) = 16. Ответ A."], "n": ["E — 4 + 20."], "t": "Подставьте x = 1."},
"4":{"i": "BN = BP, CM = CP.", "s": ["P = AB + BP + PC + AC = AN + AM = 14. Ответ C."], "n": ["A — без расчёта."], "t": "Отрезки касательных равны."},
"5":{"i": "A + D = (A + B) − (B + C) + (C + D).", "s": ["12 − 10 + 16 = 18. Ответ D."], "n": ["E — 20."], "t": "Комбинируйте суммы."},
"6":{"i": "(sin x + cos x)² = 1 + sin 2x.", "s": ["1,44 − 1 = 0,44. Ответ B."], "n": ["A — удвоили."], "t": "Возведите в квадрат."},
"7":{"i": "1/r + 1/s = (r + s)/(rs).", "s": ["6/2 = 3. Ответ B."], "n": ["D — только r + s."], "t": "Виета."},
"8":{"i": "Удалённое число = 60n − 70(n − 1) = 70 − 10n > 0.", "s": ["n < 7 → n = 6. Ответ E."], "n": ["A — без условия положительности."], "t": "Число должно быть положительным."},
"9":{"i": "Магическая сумма 5 × 5: 5 · 26/2 = 65.", "s": ["A = 65 − (20 + 13 + 6 + 4) = 22. Ответ E."], "n": ["C — 17."], "t": "n(n² + 1)/2."},
"10":{"i": "Последняя цифра как у 7⁸⁹; цикл 7, 9, 3, 1.", "s": ["89 ≡ 1 (mod 4) → 7. Ответ D."], "n": ["B — 3."], "t": "Цикл длины 4."},
"11":{"i": "(x + 1)(x² − x + 1) = x³ + 1 = 0.", "s": ["x³ = −1. Ответ A."], "n": ["C — знак."], "t": "Сумма кубов."},
"12":{"i": "Высота пересечения: 1/24 = 1/40 + 1/h.", "s": ["1/h = 1/60 → h = 60. Ответ D."], "n": ["E — 64."], "t": "«Гармоническое» правило."},
"13":{"i": "Варианты ≈ 1, поэтому имелось в виду √1,009 (опечатка).", "s": ["√(1 + 0,009) ≈ 1 + 0,0045 = 1,0045. Ответ B."], "n": ["A — 1,002."], "t": "√(1 + ε) ≈ 1 + ε/2."},
"14":{"i": "Сумма всех = 3⁷ = 2187; a₀ = 1, a₁ = 7, a₂ = C(7, 2) = 21.", "s": ["2187 − 29 = 2158. Ответ C."], "n": ["A — без a₂."], "t": "x² получается только из x · x."},
"16":{"i": "Каждый следующий периметр × 1/√2.", "s": ["1/(1 − 1/√2) = 2 + √2. Ответ D."], "n": ["E — удвоили."], "t": "Сумма бесконечной ГП."},
"17":{"i": "Кливленд должен выиграть 2 игры подряд: ¼.", "s": ["1 − ¼ = 0,75. Ответ D."], "n": ["A — 0,5."], "t": "Дополнение."},
"18":{"i": "x679y делится на 72 = 8 · 9.", "s": ["На 8: 79y → 792 → y = 2. На 9: x + 24 ⋮ 9 → x = 3. Ответ E."], "n": ["A — 7."], "t": "Признаки делимости."},
"19":{"i": "Посчитаем вино после двух переливаний и приравняем.", "s": ["x − 4 = 4(x − 4)/x → x = 4. Ответ B."], "n": ["Остальные не дают равенства."], "t": "Доля вина в отобранной части."},
"20":{"i": "Продлим AB и DC до точки E: ∠E = 50° = ∠D → AE = AD; ∠BCE = 50° → BE = BC.", "s": ["AD = AB + BC → периметр 2AD + 5 = 35 → AD = 15. Ответ A."], "n": ["D — 20."], "t": "Равнобедренные треугольники."},
"22":{"i": "Последний элемент Sₙ = 1 + 2 + … + n.", "s": ["100 · 101/2 = 5050. Ответ D."], "n": ["C — 5000."], "t": "Треугольные числа."},
"23":{"i": "4 числа с остатками 0, 0, 1, 1 — тройки с суммой ⋮ 3 нет.", "s": ["Из 5 чисел: либо три одинаковых остатка, либо все три остатка → n = 5. Ответ C."], "n": ["B — контрпример выше."], "t": "Принцип Дирихле."},
"24":{"i": "Чётный делитель: 2^a (a = 1…4), 3^b (0…2), 5^c (0…1).", "s": ["4 · 3 · 2 = 24. Ответ C."], "n": ["D — 30 − …"], "t": "Считайте показатели."},
"25":{"i": "Выбрать 2 неподвижных: C(7, 2) = 21; остальные 5 — беспорядок D₅ = 44.", "s": ["21 · 44 = 924. Ответ B."], "n": ["A — 900."], "t": "Подсказка в условии: D₅ = 44."},
"26":{"i": "Строка 2: 2 3 4 1. Строка 3: в столбце 4 — 2; a ∈ {1, 2} → a = 1, столбец 2 — 4.", "s": ["Строка 4: b = 1 (в столбце 2 уже 2, 3, 4). a + b = 2. Ответ A."], "n": ["Остальные — ошибка заполнения."], "t": "Латинский квадрат."},
"27":{"i": "1 − 0,8ⁿ > 0,6 → 0,8ⁿ < 0,4.", "s": ["0,8⁴ = 0,41, 0,8⁵ = 0,33 → n = 5. Ответ D."], "n": ["C — 0,41 > 0,4."], "t": "«Хотя бы один» = 1 − «ни одного»."},
"28":{"i": "Точка со степенью 4 соединена со всеми; со степенью 1 — только с ней.", "s": ["Точка со степенью 3 — с 4, 2 и 5; степень 2 — с 4 и 3. Значит l(5) = 2. Ответ C."], "n": ["Сумма степеней чётна."], "t": "Граф: степени вершин."},
"29":{"i": "Проверяем корни делителей.", "s": ["I: ω³ = 1 → 2 − 2ω ≠ 0 ✗. II: ζ³ = −1 → 0 ✔. III: ε⁵ = 1 → 0 ✔. IV: η⁵ = −1 → 0 ✔.", "II, III, IV. Ответ E."], "n": ["A — I не делит."], "t": "Корни из единицы."},
"30":{"i": "Вычтем первое: z + t + w = 0, 2z + t = 2, y + 2z + 3t + 4w = 1.", "s": ["y = 3, x = −2, остальные свободны.", "В варианте A минус потерян (x = −2 определяется однозначно). Ответ A."], "n": ["D — x и y определены.", "E — решения есть."], "t": "Исключение переменных."}
}
