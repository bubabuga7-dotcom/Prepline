{
"1":{"i":"Пифагор: (x + 3)² + (6x)² = (7x − 3)².","s":["37x² + 6x + 9 = 49x² − 42x + 9 → 12x² = 48x.","x = 4. Ответ B."],"n":["Остальные не дают прямоугольный треугольник."],"t":"Гипотенуза — самая длинная."},
"2":{"i":"Кэрол c, Брайан 3c, Энн 6c.","s":["10c = 400 → c = 40; Брайан 120 £. Ответ E."],"n":["A — доля Кэрол · 2."],"t":"Выразите всё через наименьшую долю."},
"3":{"i":"c^{3/4} = a^{3/2} · b^{3/2}.","s":["Возводим в степень 4/3: c = a²b². Ответ E."],"n":["A, B — лишний коэффициент."],"t":"Степень степени — перемножить."},
"4":{"i":"180 машин ↔ 360° → 1 машина = 2°.","s":["Жёлтых 50 : 2 = 25; чёрных столько же — 25. Ответ A."],"n":["D — зелёные/2."],"t":"Переведите градусы в штуки."},
"5":{"i":"Подставим (2, −1).","s":["2a − 3 − 5 = 0 → a = 4; 4 + b − 9 = 0 → b = 5.","a + b = 9. Ответ D."],"n":["Остальные — ошибка в знаке."],"t":"Точка лежит на обеих прямых."},
"6":{"i":"Касательная ⟂ радиусу: ∠ODA = 90°.","s":["В △AOD: ∠AOD = 30° → ∠DOC = 150°.","△ODC равнобедренный: ∠ODC = 15° → ∠CDE = 90° − 15° = 75°. Ответ B."],"n":["C — центральный угол."],"t":"Радиус к точке касания."},
"7":{"i":"Минутная 240°, часовая 150° + 20° = 170°.","s":["240 − 170 = 70°. Ответ B."],"n":["D — часовая на 5."],"t":"Часовая — 0,5° в минуту."},
"8":{"i":"0,5 · 1,5 = 0,75.","s":["75%. Ответ C."],"n":["D — проценты «сократились»."],"t":"Множители, не сумма."},
"9":{"i":"Два неравенства.","s":["x + 2 ≤ 5 + 3x → x ≥ −1,5.","5 + 3x ≤ 2x + 7 → x ≤ 2. Ответ B."],"n":["C — потерян знак."],"t":"Решайте части отдельно."},
"10":{"i":"НОК(3, 6, 9, 12, 15) = 180 с.","s":["3600 : 180 = 20 раз (не считая начального). Ответ B."],"n":["C — НОК 120."],"t":"Вместе — через НОК."},
"11":{"i":"f(x) = −2^{x+1} < 0 всегда; f(0) = −2.","s":["График ниже оси, проходит через (0; −2), уходит вниз вправо. Ответ D."],"n":["B — f(0) = −1.","A, E — выше оси."],"t":"Проверьте точку x = 0."},
"12":{"i":"Домножим на √3 + √2; знаменатель 3 − 2 = 1.","s":["3√2(√3 + √2) = 3√6 + 6. Ответ A."],"n":["D — неверный знак."],"t":"Сопряжённое выражение."},
"13":{"i":"ABCE — параллелограмм → AE = 11, ED = 4.","s":["½ · 4 · h = 7 → h = 3,5.","Площадь ½ · (11 + 15) · 3,5 = 45,5 м². Ответ C."],"n":["B — половина."],"t":"Высота одна и та же."},
"14":{"i":"Параллельная: 2x + 5y = c.","s":["Через (2, 3): c = 19. Ответ E."],"n":["A, B — другой наклон."],"t":"Те же коэффициенты при x и y."},
"15":{"i":"y = 1,5x − 2.","s":["Пересекает ось y в −2, ось x в 4/3, растёт — график E. Ответ E."],"n":["C — y = +2.","B, D — меньший наклон."],"t":"Точки на осях."},
"16":{"i":"Ветви вниз, вершина (−1; 6), y(0) = 5.","s":["−x² − 2x + 5: вершина x = −2/2 = −1, y = −1 + 2 + 5 = 6. Ответ E."],"n":["B — вершина в x = 1."],"t":"x вершины = −b/(2a)."},
"17":{"i":"Квадрат 144, круг r = 6 → 36π.","s":["144 − 36π = 36(4 − π). Ответ D."],"n":["A — π²."],"t":"Радиус — половина стороны."},
"18":{"i":"392 = 2³·7², 420 = 2²·3·5·7.","s":["НОД = 2² · 7 = 28. Ответ B."],"n":["378 и 450 не делятся на 28."],"t":"Разложите на простые."},
"19":{"i":"(x − 4)(x + 4) : √(x − 4).","s":["(x + 4)√(x − 4). Ответ A."],"n":["B — перепутаны скобки."],"t":"t : √t = √t."},
"20":{"i":"Половина — 3 × 3 × 1,5.","s":["2 · 9 + 4 · 4,5 = 36 см². Ответ D."],"n":["C — половина от 54."],"t":"Разрез добавляет новую грань."},
"21":{"i":"32/v − 32/(v + 4) = 4.","s":["128 = 4v(v + 4) → v² + 4v − 32 = 0 → v = 4 км/ч. Ответ B."],"n":["D — новая скорость."],"t":"Разность времён."},
"22":{"i":"6s² = 150 → s = 5.","s":["V = 125. Ответ C."],"n":["A — площадь грани."],"t":"Сначала сторона."},
"23":{"i":"2πr² + 2πrh = πr²h.","s":["Делим на πr: 2r + 2h = rh → h(r − 2) = 2r.","h = 2r/(r − 2). Ответ A."],"n":["B — знак."],"t":"Соберите h в одну сторону."},
"24":{"i":"1/4 · 1/3 · 2/5 = 1/30 числа = 21.","s":["Число 630; 30% = 189. Ответ B."],"n":["Остальные — арифметика."],"t":"Перемножьте дроби."},
"25":{"i":"Половина диагонали основания 2√2.","s":["h² = 8² − (2√2)² = 64 − 8 = 56 → h = 2√14 ≈ 7,48 см.","В ключе — вариант A (варианты обрезаны на картинке). Ответ A."],"n":["Не путайте с апофемой √60."],"t":"Боковое ребро, высота и полудиагональ."},
"26":{"i":"T = kx/y → 1,2 · 1,2 / 1,2 = 1,2.","s":["+20%. Ответ C."],"n":["E — сложили проценты."],"t":"Множители сокращаются."},
"27":{"i":"y = 2x − 5.","s":["4x² + (2x − 5)² + 10(2x − 5) = 47 → 8x² = 72 → x = 3.","y = 1. Ответ A."],"n":["Остальные не подходят во второе."],"t":"Подстановка."},
"28":{"i":"16^{0,25} = 2, 8⁻¹ = 1/8.","s":["(2 + 1/8) : 2 = 17/16. Ответ D."],"n":["A — неверная дробь."],"t":"0,25 = корень 4-й степени."},
"29":{"i":"Минутная 120°, часовая 270° + 10° = 280°.","s":["280 − 120 = 160°. Ответ A."],"n":["B — часовая на 9."],"t":"Часовая движется."},
"30":{"i":"Делим почленно на 2√3.","s":["4√3/(2√3) = 2; 5√60/(2√3) = 5√20/2 = 5√5.","2 + 5√5 → a = 2, b = 5. Ответ C."],"n":["B — перепутаны."],"t":"√60/√3 = √20."}
