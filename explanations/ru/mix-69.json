{
"1":{"i": "Высота ½ (катет против 30°), проекции боковых √3/2.", "s": ["Нижнее основание 1 + √3; S = ½(1 + 1 + √3) · ½ = (2 + √3)/4. Ответ A."], "n": ["B — без расчёта."], "t": "Против 30° — половина гипотенузы."},
"2":{"i": "Числитель x(1 + x + … + x⁶), знаменатель x⁻⁹(1 + x + … + x⁶).", "s": ["x / x⁻⁹ = x¹⁰. Ответ C."], "n": ["A — сложили не те степени."], "t": "Вынесите общий множитель."},
"3":{"i": "(n − 2) · 180 = 2520.", "s": ["n − 2 = 14 → n = 16. Ответ C."], "n": ["B — забыли +2."], "t": "Сумма углов n-угольника."},
"4":{"i": "Цена стала 0,8; нужно ×1/0,8 = 1,25.", "s": ["Наценка 25%. Ответ E."], "n": ["A — 20% от меньшей цены мало."], "t": "Процент от новой базы."},
"5":{"i": "11m + 2 — делитель 105 = 3 · 5 · 7.", "s": ["m = 3 → 35 ✔. Ответ B."], "n": ["Остальные не делят 105."], "t": "Перебор делителей."},
"8":{"i": "f(1) = 0: 1 + a + b + c = 0; f(2) = 0: 8 + 4a + 2b + c = 0.", "s": ["Вычтем: 3a + b = −7; с a + b = −15 → a = 4. Ответ D."], "n": ["Остальные — арифметика."], "t": "Исключите c."},
"9":{"i": "Центр на высоте r над l; A и B на высоте 3, по 2 от оси.", "s": ["(r − 3)² + 2² = r² → r = 13/6. Ответ A."], "n": ["B — 7/3."], "t": "Расстояние от центра до A = r."},
"10":{"i": "Возведём в квадрат: 6 + 2√(9 − 2) = 6 + 2√7.", "s": ["√(6 + √28). Ответ E."], "n": ["A — без удвоенного произведения."], "t": "(a + b)² = a² + 2ab + b²."},
"11":{"i": "f(1) = −4 < 0, f(2) = 1 > 0; дальше растёт.", "s": ["Наибольший корень в [1; 2). Ответ B."], "n": ["C — f(2) уже > 0."], "t": "Смена знака."},
"13":{"i": "Мультипликативный магический квадрат: P = (центр)³ = 216.", "s": ["Левый верхний = 216/(36 · 2) = 3; диагональ 3 · 6 · x = 216 → x = 12. Ответ B."], "n": ["E — 36."], "t": "Центр — среднее геометрическое."},
"14":{"i": "Спирт: X — 3/5, смесь — 3/7.", "s": ["Y = 2 · 3/7 − 3/5 = 9/35 → спирт : вода = 9 : 26. Ответ B."], "n": ["A — 1 : 1."], "t": "Средняя доля при равных объёмах."},
"15":{"i": "Если X займёт 5, получит «вилку»: столбец 1 и нижнюю строку.", "s": ["O должен занять 5. Ответ E."], "n": ["C — центр не защищает от вилки."], "t": "Блокируйте вилку."},
"17":{"i": "D = t² − (t² − t) = t → x = (−t ± √t)/2.", "s": ["t — полный квадрат (t и √t одной чётности): 1, 4, …, 100 → 10. Ответ E."], "n": ["D — без 100."], "t": "Целый корень → D — квадрат."},
"20":{"i": "C: r = ½, центр (½; ½); D: центр (1 − r; r).", "s": ["(½ − r)√2 = ½ + r → r = (√2 − 1)²/2 = (3 − 2√2)/2. Ответ A."], "n": ["C — без квадрата."], "t": "Центры на диагонали."},
"30":{"i": "Σx = Σy = 820.", "s": ["2 · 820 + 820 = 2460. Ответ C."], "n": ["E — порядок не важен."], "t": "Перестановка не меняет сумму."}
}
