{
"1":{"i": "Переносим всё в одну сторону, раскладываем на множители.", "s": ["6 − 2x² < 9x + 1 → 2x² + 9x − 5 > 0.", "(2x − 1)(x + 5) > 0 → корни −5 и ½.", "Ветви вверх → больше 0 снаружи: x < −5 или x > ½."], "n": ["B — неверный корень.", "C, D, E — однородные промежутки, а решение из двух частей."], "t": "При переносе знак у x² меняется — следите за направлением неравенства."},
"2":{"i": "α² + β² через Виета.", "s": ["α + β = −k, αβ = 12.", "α² + β² = k² − 24 = 25 → k² = 49 → k = 7."], "n": ["A (5) — k² = 25 без −24.", "B, D, E — неверно."], "t": "α² + β² = (α + β)² − 2αβ."},
"3":{"i": "Дробные степени: сначала корень, потом степень.", "s": ["27^(2/3) = 3² = 9.", "16^(3/4) = 2³ = 8.", "4^(−1/2) = ½.", "17 ÷ ½ = 34."], "n": ["A (17) — забыли разделить на ½.", "C (68) — разделили на ¼.", "D, E — неверно."], "t": "Деление на ½ = умножение на 2."},
"5":{"i": "Композиция: сначала g, потом f.", "s": ["g(2) = 4 + 1 = 5.", "f(5) = 10 − 3 = 7."], "n": ["A — g(f(2)) = 1² + 1 = 2? (порядок перепутан).", "B — это g(2).", "D, E — неверно."], "t": "f(g(x)) — внутреннюю считаем первой."},
"6":{"i": "Знаменатель прогрессии через отношение членов.", "s": ["u₅/u₃ = r² = 4 → r = ±2.", "u₂ = u₃/r = 12/(±2) = ±6 → 6 есть среди вариантов."], "n": ["A (3) — первый член при r = 2 (3, 6, 12).", "B, D, E — не получаются."], "t": "Между 3-м и 5-м членом два шага → r²."},
"7":{"i": "Считаем объёмы, взяв исходный объём 100.", "s": ["Было: сок 20, всего 100.", "Добавили 25 сока (объём +25%) → сок 45, всего 125.", "Испарилось 10% от 125 = 12,5 (вода) → всего 112,5.", "45/112,5 = 40%."], "n": ["B, E — забыли добавленный сок.", "A, C — неверный расчёт."], "t": "Испаряется вода — сок остаётся."},
"8":{"i": "Высота из прямого угла к гипотенузе: BD² = AD · DC.", "s": ["BD² = 4 · 9 = 36 → BD = 6."], "n": ["E (36) — забыли корень.", "D (13) — гипотенуза.", "A, C — неверно."], "t": "Высота — среднее геометрическое отрезков гипотенузы."},
"9":{"i": "Приравниваем y.", "s": ["2x² − 3x + 4 = 4x + 1 → 2x² − 7x + 3 = 0.", "(2x − 1)(x − 3) = 0 → x = 3 или ½.", "x = 3 → y = 13 → (3; 13)."], "n": ["Остальные пары не лежат на прямой y = 4x + 1."], "t": "Проверьте вариант на прямой — это быстрее."},
"10":{"i": "Упрощаем знаменатель, затем избавляемся от корня.", "s": ["√25 − √9 = 5 − 3 = 2 → знаменатель √2 + 2.", "4/(2 + √2) · (2 − √2)/(2 − √2) = 4(2 − √2)/2 = 4 − 2√2."], "n": ["E — без 4.", "A, C, D — неверно."], "t": "Умножайте на сопряжённое."},
"11":{"i": "Площадь трапеции и маленького треугольника у боковой стороны.", "s": ["S трапеции = ½(6 + 10) · 5 = 40.", "Треугольник: основание (10 − 6)/2 = 2, высота 5 → 5.", "40 : 5 = 8 : 1."], "n": ["A, B, D, E — неверное основание треугольника."], "t": "Свес с каждой стороны = (большее − меньшее)/2 (для равнобедренной)."},
"12":{"i": "Два случая: линейное уравнение (k = 0) и квадратное с D = 0.", "s": ["k = 0: 4x + 1 = 0 → одно решение ✓.", "k ≠ 0: D = 16 − 4k = 0 → k = 4.", "Ответ: k = 4 или k = 0."], "n": ["A, B — только один случай.", "C, E — неверно."], "t": "Не забывайте, что при k = 0 уравнение перестаёт быть квадратным."},
"14":{"i": "Кольцо = большой круг − малый.", "s": ["π(5² − 3²) = π(25 − 9) = 16π."], "n": ["A (4π) — π(5 − 3)².", "B (8π) — неверно.", "D, E — площадь одного круга."], "t": "r₁² − r₂² ≠ (r₁ − r₂)²."},
"15":{"i": "Приводим к основанию 2.", "s": ["64 = 2⁶ → x + 3 = 6 → x = 3.", "3^(x − 1) = 3² = 9."], "n": ["C (27) — 3³.", "A, D, E — неверно."], "t": "Спрашивают 3^(x−1), а не x."},
"16":{"i": "(n − 2) · 180° = 1440°.", "s": ["n − 2 = 8 → n = 10."], "n": ["A (8) — это n − 2.", "B, D, E — неверно."], "t": "Каждая сторона добавляет 180°."},
"17":{"i": "Перпендикуляр: наклон −1/k; проходит через середину AB.", "s": ["Наклон L = (8 − 2)/(4 − 1) = 2 → перпендикуляр −½.", "Середина AB: (2,5; 5).", "y = −½(x − 2,5) + 5 = −0,5x + 6,25."], "n": ["B — параллельная L.", "C, D — через другую точку.", "E — неверный наклон."], "t": "Произведение наклонов перпендикулярных прямых = −1."},
"18":{"i": "Сокращаем дробь, затем прибавляем 1 = (x + 3)/(x + 3).", "s": ["(x − 3)(x + 3)/(x + 3)² = (x − 3)/(x + 3).", "+ 1 = (x − 3 + x + 3)/(x + 3) = 2x/(x + 3)."], "n": ["B — перевёрнуто без +1.", "C, D, E — неверно."], "t": "Не забудьте +1 после сокращения."},
"19":{"i": "Треугольник из средних линий подобен исходному с коэффициентом ½.", "s": ["Сторона PQR = 3.", "S = (√3/4) · 9 = 9√3/4."], "n": ["A, B — без √3.", "D, E — неверно."], "t": "Площадь средне-линейного треугольника = ¼ исходной: (√3/4 · 36)/4."},
"21":{"i": "Приводим подобные: −2xy + 6xy = 4xy.", "s": ["x² + 4xy − 12y².", "Ищем множители −12 с суммой 4: 6 и −2.", "(x + 6y)(x − 2y)."], "n": ["A, C, D, E — при раскрытии не дают исходное."], "t": "Сначала приведите подобные, потом раскладывайте."},
"22":{"i": "V = πr²h; радиус в квадрате.", "s": ["π(2r)²(h/2) = π · 4r² · h/2 = 2πr²h = 2V."], "n": ["C (4V) — забыли уменьшить высоту.", "A, D, E — неверно."], "t": "Радиус ×2 → объём ×4."},
"23":{"i": "Переводим всё в десятичные дроби.", "s": ["0,2; 0,22; 0,04; 0,04; √0,05 ≈ 0,224.", "Наибольшее — √0,05."], "n": ["B (0,22) — чуть меньше 0,224.", "A, C, D — меньше."], "t": "√ числа меньше 1 больше самого числа."},
"24":{"i": "Через суммы.", "s": ["12n + 30 = 14(n + 1) → 2n = 16 → n = 8."], "n": ["B, C, D, E — не удовлетворяют уравнению."], "t": "Средние → суммы."},
"25":{"i": "Считаем все три стороны.", "s": ["PQ = 6.", "PR = √(9 + 27) = 6.", "QR = √(9 + 27) = 6.", "Все равны → равносторонний."], "n": ["A, B — нет прямого угла.", "D — все три равны.", "E — углы по 60°."], "t": "Высота 3√3 = (√3/2)·6 — признак равностороннего треугольника."},
"26":{"i": "Освобождаемся от знаменателя и собираем a.", "s": ["P(n − a) = n² + a.", "Pn − n² = a + Pa = a(1 + P).", "a = (Pn − n²)/(1 + P)."], "n": ["B, C — знаки в знаменателе.", "D — перевёрнут знак числителя.", "E — неверно."], "t": "Все слагаемые с a — в одну сторону."},
"27":{"i": "Вершина при x = 3, значение там −4.", "s": ["x = −b/2a = 3.", "9 − 18 + c = −4 → c = 5."], "n": ["D (9) — минимум был бы 0.", "A, B, E — неверно."], "t": "(x − 3)² + (c − 9): минимум c − 9 = −4."},
"28":{"i": "Находим длину ровного участка.", "s": ["45 мин = 0,75 ч → 12 · 0,75 = 9 км.", "x = 20 − 9 − 6 = 5 км."], "n": ["A, B, C, E — ошибка в 45 мин (0,45 ч?)."], "t": "45 мин = ¾ часа."},
"29":{"i": "sin² + cos² = 1.", "s": ["cos² = 1 − 0,36 = 0,64.", "cos = 0,8 (острый угол → положительный)."], "n": ["A (0,4) — 1 − 0,6.", "C (0,64) — забыли корень.", "E (0,75) — это tg."], "t": "Треугольник 3-4-5: sin = 0,6, cos = 0,8."},
"30":{"i": "Формула расстояния.", "s": ["(4 − 1)² + (k − 2)² = 25 → (k − 2)² = 16.", "k − 2 = ±4 → k = 6 или −2."], "n": ["A, B, C, D — не дают расстояние 5."], "t": "Два ответа из-за ± — проверьте оба по вариантам."}
}
