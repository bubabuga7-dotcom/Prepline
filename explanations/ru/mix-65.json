{
"1":{"i": "Раскроем: 45 − 81√7 + 10√7 − 18 · 7.", "s": ["45 − 126 − 71√7 = −81 − 71√7. Ответ B."], "n": ["Остальные — ошибка в одном произведении."], "t": "√7 · √7 = 7."},
"2":{"i": "2000–2013 — 14 лет; a₁₄ = 150 + 13 · 10 = 280.", "s": ["S = 14 · (150 + 280)/2 = 3010. Ответ C."], "n": ["B — 13 лет."], "t": "Включительно — считайте оба конца."},
"4":{"i": "Высота к основанию 30: √(17² − 15²) = 8.", "s": ["S = ½ · 30 · 8 = 120. Ответ C."], "n": ["D — ошибка в высоте."], "t": "Равнобедренный: высота делит основание пополам."},
"5":{"i": "Сторона вписанного шестиугольника = R = 8.", "s": ["6 · (√3/4) · 64 = 96√3. Ответ C."], "n": ["A — половина."], "t": "Шесть равносторонних треугольников."},
"6":{"i": "Полудиагональ основания 5√2; h = √(150 − 50) = 10.", "s": ["V = ⅓ · 100 · 10 = 1000/3. Ответ A."], "n": ["B — ошибка в h."], "t": "Боковое ребро, высота и полудиагональ — прямоугольный треугольник."},
"7":{"i": "Касательная ⟂ радиусам: 2/AO₁ = 4/(AO₁ + 6) → AO₁ = 6.", "s": ["sin A = 2/6 = 1/3, cos A = 2√2/3 → tg A = 1/(2√2) = √2/4. Ответ D."], "n": ["A, B, C — не согласуются с sin A = 1/3."], "t": "Подобные прямоугольные треугольники."},
"8":{"i": "X²Z = (R + Y)².", "s": ["R + Y = X√Z → Y = X√Z − R. Ответ A."], "n": ["B — X² вместо X."], "t": "Квадрат, затем корень."},
"10":{"i": "Делим на 3,6.", "s": ["1260 : 3,6 = 350 м/с. Ответ C."], "n": ["Остальные — арифметика."], "t": "км/ч → м/с: ÷3,6."},
"11":{"i": "k² = 134,4 / 52,5 = 2,56 → k = 1,6.", "s": ["m = 8 : 1,6 = 5 см. Ответ C."], "n": ["D (5,7) — в старом ключе, неверно.", "A — делили на k²."], "t": "Площади ∝ k², длины ∝ k."},
"12":{"i": "r = 8, h = 32 → l = √(64 + 1024) = 8√17.", "s": ["S = πr² + πrl = 64π + 64√17π = 64π(1 + √17). Ответ C."], "n": ["Остальные — неверный r."], "t": "Радиус — половина диаметра."},
"13":{"i": "B(−3; 0): −3a = −9 → a = 3.", "s": ["A(−1; 3): −3 − 3b = −9 → b = 2 → a + b = 5. Ответ A."], "n": ["B — знак b."], "t": "Подставьте обе точки."},
"14":{"i": "4/64 = 0,0625; 10⁸ : 10⁻¹⁸ = 10²⁶.", "s": ["0,0625·10²⁶ = 6,25·10²⁴. Ответ B."], "n": ["A, C, D — не стандартный вид."], "t": "Мантисса от 1 до 10."},
"15":{"i": "+125% → ×2,25; −40% → ×0,6.", "s": ["m = 2,25 · 0,6 = 1,35 = 27/20. Ответ C."], "n": ["D — сложили проценты."], "t": "Множители перемножаются."},
"16":{"i": "xy² = const = 9 · 4/9 = 4.", "s": ["4y² = 4 → y = 1. Ответ A."], "n": ["B — без квадрата."], "t": "Обратная пропорциональность квадрату."},
"17":{"i": "2 • 4 = 4 − 16 = −12; 3 ◇ 1 = 9.", "s": ["(−12) • 9 = 144 − 81 = 63. Ответ B."], "n": ["D — 81."], "t": "Сначала скобки."},
"18":{"i": "S сектора = ½ · l · r.", "s": ["½ · 16π · 24 = 192π. Ответ B."], "n": ["Остальные — арифметика."], "t": "Через длину дуги."},
"19":{"i": "CF = (3/5) · DC = 1,2a; ED = ½AD = ½b.", "s": ["EF = ED + DC + CF = ½b + 2a + 1,2a = 3,2a + ½b. Ответ C."], "n": ["A — без DC."], "t": "Идите по известным векторам."},
"20":{"i": "Сдвиг: x → x − 2, y → y + 3.", "s": ["(y + 3)² = 4(x − 2 + 2(y + 3)) → y² + 6y + 9 = 4x + 8y + 16.", "y² = 4x + 2y + 7. Ответ A."], "n": ["C — знаки."], "t": "Вправо — x − 2, вниз — y + 3."},
"21":{"i": "tg 30° = 60 / d.", "s": ["d = 60 : (1/√3) = 60√3. Ответ B."], "n": ["Остальные — не tg 30°."], "t": "Угол депрессии = угол возвышения."},
"22":{"i": "0,(17) = 17/99 = 170/990; 0,0(75) = 75/990.", "s": ["245/990 = 49/198. Ответ A."], "n": ["D — 999."], "t": "Предпериод → 0 в знаменателе."},
"23":{"i": "Угол между секущими = ½(DE − BC).", "s": ["2x = ½(140 − 20) = 60 → x = 30. Ответ A."], "n": ["C — это 2x."], "t": "Полуразность дуг."},
"25":{"i": "∠A = 60° и AB = AD → △ABD равносторонний → BD = x.", "s": ["△CBD: угол 120°, BD = y√3 → x : y = √3 : 1. Ответ B."], "n": ["D — √3 : 2."], "t": "Против 120° сторона y√3."},
"26":{"i": "∠TSU = 108° − 60° = 48°; TS = SU.", "s": ["∠STU = (180 − 48)/2 = 66°. Ответ D."], "n": ["A — это ∠TSU."], "t": "Равнобедренный △TSU."},
"27":{"i": "Высота ромба = диаметр = 8.", "s": ["12 · 8 − 16π = 16(6 − π). Ответ B."], "n": ["A — высота 7."], "t": "Площадь ромба = сторона × высота."},
"28":{"i": "∠ABC = 245° − 155° = 90°, AB = BC → ∠C = 45°.", "s": ["Из C на B — азимут 335°; A на 45° левее: 335 − 45 = 290°. Ответ C."], "n": ["B — 270°."], "t": "Обратный азимут ±180°."},
"29":{"i": "5^{x+1} · 5^{6x} = 5^{57}.", "s": ["7x + 1 = 57 → x = 8. Ответ B."], "n": ["A — без +1."], "t": "Одно основание."},
"30":{"i": "Верхняя пирамида высотой 15 − 6 = 9 → k = 0,6.", "s": ["250 · 0,6³ = 54. Ответ A."], "n": ["B — k²."], "t": "Объём ∝ k³."}
}
