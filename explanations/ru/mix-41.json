{
"1":{"i": "Радиус в точке касания перпендикулярен QR: OX ⊥ QR.", "s": ["Расстояние от O до QR = r = √3; в треугольнике OXR угол R = 60° → OR = √3/sin 60° = 2, XR = 1.", "PR = PO + OR = √3 + 2.", "QX = QR − XR = 2 + √3 − 1 = 1 + √3."], "n": ["A — это радиус.", "Остальные — неверно найдены OR или XR."], "t": "Касательная ⊥ радиусу в точке касания."},
"2":{"i": "Выносим √3.", "s": ["√75 = 5√3, √48 = 4√3, √27 = 3√3.", "5√3 + 4√3 − 3√3 = 6√3 = √108."], "n": ["E — арифметика.", "Остальные — неверное упрощение."], "t": "6√3 = √(36 · 3)."},
"3":{"i": "Пересечение ⇔ D ≥ 0.", "s": ["kx = (x − 1)² → x² − (2 + k)x + 1 = 0.", "D = (2 + k)² − 4 ≥ 0 → |2 + k| ≥ 2 → k ≥ 0 или k ≤ −4."], "n": ["D — промежуток без пересечений.", "A, B — только одна часть."], "t": "|a| ≥ b — два луча."},
"5":{"i": "Внутренний круг разбит на 4 части, кольцо — на 10; все 14 частей равны.", "s": ["Одна часть: π/4.", "Весь большой круг: 14 · π/4 = 3,5π = πR² → R = √14/2.", "x = R − 1 = √14/2 − 1."], "n": ["A — R = √14.", "Остальные — неверное число частей."], "t": "Площадь части малого круга даёт «единицу» площади."},
"6":{"i": "Раскладываем всё на 2 и 3.", "s": ["Числитель: 2^(r + s) · 3^(r + s) · 2^(2r − 2s) · 3^(r − s) = 2^(3r − s) · 3^(2r).", "Знаменатель: 2^(3r) · 3^(2r + 4s).", "Результат: 2^(−s) · 3^(−4s) — целое ⇔ s ≤ 0."], "n": ["Остальные — r сокращается и не влияет."], "t": "12 = 2² · 3, 8 = 2³, 9 = 3²."},
"7":{"i": "Внешний угол треугольника больше любого несмежного внутреннего.", "s": ["∠7 — внутренний угол треугольника с углами 6, 7, 8.", "∠11 смежен с ∠8 → это внешний угол этого треугольника → ∠11 = ∠6 + ∠7 &gt; ∠7."], "n": ["Про ∠1, ∠4, ∠5, ∠6 по рисунку вывода сделать нельзя."], "t": "Ищите внешний угол нужного треугольника."},
"8":{"i": "S₅ = S₈ ⇔ a₆ + a₇ + a₈ = 0.", "s": ["Сумма трёх подряд = 3a₇ = 0 → a₇ = 0.", "a + 6d = 0 → a = −6d."], "n": ["A — a₈ = 0.", "Остальные — неверно."], "t": "Сумма симметричных членов = число членов × средний."},
"9":{"i": "Два случая: правая часть отрицательна или нет.", "s": ["ОДЗ: x ≥ −5/2.", "x &lt; −1: правая часть отрицательна — верно всегда → −5/2 ≤ x &lt; −1.", "x ≥ −1: 2x + 5 &gt; x² + 2x + 1 → x² &lt; 4 → −1 ≤ x &lt; 2.", "Итого: −5/2 ≤ x &lt; 2."], "n": ["A — без ОДЗ и случая x &lt; −1.", "C — потеряна часть решений."], "t": "При отрицательной правой части возводить в квадрат нельзя."},
"10":{"i": "Навстречу — скорости складываются.", "s": ["25 + 5 = 30 м/с.", "150/30 = 5 с."], "n": ["B — 150/25.", "D — разность скоростей."], "t": "Встречное движение — сумма скоростей."},
"11":{"i": "Замена u = x/3 + 2.", "s": ["3u² − u − 4 = 0 → u = 4/3 или −1.", "x = 3(u − 2): −2 и −9.", "Сумма −11."], "n": ["A — сумма u.", "Остальные — не вернулись к x."], "t": "После замены вернитесь к x."},
"12":{"i": "Направление из T на Q — 270°, на P — 250°: угол QTP = 20°.", "s": ["PQ = QT → треугольник равнобедренный с вершиной Q.", "Углы при T и P по 20° → ∠PQT = 140°."], "n": ["Остальные — неверный угол при T."], "t": "Запад — пеленг 270°."},
"13":{"i": "Обратные действия.", "s": ["y + 6 = (4x + 5)².", "4x + 5 = √(y + 6) → x = (√(y + 6) − 5)/4."], "n": ["B, D — y − 6.", "C — +5.", "E — делили на 2."], "t": "Последнее действие «−6» снимаем первым."},
"14":{"i": "Перемножаем коэффициенты.", "s": ["3500 · 1,3 · 0,8 · 0,5 = 1820."], "n": ["B — среда.", "Остальные — неверно."], "t": "Каждый процент — от предыдущего дня."},
"15":{"i": "Средняя скорость = весь путь / всё время.", "s": ["Подъём: 16 · 0,5 = 8 км.", "Весь путь 16 км при 20 км/ч → 0,8 ч.", "Спуск: 0,3 ч → 8/0,3 = 80/3."], "n": ["A — среднее арифметическое скоростей.", "Остальные — неверно."], "t": "Средняя скорость ≠ среднее скоростей."},
"16":{"i": "AB = AC = AD — радиусы → равнобедренные треугольники.", "s": ["ABD: ∠ADB = 48° → ∠BAD = 84°.", "∠DAC = 360° − 84° − 56° = 220° — значит, центральный угол DAC с другой стороны 140°.", "Треугольник ADC: ∠DCA = (180 − 140)/2 = 20°."], "n": ["Остальные — неверно найден ∠DAC."], "t": "Радиусы → равнобедренные треугольники."},
"17":{"i": "R ∝ v².", "s": ["0,6² = 0,36 → уменьшение на 64%."], "n": ["A — новое значение.", "C — без квадрата."], "t": "«Уменьшение» = 1 − коэффициент."},
"18":{"i": "(a + b)² − (a − b)² = 4ab.", "s": ["4 · √10 · √7 = 4√70."], "n": ["E, G — сумма квадратов.", "D — 2ab."], "t": "Не раскрывайте — используйте формулу."},
"19":{"i": "Находим вершины треугольника.", "s": ["С осью y: (0; 10) и (0; −23) → основание 33.", "Пересечение прямых: 5x + 6x − 46 = 20 → x = 6.", "S = ½ · 33 · 6 = 99."], "n": ["E — без ½.", "Остальные — неверное основание."], "t": "Основание на оси y, высота = |x| вершины."},
"20":{"i": "0,4(5) = (45 − 4)/90.", "s": ["41/90."], "n": ["E — 44/90.", "D — 0,444…"], "t": "Смешанная периодическая: (число − непериод. часть)/90."},
"21":{"i": "AD = BC.", "s": ["D = A + BC = (3 − 4; 4 + 6) = (−1; 10)."], "n": ["Остальные — использовали AB."], "t": "В параллелограмме противоположные стороны — равные векторы."},
"22":{"i": "x = 8008 · 10/770.", "s": ["8008 = 4 · 2002; 770 = 2002 · 5/13.", "x = 104 = 2³ · 13."], "n": ["Остальные — неверное сокращение."], "t": "Сократите 10 и 770 первым делом."},
"23":{"i": "Пирамида с вершиной F: рёбра FB, FE, FG взаимно перпендикулярны.", "s": ["V = ⅓ · ½a² · a = a³/6.", "Отношение 1/6."], "n": ["A — дважды поделили на 2.", "B, C — неверная формула."], "t": "Угловая пирамида куба = ⅙ объёма."},
"24":{"i": "Угол при A тоже 60° (трапеция равнобедренная).", "s": ["DH = 3 · tg 60° = 3√3.", "AB = 3 + 5 + 3 = 11.", "S = (5 + 11)/2 · 3√3 = 24√3."], "n": ["B — AB = 8.", "Остальные — неверно."], "t": "Свес с каждой стороны одинаковый."},
"25":{"i": "t · d² = const.", "s": ["0,2 · 64 = 12,8.", "t = 12,8/100 = 0,128 = 16/125."], "n": ["Остальные — прямая пропорциональность или без квадрата."], "t": "Обратная пропорциональность."},
"26":{"i": "4 четверти круга радиуса 5 = один круг.", "s": ["100 − 25π."], "n": ["A — половина квадрата.", "Остальные — неверно."], "t": "Радиус 5 — половина стороны."},
"27":{"i": "Возводим каждый множитель в квадрат.", "s": ["2² = 4; (x^(2/3))² = x^(4/3); (y³)² = y⁶; (√z)² = z.", "4x^(4/3)y⁶/z."], "n": ["B — x³.", "Ни один вариант не совпадает точно: в E ошибочно z² вместо z."], "t": "(√z)² = z. Ближайший вариант — E."},
"28":{"i": "Доля P: в X 3/5, в Y 4/5, нужно 5/7.", "s": ["x(3/5 − 5/7) + y(4/5 − 5/7) = 0.", "x · (−4/35) + y · (3/35) = 0 → x : y = 3 : 4."], "n": ["Остальные — неверное уравнение смеси."], "t": "Правило рычага: расстояния до целевой доли."},
"29":{"i": "Считаем степени.", "s": ["16^(3/4) = 8; 25^(−½) = 1/5; 8^(2/3) = 4.", "8 · 1/5 / 4 = 2/5."], "n": ["Остальные — ошибки со степенями."], "t": "Сначала корень, потом степень."},
"30":{"i": "Поворот по часовой: (x; y) → (y; −x).", "s": ["M → (4; −3), N → (−2; 2); середина RS (1; −½).", "(6; −3) − (1; −½) = (5; −5/2)."], "n": ["Остальные — поворот против часовой или иная ошибка."], "t": "Достаточно повернуть середину отрезка."}
}
