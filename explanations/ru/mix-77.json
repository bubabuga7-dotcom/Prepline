{
"1":{"i": "¾ банок весят 20 − 14 = 6 → все банки 8.", "s": ["Кулер 20 − 8 = 12. Ответ B."], "n": ["A — 20 − 10."], "t": "Найдите вес всех банок."},
"2":{"i": "∠BDA = 180° − B − A/2, A = 180° − B − C.", "s": ["∠BDA = 90° − (B − C)/2 = 90 − 10 = 80°. Ответ D."], "n": ["E — 85."], "t": "Выразите через B − C."},
"4":{"i": "Одной победы мало: C = 12, а A или B получит ≥ 4 → 16.", "s": ["Две победы: C = 20, A и B — по 12 + 4 + 2 = 18. Ответ B."], "n": ["A — одной игры мало."], "t": "Худший случай для соперников."},
"5":{"i": "Каждый час удвоение: 2 · 2ᴺ.", "s": ["2ᴺ⁺¹. Ответ C."], "n": ["E — начинали с одной."], "t": "Начальное число × 2ᴺ."},
"6":{"i": "Всё к основанию 2: 2^{1/3} · 2^{3/4} · 2^{1/3} / 2^{13/12}.", "s": ["2^{(4 + 9 + 4 − 13)/12} = 2^{1/3} = ∛2. Ответ A."], "n": ["E — 1."], "t": "Складывайте дробные показатели."},
"7":{"i": "Вклад: 350 · 12 / 0,09 ≈ 46 667. Нужно 350 · 1,15 = 402,5 в месяц.", "s": ["402,5 · 12 / 0,08 = 60 375. Ответ A."], "n": ["B — без +15%."], "t": "Годовой доход = 12 месяцев."},
"8":{"i": "Сторона × 1/√2 на каждом шаге.", "s": ["9-й квадрат: 6 · (1/√2)⁸ = 6/16 = 3/8; периметр 3/2. Ответ A."], "n": ["B — на шаг меньше."], "t": "Два шага — сторона пополам."},
"9":{"i": "Стенка 13 × h = 39 → h = 3; отсечён прямоугольный треугольник 5–12–13.", "s": ["Малый отсек ½ · 5 · 12 · 3 = 90; коробка 15 · 12 · 3 = 540.", "Большой 540 − 90 = 450. Ответ D."], "n": ["E — вся коробка."], "t": "Целое минус малый отсек."},
"10":{"i": "(3(N + 3) − 3)/3.", "s": ["(3N + 6)/3 = N + 2. Ответ B."], "n": ["A — N + 1."], "t": "Раскройте скобки."},
"11":{"i": "Мег перед Бобом — ровно половина всех порядков.", "s": ["5!/2 = 60. Ответ C."], "n": ["E — все порядки."], "t": "Симметрия."},
"12":{"i": "Подъём = V / S дна = 2 / 12 фута.", "s": ["1/6 фута = 2 дюйма. Ответ C."], "n": ["A — в футах."], "t": "Переведите единицы."},
"13":{"i": "Излишки: 25 − 16 = 9, 16 − 9 = 7, 9 − 4 = 5, 4 − 1 = 3.", "s": ["24 из 50 заполнено → 48%, пусто 52%. Ответ D."], "n": ["B — спрашивают пустое."], "t": "Читайте вопрос."},
"14":{"i": "Общая касательная в B: MB = MT = MP → ∠PBT = 90°.", "s": ["Угол касательной и хорды: ∠BTP = ∠BAT = 48° → ∠BPT = 42°.", "∠PCB = ∠BPT = 42°. Ответ C."], "n": ["E — 48."], "t": "Угол между касательной и хордой = вписанному."},
"15":{"i": "(x/5 + 7) · 5 = x + 35.", "s": ["Больше на 35. Ответ C."], "n": ["A — +7."], "t": "Раскройте скобку."},
"16":{"i": "Нижний: 3 × 5 = 15; верхний: (8 − 3)(9 − 5) = 20.", "s": ["35. Ответ D."], "n": ["E — 8 · 9 + …"], "t": "Стороны по координатам."},
"17":{"i": "НОК(18, 24) = 72.", "s": ["72 делится на 12. Ответ A."], "n": ["B — 16 не делит 72."], "t": "Делится на НОК."},
"18":{"i": "Каждое из следующих пяти больше на 5.", "s": ["w + 25. Ответ D."], "n": ["A — +5."], "t": "5 · 5."},
"19":{"i": "Дробная часть = целая / 5.", "s": ["4,8: 4 : 5 = 0,8 ✔. Ответ B."], "n": ["E — 2,42 ≠ 2,4."], "t": "Проверяйте варианты."},
"20":{"i": "Осталось 300° → длина дуги 2π · 12 · 5/6 = 20π = 2πr → r = 10.", "s": ["h = √(12² − 10²) = √44. Ответ B."], "n": ["E (√140) — в старом ключе, неверно."], "t": "Образующая = радиус листа."},
"23":{"i": "Прибавки растут: 1, 3, 6, 9.", "s": ["Возрастающая, всё круче — график D. Ответ D."], "n": ["A — линейный."], "t": "Смотрите на разности."},
"24":{"i": "По графику f(0) = −1.", "s": ["f(−1) = −2. Ответ B."], "n": ["C — f(0)."], "t": "Изнутри наружу."},
"25":{"i": "Ширина 2a, высота 3b − (−b) = 4b.", "s": ["8ab. Ответ B."], "n": ["A — 3b."], "t": "Разности координат."},
"27":{"i": "t = ad: t + 2/t = 4 → t² + 4/t² = 16 − 4 = 12.", "s": ["3 · 12 = 36. Ответ C."], "n": ["E — без вычета 4."], "t": "Квадрат суммы."}
}
