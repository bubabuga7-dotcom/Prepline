"3":{"i": "Всё через 5: 5^{x+1} · 5^{6x} = 5^{57}.", "s": ["7x + 1 = 57 → x = 8. Ответ C."], "n": ["D — забыли +1."], "t": "25 = 5², 125 = 5³."},
"4":{"i": "Площадь = ½ · (4 + √2)(2 − √2).", "s": ["(4 + √2)(2 − √2) = 8 − 4√2 + 2√2 − 2 = 6 − 2√2.", "Половина: 3 − √2. Ответ A."], "n": ["C — без деления."], "t": "Площадь прямоугольного треугольника."},
"5":{"i": "Восьмиугольник: центральный угол на одну сторону 45°.", "s": ["Между отрезками три стороны: 3 · 45 = 135°. Ответ B."], "n": ["A — шестиугольник."], "t": "360 : n."},
"7":{"i": "a₁ + a₃ + a₅ = 3a + 6d = 39; a₂ + a₄ + a₆ = 3a + 9d = 51.", "s": ["d = 4, a = 5 → a₁₀ = 5 + 36 = 41. Ответ C."], "n": ["A — 9d ошибочно."], "t": "Вычтите уравнения."},
"8":{"i": "(2x + 3)² − (x − 3)² = 3x² + 18x.", "s": ["3(x² + 6x) = 3(x + 3)² − 27 → r = −27. Ответ C."], "n": ["D — без множителя 3."], "t": "Выделите полный квадрат."},
"9":{"i": "Шар (4/3)πr³, цилиндр πr² · 2r = 2πr³.", "s": ["(4/3) : 2 = 2/3. Ответ D."], "n": ["C — 1/2."], "t": "Шар — 2/3 цилиндра."},
"10":{"i": "AC = AO + OC = −2a + 8b.", "s": ["AE = ½AC = −a + 4b. Ответ A."], "n": ["B — знак при b."], "t": "Через известные векторы."},
"11":{"i": "S = ½ · l · r.", "s": ["½ · 16 · 9 = 72 см². Ответ B."], "n": ["A — без 2."], "t": "Площадь сектора через дугу."},
"12":{"i": "25 · 3,6.", "s": ["90 км/ч. Ответ D."], "n": ["C — 25 · 3."], "t": "м/с → км/ч: ×3,6."},
