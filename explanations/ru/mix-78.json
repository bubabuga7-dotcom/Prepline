{
"1":{"i": "12% от 25%.", "s": ["0,25 · 0,12 = 0,03 → 3%. Ответ A."], "n": ["E — сложили."], "t": "Процент от процента — умножение."},
"2":{"i": "(A + B)/(A + B)² = 1/(A + B).", "s": ["A + B ≥ 2 → никогда не целое. Ответ D."], "n": ["A, E — сокращаются до целых при некоторых A, B."], "t": "A² + 2AB + B² = (A + B)²."},
"3":{"i": "3⁻² − (−2)².", "s": ["1/9 − 4 = −35/9. Ответ C."], "n": ["D — знак."], "t": "Y² ≥ 0 всегда."},
"4":{"i": "2,4 мили = 12 отрезков по 1/5.", "s": ["1,25 + 12 · 0,25 = 4,25. Ответ A."], "n": ["B — без посадки."], "t": "Посчитайте отрезки."},
"5":{"i": "(2k^{1/2})⁻² = 1/(4k).", "s": ["Ответ C."], "n": ["B — забыли 2²."], "t": "Степень на каждый множитель."},
"6":{"i": "RS + RT = ST → R между S и T, SR = 20.", "s": ["SU = 12 → RU = 20 − 12 = 8. Ответ B."], "n": ["C — SU."], "t": "Нарисуйте отрезок."},
"8":{"i": "По графику h(5) = 5 → k = 5.", "s": ["h(10) = 7. Ответ C."], "n": ["A — это k."], "t": "Сначала k, затем h(2k)."},
"9":{"i": "Коэффициент при x: −(8 + k) = −5k → k = 2.", "s": ["m = 8k = 16. Ответ B."], "n": ["A — m = 8."], "t": "Приравняйте коэффициенты."},
"10":{"i": "f⁻¹(x) = 2x + 3.", "s": ["2x + 3 + 4x + 3 = 12 → x = 1. Ответ B."], "n": ["A — ошибка в обратной."], "t": "y = (x − 3)/2 → x = 2y + 3."},
"12":{"i": "Разница 0,25 · (5 − 1).", "s": ["$1,00. Ответ B."], "n": ["C — 0,25 · 5."], "t": "Разность значений формулы."},
"15":{"i": "x < y, x + y ≥ 1000 → y > 500 → III верно.", "s": ["Десятки: 7 + 5 (+ перенос) = 2 или 3 → II не обязательно; I тоже нет. Ответ B."], "n": ["E — II не всегда."], "t": "Ищите контрпримеры."},
"16":{"i": "2ˢ = 2ᵘ + 2ᵛ возможно только при u = v = s − 1.", "s": ["I ✗, II ✗, III ✔. Ответ D."], "n": ["C — u = v."], "t": "Двоичная запись."},
"17":{"i": "r² = 3² + 3² = 18.", "s": ["18π. Ответ E."], "n": ["B — радиус вместо площади."], "t": "S = πr²."},
"18":{"i": "y, xy, x²y.", "s": ["Ответ E."], "n": ["B — y²."], "t": "Геометрическая прогрессия."},
"19":{"i": "Работают 75 — это верхняя граница.", "s": ["Все 75 могут быть без семьи и петь. Ответ C."], "n": ["A — минимум, а не максимум."], "t": "Максимум пересечения — меньшее из множеств."},
"20":{"i": "Каждый лепесток — два сегмента радиуса ½ по 90°.", "s": ["Сегмент: π/16 − 1/8; 8 сегментов: π/2 − 1. Ответ A."], "n": ["B — радиус 1."], "t": "Сектор − треугольник."},
"24":{"i": "B = A − 1, C = A − 2.", "s": ["2A + A − 1 + 3A − 6 = 6A − 7. Ответ E."], "n": ["D — ошибка в C."], "t": "Выразите через A."},
"25":{"i": "Сыр c, молоко и шоколад по 3c.", "s": ["Всё: 135c + 24c + 69c = 228c; часть: 60c + c + 15c = 76c → 1/3. Ответ D."], "n": ["A — штуки, а не цены."], "t": "Всё в одной единице."},
"28":{"i": "Закраска = площадь треугольника − 3 сектора по 60° = (√3 − π/2)r².", "s": ["(√3 − π/2)r² = √3 − π/2 → r = 1. Ответ A."], "n": ["B (2) — в старом ключе, неверно."], "t": "Сторона треугольника центров 2r."},
"29":{"i": "Площадь в 64 раза → длины в 8 раз → объём в 512 раз.", "s": ["64 : 512 = 0,125. Ответ C."], "n": ["A — делили на 64."], "t": "k → k² → k³."},
"30":{"i": "A — 1, C — 4; Бенни и Фрэнсис на (2; 5) или (3; 6).", "s": ["Пара (4; 7) невозможна — место 4 занято → ни Бенни, ни Фрэнсис не встанут на 7-е. Ответ D."], "n": ["A — Бенни нельзя, но Дэррилу можно."], "t": "Перебор позиций."}
