{
"1":{"i": "Биквадратное уравнение: замена u = x².", "s": ["u² − 13u + 36 = (u − 4)(u − 9) = 0.", "x² = 4 или x² = 9 → x = ±2, ±3."], "n": ["A, B — потеряны знаки ±.", "C — забыли извлечь корень из u.", "E — решения есть."], "t": "После замены не забудьте вернуться к x и учесть ±."},
"2":{"i": "Выделяем полные квадраты.", "s": ["(x + 2)² − 4 + (y − 3)² − 9 − 12 = 0.", "(x + 2)² + (y − 3)² = 25 → центр (−2; 3), r = 5."], "n": ["B, D — знаки центра перевёрнуты.", "C, D — радиус 25 — это r².", "E — центр = коэффициенты без деления на 2."], "t": "Центр = (−D/2; −E/2)."},
"3":{"i": "Считаем степени, затем переворачиваем.", "s": ["64^(−2/3) = 1/16; 9^0,5 = 3.", "1/16 + 3 = 49/16.", "(49/16)⁻¹ = 16/49."], "n": ["B — не перевернули.", "C, D, E — ошибки с 64^(−2/3)."], "t": "64^(2/3) = (∛64)² = 16."},
"4":{"i": "Подкоренное выражение f(g(x)) должно быть ≥ 0.", "s": ["f(g(x)) = √(3 − (x² − 1)) = √(4 − x²).", "4 − x² ≥ 0 → −2 ≤ x ≤ 2."], "n": ["A — область f, а не композиции.", "B, D — неполно.", "E — наоборот."], "t": "Область композиции — по итоговой формуле."},
"5":{"i": "Площадь через синус, третья сторона — теорема косинусов.", "s": ["S = ½ · 8 · 10 · sin 120° = 20√3.", "AB² = 64 + 100 − 160 · cos 120° = 164 + 80 = 244 → AB = 2√61.", "P = 18 + 2√61.", "20√3/(18 + 2√61) = 10√3/(9 + √61)."], "n": ["B — перепутаны числа.", "C — без 10.", "D — неверный знаменатель."], "t": "cos 120° = −½ → в формуле знак становится «+»."},
"7":{"i": "Не пересекаются ⇔ уравнение пересечения не имеет корней (D < 0).", "s": ["x² + (3 − k)x + 1 = 0.", "(3 − k)² − 4 < 0 → |3 − k| < 2 → 1 < k < 5."], "n": ["A — условие пересечения (D > 0).", "C — касание.", "D, E — неполно."], "t": "D < 0 — нет общих точек; D = 0 — касание."},
"8":{"i": "Площади ∝ r², объёмы ∝ r³.", "s": ["r₁ : r₂ = √9 : √25 = 3 : 5.", "V₁ : V₂ = 27 : 125."], "n": ["A — отношение радиусов.", "B — площадей.", "D — квадраты площадей."], "t": "Площадь → корень → радиус → куб → объём."},
"9":{"i": "Перемножаем коэффициенты.", "s": ["X × 1,2; √Y × √1,44 = 1,2; Z² × 0,81.", "1,2 · 1,2 / 0,81 = 1,44/0,81 ≈ 1,78 → рост ≈ 78%."], "n": ["A (44%) — забыли Z.", "B, D — неверно."], "t": "Уменьшение Z в знаменателе увеличивает P."},
"10":{"i": "Центры и точка пересечения — равносторонний треугольник → дуги по 120°.", "s": ["Сектор 120°: ⅓ · π · 36 = 12π.", "Треугольник: ½ · 36 · sin 120° = 9√3.", "Сегмент: 12π − 9√3; два сегмента: 24π − 18√3."], "n": ["A — один сегмент.", "D — неверный сектор.", "C, E — неверно."], "t": "Перекрытие двух кругов = два одинаковых сегмента."},
"11":{"i": "Касание оси y → r = |x центра| = 3.", "s": ["(x − 3)² + (y + 4)² = 9."], "n": ["B — r = 4 (касание оси x).", "D — r = 5 (до начала координат).", "C — знаки центра.", "E — центр в начале."], "t": "Ось y → x-координата; ось x → y-координата."},
"12":{"i": "Находим r и a, затем сумму.", "s": ["ar⁴/ar = r³ = 48/(−6) = −8 → r = −2.", "a = −6/(−2) = 3.", "S₆ = 3(1 − 64)/(1 + 2) = −63."], "n": ["C — потерян минус.", "B, D — деление на 6.", "E — неверно."], "t": "S = a(1 − rⁿ)/(1 − r)."},
"13":{"i": "Обе последовательности одинаковой длины; каждый член первой больше на 20.", "s": ["Членов: (797 − 200)/3 + 1 = 200.", "Разность пар: 200 − 180 = 20.", "200 · 20 = 4000."], "n": ["A, B, D, E — неверное число членов."], "t": "Не считайте суммы — вычитайте попарно."},
"14":{"i": "Катеты 5k и 12k, гипотенуза 13k.", "s": ["½ · 5k · 12k = 30k² = 240 → k² = 8 → k = 2√2.", "P = 30k = 60√2."], "n": ["A — k = 2.", "C, D, E — неверно."], "t": "Периметр 5-12-13 = 30k."},
"15":{"i": "Умножаем на 12 (НОК знаменателей).", "s": ["9(2 − x) − 4(5x + 14) ≥ 24x − 2.", "18 − 9x − 20x − 56 ≥ 24x − 2 → −38 − 29x ≥ 24x − 2.", "−36 ≥ 53x → x ≤ −36/53."], "n": ["A — 35 вместо 53.", "B — знак.", "D, E — неверно."], "t": "Делим на положительное 53 — знак не меняется."},
"16":{"i": "Для 0 < x < 1 корень увеличивает, степень уменьшает.", "s": ["x = 0,25: √x = 0,5; x = 0,25; x² = 0,0625; x³ ≈ 0,016.", "Наибольшее √x."], "n": ["A, B, D — меньше √x."], "t": "Подставьте конкретное число."},
"17":{"i": "Основание AB горизонтально.", "s": ["AB = 4.", "Высота: 6 − 2 = 4.", "S = ½ · 4 · 4 = 8."], "n": ["D — забыли ½.", "A, C, E — неверно."], "t": "Горизонтальная сторона — удобное основание."},
"18":{"i": "Время = нужный объём / скорость.", "s": ["330 − 150 = 180 млн л.", "180/40 = 4,5 месяца = 135 дней.", "1 февраля + 4 месяца = 1 июня, + 15 дней = 16 июня."], "n": ["B — без полумесяца.", "A, D — неверно."], "t": "0,5 месяца = 15 дней (по условию месяц = 30 дней)."},
"19":{"i": "Считаем по частям.", "s": ["4⁵ − 2⁸ = 1024 − 256 = 768.", "2⁻³ + 2⁻⁵ = 1/8 + 1/32 = 5/32.", "768 · 5/32 = 120.", "2² − 2⁰ = 3 → 120/3 = 40."], "n": ["A — без 2.", "B, C, E — арифметика."], "t": "2⁰ = 1."},
"20":{"i": "Находим ∠ABC из треугольника EAB, затем используем вписанный четырёхугольник.", "s": ["∠ABE = 180° − 30° − 80° = 70° = ∠ABC.", "Противоположные углы вписанного четырёхугольника = 180°.", "∠ADC = 180° − 70° = 110°."], "n": ["A (70°) — это ∠B.", "C (100°) — 180 − 80.", "B, E — неверно."], "t": "Вписанный четырёхугольник: ∠A + ∠C = ∠B + ∠D = 180°."},
"21":{"i": "Раскладываем перемещения на восток и юг.", "s": ["Первый курс 120°: восток 120 sin 60°... = 120 · sin 120° ≈ 103,9; юг 60.", "Курс 210° — 30° к западу от юга: сдвиг на запад = d · sin 30°.", "d · ½ = 103,9 → d ≈ 208."], "n": ["A, C, D — неверное разложение."], "t": "Пеленг отсчитывается от севера по часовой стрелке."},
"22":{"i": "Считаем операции по шагам.", "s": ["3#2 = 4 − 12 + 3 = −5.", "2#3 = 9 − 12 + 2 = −1.", "(−5)#(−1) = 1 − 2 · (−5)(−1) + (−5) = 1 − 10 − 5 = −14."], "n": ["B, C, D, E — ошибки знаков."], "t": "b² первым — внимательно с порядком аргументов."},
"23":{"i": "Площади подобных фигур ∝ k².", "s": ["54/24 = 9/4 → k = 3/2.", "PQ = 8 · 1,5 = 12."], "n": ["D (18) — умножили на 9/4.", "B, C, E — неверно."], "t": "Площади → корень → отношение длин."},
"24":{"i": "Подстановка y = 2x + 3 в уравнение окружности.", "s": ["x² + (2x + 3)² + x − 2(2x + 3) − 3 = 0.", "x² + 4x² + 12x + 9 + x − 4x − 6 − 3 = 5x² + 9x = 0.", "x = 0 → y = 3; x = −9/5 → y = −3/5."], "n": ["Другие пары не лежат на прямой y = 2x + 3."], "t": "Проверка на прямой отсекает варианты быстро."},
"25":{"i": "Выражаем площадь сектора через r и находим максимум.", "s": ["Дуга = 20 − 2r.", "S = ½ · r · дуга = r(10 − r) = 25 − (r − 5)².", "Максимум при r = 5."], "n": ["E — угол определяется через r.", "A, B, D — не вершина параболы."], "t": "Площадь сектора = ½ · r · длина дуги."},
"26":{"i": "Подстановка.", "s": ["x² + (2x − 1)² = 2 → 5x² − 4x − 1 = 0.", "(5x + 1)(x − 1) = 0 → x = 1 или −0,2."], "n": ["A — y = 2 неверно (y = 1).", "B, C, E — неверные корни."], "t": "Спрашивают значения x."},
"27":{"i": "Отражения меняют координаты по правилам.", "s": ["Отражение в y = 1: y → 2 − y → Q(3; −2).", "Отражение в оси y: x → −x → R(−3; −2).", "PR = √(36 + 36) = 6√2."], "n": ["A — только горизонтальное расстояние.", "C, D, E — неверно."], "t": "Отражение в y = c: y' = 2c − y."},
"28":{"i": "Приводим к основаниям 2 и 3.", "s": ["2^(2x) = 2^(3(y − 1)) → 2x = 3y − 3.", "3^(2y) = 3^(3(x + 1)) → 2y = 3x + 3 → y = (3x + 3)/2.", "2x = (9x + 9)/2 − 3 → 4x = 9x + 3 → x = −3/5."], "n": ["A, B, C, E — не удовлетворяют системе."], "t": "4 = 2², 8 = 2³, 9 = 3², 27 = 3³."},
"29":{"i": "Диагональ квадрата = a√2.", "s": ["a = 10 → радиус вписанного круга 5.", "S = 25π."], "n": ["E, D — неверный радиус.", "A, C — неверно."], "t": "Вписанный круг: r = a/2."},
"30":{"i": "y · (x − 2)² = const.", "s": ["5 · (4 − 2)² = 20.", "y = 20/(7 − 2)² = 20/25 = 0,8."], "n": ["C (1,25) — перевёрнуто.", "E (20) — константа.", "B, D — неверно."], "t": "Обратная пропорциональность: произведение постоянно."}
}
