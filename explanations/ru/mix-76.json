{
"1":{"i": "Скидка 0,3P в долларах; новая цена 1,5P.", "s": ["0,3/1,5 = 20%. Ответ B."], "n": ["A — 30 − 20."], "t": "Процент от новой цены."},
"2":{"i": "ED = BE → ∠EDB = ∠EBD = B/2.", "s": ["Внешний угол △ECD: ∠ACB = 10 + B/2.", "20 + B + 10 + B/2 = 180 → B = 100 → ∠ACB = 60°. Ответ B."], "n": ["D — 70."], "t": "Внешний угол треугольника."},
"3":{"i": "3 · 3ˣ / (3 · 6ˣ) = (1/2)ˣ.", "s": ["2⁻ˣ. Ответ B."], "n": ["A — перевёрнуто."], "t": "(3/6)ˣ."},
"4":{"i": "Glen Oak: 7 · 4 · 4 · 2 = 224; Belmont: 5 · 8 · 2 · 3 = 240.", "s": ["240 − 224 = 16. Ответ C."], "n": ["A — сложили."], "t": "Правило произведения."},
"5":{"i": "Делим на cos x: (t + 1)/(t − 1) = 3.", "s": ["t + 1 = 3t − 3 → t = 2. Ответ E."], "n": ["A — ½."], "t": "Переход к tg."},
"6":{"i": "2^{1/2} · 2^{2/3} · 2^{5/6}.", "s": ["2^{(3 + 4 + 5)/6} = 2² = 4. Ответ B."], "n": ["A — 2¹."], "t": "Всё к основанию 2."},
"7":{"i": "Конфеты 10/1,25 = 8; газировка 6/1,5 = 4.", "s": ["8 + 4 = 12. Ответ B."], "n": ["A — вычитали проценты."], "t": "Делите на множитель роста."},
"8":{"i": "Период 1, 2, 5 (сумма 8); 100 = 33 · 3 + 1.", "s": ["33 · 8 + 1 = 265. Ответ D."], "n": ["E — без последнего члена."], "t": "Остаток периода."},
"9":{"i": "AC = √52 = 2√13; AE = AD²/AC = 16/(2√13) = 8/√13.", "s": ["EC = 2√13 − 8/√13 = 18/√13. Ответ E."], "n": ["A — другая проекция."], "t": "Проекция катета."},
"11":{"i": "FG ∥ BC → △AFG равносторонний со стороной s (сторона квадрата).", "s": ["(√3/4)s² = 5√3 → s² = 20. Ответ C."], "n": ["B — × √3."], "t": "Площадь равностороннего треугольника."},
"12":{"i": "После 8-го звена (G) должно идти W — 9-е место; дальше идёт Y (место ≡ 2 mod 5).", "s": ["9 + n ≡ 2 (mod 5) → n ≡ 3 (mod 5) → 63. Ответ D."], "n": ["Остальные — другой остаток."], "t": "Остатки по 5."},
"13":{"i": "S(ABCD) = (5c + c)h/2 = 3ch; S(DCE) = ch/2.", "s": ["3ch : ch/2 = 6. Ответ D."], "n": ["C — 5."], "t": "Одинаковая высота."},
"14":{"i": "0 ≤ |cos(α/2)| ≤ 1.", "s": ["1 ≤ … ≤ 2. Ответ B."], "n": ["A — без +1."], "t": "Модуль ≥ 0."},
"15":{"i": "Неверно: W = x/2 + 5 → x/2 = W − 5.", "s": ["Верно: x/4 + 10 = (W − 5)/2 + 10 = W/2 + 7,5. Ответ D."], "n": ["A — +5."], "t": "Выразите x через W."},
"16":{"i": "Сумма = (π/8)(AC² + BC²) = (π/8) · 16.", "s": ["2π. Ответ B."], "n": ["C — радиусы = диаметры."], "t": "Пифагор."},
"17":{"i": "Две последовательные скидки перемножаются.", "s": ["b(1 − x/100)(1 − t/100). Ответ A."], "n": ["C — сложили."], "t": "Множители."},
"18":{"i": "Сумма 200, двух — 90 → двух других 110.", "s": ["Минимум 1 для одного → 109. Ответ D."], "n": ["C — 100."], "t": "Положительные — не меньше 1."},
"20":{"i": "n букв дают n + C(n, 2) кодов.", "s": ["n = 6: 21 < 26; n = 7: 28 ≥ 26 → 7. Ответ D."], "n": ["C — 21 мало."], "t": "Одиночные + пары."},
"24":{"i": "Не представимы числа вида 4ᵃ(8b + 7); среди 1…14 — только 7.", "s": ["14 − 1 = 13. Ответ D."], "n": ["E — 12."], "t": "Теорема Лежандра."},
"25":{"i": "Малый круг: радиус R/2; закрашено πR² − πR²/4 = 3πR²/4.", "s": ["(3πR²/4) : (πR²/4) = 3. Ответ E."], "n": ["C — 2."], "t": "Площадь ∝ r²."},
"27":{"i": "(a + b)/2 = 3b/4 → a = b/2; (b + c)/2 = 7c/8 → b = 3c/4.", "s": ["a = 3c/8; медиана R = (3c/8 + c)/2 = 11c/16. Ответ C."], "n": ["E — 3/4."], "t": "Медиана — среднее крайних."},
"29":{"i": "Циферблат — остаток от деления на 6.", "s": ["2000 = 6 · 333 + 2 → 2. Ответ C."], "n": ["A — кратно 6?"], "t": "mod 6."},
"30":{"i": "(2c² − 1)(c² − 1) > 0, c = cos x, c² ≤ 1.", "s": ["c² < ½ → π/4 + kπ < x < 3π/4 + kπ. Ответ A."], "n": ["E — обратная область."], "t": "Замена t = cos²x."}
