{
"1":{"i": "35² − 1 = 34 · 36 = 1224 = 2³ · 3² · 17.", "s": ["16 = 2⁴ не делит 1224. Ответ D."], "n": ["8, 9, 12, 17 — делители."], "t": "Разность квадратов."},
"2":{"i": "Отражено 80%, из них проходит 60%.", "s": ["0,8 · 0,6 = 0,48 → 48%. Ответ C."], "n": ["B — 80 − 40."], "t": "Проценты перемножаются."},
"3":{"i": "70 + R + 10R + S + 11R = 117 → 22R + S = 47.", "s": ["R = 2, S = 3. Ответ C."], "n": ["Остальные не дают 47."], "t": "Распишите разряды."},
"4":{"i": "∠BDF = (180 − B)/2, ∠CDE = (180 − C)/2.", "s": ["∠FDE = (B + C)/2 = 50 → B + C = 100 → ∠A = 80°. Ответ D."], "n": ["A — 50."], "t": "Углы при основаниях равнобедренных."},
"6":{"i": "50 · 1,25 · 0,8.", "s": ["= 50. Ответ C."], "n": ["B — сложили проценты."], "t": "1,25 · 0,8 = 1."},
"7":{"i": "r = 10, край полосы в 6 от центра.", "s": ["Высота √(100 − 36) = 8 − 0,5 = 7,5 фута. Ответ B."], "n": ["C — без запаса."], "t": "Пифагор."},
"8":{"i": "x = 27^{−1/3} = 1/3.", "s": ["x^{−1/x} = (1/3)^{−3} = 27. Ответ A."], "n": ["C — само x."], "t": "Отрицательная степень — перевёрнутая дробь."},
"9":{"i": "Первое: ½(x − 1) < 13/8 → x < 17/4.", "s": ["Второе × 12: −5x + 12 < 24 → x > −12/5. Ответ E."], "n": ["C — знак."], "t": "При делении на отрицательное знак меняется."},
"10":{"i": "Верхняя половина: 2π − π (малый круг) = π.", "s": ["Нижняя: 2π − 2 · π/2 = π. Итого 2π. Ответ B."], "n": ["A — одна половина."], "t": "Разбейте на половины."},
"11":{"i": "C + 8 = 2(B + 8).", "s": ["C = 2B + 8. Ответ D."], "n": ["C — B + 8."], "t": "Переведите текст в уравнение."},
"13":{"i": "Проверим 4ⁿ + 8: 12, 24, 72, 264 ✔.", "s": ["Ответ E."], "n": ["C — 12, 144…"], "t": "Подставьте n = 1, 2, 3."},
"14":{"i": "100 : 4,5 ≈ 22,2 платежа по 2 недели.", "s": ["≈ 44 недели ≈ 11 месяцев → расплатится к 12-му месяцу. Ответ B."], "n": ["A — 8 мало."], "t": "2 недели ≈ полмесяца."},
"15":{"i": "Найдём α, β: α(2p + 4r + 2n) + β(5p + 4r + 3n) = r − p.", "s": ["α = ¾, β = −½: r − p = ¾ · 21 − ½ · 17 = 15,75 − 8,5 = 7,25. Ответ A."], "n": ["B (6) — в старом ключе, неверно.", "E — ответ определяется."], "t": "Комбинация уравнений."},
"19":{"i": "10ˣ оканчивается на 0, 9ʸ — на 9 или 1.", "s": ["Разность оканчивается на 1 или 9; квадрат — на 1. Ответ E."], "n": ["A — без квадрата."], "t": "Последние цифры."},
"20":{"i": "AB = 6, BC = 4, CA = 4. Доли угловых треугольников: (2/6)(3/4), (4/6)(1/4), (3/4)(1/4).", "s": ["1 − 1/4 − 1/6 − 3/16 = 19/48. Ответ B."], "n": ["A — 19/128."], "t": "S = ½ab sin C — доли сторон."},
"21":{"i": "Глубины: Superior 1333, Michigan 923, Ontario 822, Huron 750, Erie 210.", "s": ["Третье — Ontario. Ответ D."], "n": ["B — Huron четвёртый."], "t": "Поверхность − дно."},
"22":{"i": "Пары: (2 − 1) + (4 − 3) + … + (100 − 99).", "s": ["50 пар по 1 = 50. Ответ A."], "n": ["B — 49."], "t": "Группируйте попарно."},
"23":{"i": "3-я цифра: 7, 8, 9 (3); 4-я: 3, 6, 9 (3); пары (5-я, 6-я): (3,1), (6,2), (9,3).", "s": ["3 · 3 · 3 = 27. Ответ A."], "n": ["B — 36."], "t": "Правило произведения."},
"25":{"i": "Теорема Стюарта: AB² · DC + AC² · BD = BC(AD² + BD · DC).", "s": ["25 · 4 + 2x² = 6(16 + 8) = 144 → x² = 22 → √22. Ответ D."], "n": ["C — √21."], "t": "Стюарт для чевианы."},
"30":{"i": "2(r + t) = 5(r − t) → 3r = 7t.", "s": ["r/t = 7/3. Ответ E."], "n": ["C — перевёрнуто."], "t": "Перекрёстное умножение."}
}
