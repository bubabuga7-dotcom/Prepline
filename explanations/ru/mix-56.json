{
"1":{"i": "Раскроем 4 произведения.", "s": ["√40·√10 = 20; √40·√8 = √320 = 8√5.", "−√5·√10 = −5√2; −√5·√8 = −2√10.", "20 + 8√5 − 5√2 − 2√10. Ответ D."], "n": ["A, C — перепутаны корни."], "t": "Упрощайте каждый корень."},
"2":{"i": "√(x² − 5) = y − 4.", "s": ["x² − 5 = y² − 8y + 16 → x² = y² − 8y + 21.", "x = ±√(y² − 8y + 21). Ответ D."], "n": ["A — забыли +5 к 16."], "t": "Возведите в квадрат и перенесите."},
"3":{"i": "Подставим точки.", "s": ["9 + 3p + q = 2; 4 + 2p + q = 1 → p = −4, q = 5.", "p + 4q = −4 + 20 = 16. Ответ A."], "n": ["D — знак."], "t": "Вычтите уравнения."},
"4":{"i": "Общий знаменатель x²(x − 2).", "s": ["3x(x − 2) + (x − 2) + 2x² = 5x² − 5x − 2. Ответ C."], "n": ["A — без 2x²."], "t": "Домножайте каждую дробь."},
"5":{"i": "R = a/√3 — треугольник равносторонний.", "s": ["Площадь = (√3/4)a². Ответ B."], "n": ["A — без деления на 2."], "t": "Формула для равностороннего."},
"6":{"i": "25^{3/2} = 125 → 5ⁿ = 625 → n = 4.", "s": ["9^m = 1/3 → m = −1/2.", "2m + n = −1 + 4 = 3. Ответ B."], "n": ["A — m = 1/2."], "t": "Приведите к одному основанию."},
"8":{"i": "Q : R = 15 : 6, R : S = 6 : 20.", "s": ["Q : S = 15 : 20 = 3 : 4. Ответ C."], "n": ["D — перемножили неверно."], "t": "Уравняйте общий член R."},
"9":{"i": "½(x − 1 + x + 5) · x = 120 → x(x + 2) = 120.", "s": ["x = 10 → RS = 15 см. Ответ A."], "n": ["C — само x + 2."], "t": "Площадь трапеции."},
"10":{"i": "x√y = 8 · 3 = 24.", "s": ["√y = 24 : 6 = 4 → y = 16. Ответ D."], "n": ["B — y без возведения в квадрат."], "t": "Обратная пропорция."},
"11":{"i": "Средний треугольник: катеты 15 и 20, гипотенуза 25.", "s": ["Подобие 3 : 4 : 5. Малый (гипотенуза 15): b = 9.", "Большой (катет 25): a = 25 · 5/3 = 125/3.", "a − b = 125/3 − 27/3 = 98/3. Ответ B."], "n": ["Остальные — другое соответствие сторон."], "t": "Найдите коэффициент подобия."},
"12":{"i": "36 = 2²·3², 48 = 2⁴·3, 60 = 2²·3·5.", "s": ["НОК = 2⁴ · 3² · 5 = 720. Ответ B."], "n": ["A — 2⁵·3·5."], "t": "Наибольшие степени."},
"13":{"i": "Ширина w, высота 2w: d² = w² + w² + 4w² = 6w².", "s": ["w = d/√6; V = w · w · 2w = 2w³ = 2d³/(6√6) = d³√6/18. Ответ B."], "n": ["C — без деления на 9."], "t": "Диагональ куба/кубоида."},
"14":{"i": "Основание 5–12–13 прямоугольное: площадь 30, периметр 30.", "s": ["2 · 30 + 30h = 360 → h = 10.", "V = 30 · 10 = 300. Ответ B."], "n": ["A — без деления на 2."], "t": "Боковая = периметр · h."},
"15":{"i": "НОК(40, 42) = 840 с = 14 мин.", "s": ["10:14. Ответ A."], "n": ["Остальные — не НОК."], "t": "Разложите на простые."},
"16":{"i": "2πr² + 2πrh = πr²h.", "s": ["2r + 2h = rh → h(r − 2) = 2r → h = 2r/(r − 2). Ответ B."], "n": ["A — знак."], "t": "Делите на πr."},
"17":{"i": "Числитель 640, знаменатель 0,016.", "s": ["640 : 0,016 = 40 000 → √ = 200. Ответ C."], "n": ["B — 2000."], "t": "10⁻² = 0,01."},
"18":{"i": "(2 − (3p − 1)) / (1 − p − 6) = −3.", "s": ["3 − 3p = 15 + 3p → p = −2; M(6, −7).", "y = −3x + r: −7 = −18 + r → r = 11. Ответ A."], "n": ["Остальные — ошибка в p."], "t": "Сначала p."},
"19":{"i": "От центра до вершины: половина стороны 5 и угол 60° у центра.", "s": ["R · sin 60° = 5 → R = 5/sin 60°. Ответ B."], "n": ["C — умножили."], "t": "Центральный угол 120°, половина — 60°."},
"20":{"i": "Сумма: 20 · 54 + PT = 56(20 + P).", "s": ["1080 + PT = 1120 + 56P → P(T − 56) = 40.", "P = 40/(T − 56). Ответ C."], "n": ["A — новое среднее перепутано со старым."], "t": "Через общие суммы."},
"21":{"i": "Брату 5/8 · 5000 = 3125.", "s": ["Другу 1/5 = 625. Ответ D."], "n": ["A — ошибка в доле."], "t": "Две пропорции."},
"22":{"i": "½ · 8 · AB = 32 → AB = 8 → ∠AOB = 45°.", "s": ["Круг без сектора 45°: 64π · 7/8 = 56π.", "Плюс треугольник 32: 56π + 32. Ответ A."], "n": ["B — весь круг минус меньше."], "t": "Равнобедренный прямоугольный — 45°."},
"23":{"i": "8t + 12c = 104, t + c = 10.", "s": ["80 + 4c = 104 → c = 6. Ответ C."], "n": ["A — подбор."], "t": "Система двух уравнений."},
"24":{"i": "54 : 3,6.", "s": ["15 м/с. Ответ C."], "n": ["B — 54/3."], "t": "км/ч → м/с: делить на 3,6."},
"25":{"i": "В треугольнике: (3x − 6) + 50° + (8x + 4) = 180°.", "s": ["(180 − 130 = 50; 8x + 4 — вертикальный угол).", "11x = 132 → x = 12 → ∠A = 30°. Ответ B."], "n": ["D — само x."], "t": "Смежный и вертикальный углы."},
"26":{"i": "a + 4d = a²; a + 32d = 10(a + 2d).", "s": ["12d = 9a → d = 3a/4 → 4a = a² → a = 4, d = 3.", "a₁₀ = 4 + 27 = 31. Ответ D."], "n": ["C — 9d ошибочно."], "t": "Выразите d через a."},
"28":{"i": "Рост · 1,06 = 159.", "s": ["159 : 1,06 = 150 см. Ответ C."], "n": ["B — 159 − 6%."], "t": "Обратный процент — деление."},
"29":{"i": "(n − 2) · 180°.", "s": ["18 · 180 = 3240°. Ответ C."], "n": ["A — лишние 400°."], "t": "Сумма углов многоугольника."},
"30":{"i": "x ♣ y = (x − y)².", "s": ["2 ♣ 4 = 4; 4 ♣ 8 = 16. Ответ A."], "n": ["C — первый шаг."], "t": "Узнайте формулу квадрата разности."}
}
