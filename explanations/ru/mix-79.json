{
"1":{"i": "Товары 8n; доставка 3 + (n − 1).", "s": ["8n + n + 2 = 9n + 2. Ответ C."], "n": ["D — 3 за каждый."], "t": "Первый — отдельно."},
"2":{"i": "1200 мл за 3600 с.", "s": ["3600 : 1200 = 3 с на 1 мл. Ответ D."], "n": ["A — перевёрнуто."], "t": "Час = 3600 с."},
"3":{"i": "CE = DE, ∠CED = 45° → ∠D = 67,5°; AB ∥ CE → ∠A = 45°.", "s": ["x = 180 − 45 − 67,5 = 67,5. Ответ C."], "n": ["D — 180 − 67,5."], "t": "Соответственные углы."},
"4":{"i": "Белых 140, коричневых 60; нужно 140 : 2 = 70.", "s": ["Добавить 10. Ответ A."], "n": ["E — 30."], "t": "Белые не меняются."},
"5":{"i": "Мальчиков в футболе 0,86 · 250 = 215 → девочек 35.", "s": ["Девочек 108; без футбола 108 − 35 = 73. Ответ B."], "n": ["E — все девочки."], "t": "Таблица 2 × 2."},
"6":{"i": "3,5c − (22 − c) = 63,5.", "s": ["4,5c = 85,5 → c = 19 → неверных 3. Ответ A."], "n": ["E — без минуса."], "t": "Одна переменная."},
"7":{"i": "(2k − 1)² − (2k)² = −(4k − 1) = −((2k − 1) + 2k).", "s": ["Сумма = −(1 + 2 + … + 1000) = −500 500. Ответ A."], "n": ["E — ошибка."], "t": "Разность квадратов."},
"8":{"i": "Большой диаметр 2(1 + 2 + 3 + 4) = 20 → дуга 10π.", "s": ["Малые дуги π(1 + 2 + 3 + 4) = 10π. Итого 20π. Ответ B."], "n": ["A — только одна часть."], "t": "Полуокружность = πr."},
"9":{"i": "4 хлеба · 5 соусов · (3 + 2).", "s": ["100. Ответ A."], "n": ["B — 3 · 2 вместо 3 + 2."], "t": "«Или» — сложение."},
"10":{"i": "Расстояние AB = 2r√2 = 4√2 → r = 2, сторона 8.", "s": ["64 − 4 · 4π = 64 − 16π. Ответ E."], "n": ["C — r = 4."], "t": "Центры по диагонали."},
"11":{"i": "A + 1 нечётно, B + 1 чётно.", "s": ["Нечётное : чётное — не целое. Ответ A."], "n": ["B — возможно целое."], "t": "Чётность."},
"12":{"i": "f(x²) = 2x² + 3.", "s": ["Ответ B."], "n": ["A — g(f(x))."], "t": "Внутренняя — g."},
"13":{"i": "(8ˣ)² = 1/4 → 8ˣ = 1/2.", "s": ["8⁻ˣ = 2. Ответ B."], "n": ["E — это 8ˣ."], "t": "Обратная величина."},
"14":{"i": "2³⁽ᵃ⁻ᵇ⁾ = 2⁵⁽ᵃ⁺ᵇ⁾ → −2a = 8b → a = −4b.", "s": ["(2b + 4b)/(7b − 4b) = 2. Ответ A."], "n": ["C — знак."], "t": "Одно основание."},
"15":{"i": "0,5 · 4% + 0,3 · 8%.", "s": ["2 + 2,4 = 4,4%. Ответ C."], "n": ["E — средний налог."], "t": "Взвешенная сумма."},
"16":{"i": "a² − 2ab + b = 0 — квадратное по a: D/4 = b² − b ≥ 0.", "s": ["b ≤ 0 или b ≥ 1 → ½ невозможно. Ответ D."], "n": ["C — b < 0 допустимо."], "t": "Дискриминант."},
"17":{"i": "R левее нуля → координата −r.", "s": ["(s + t − r)/3. Ответ E."], "n": ["D — без знака."], "t": "|x| = −x при x < 0."},
"18":{"i": "Ноль при x ≈ −0,8 (−π/4), максимум ≈ 1,4 (√2) при π/4.", "s": ["sin x + cos x = √2 sin(x + π/4). Ответ A."], "n": ["E — амплитуда 2√2."], "t": "Проверьте точку x = 0: значение 1."},
"20":{"i": "В Q нет x³: m − 1 = 0 → m = 1.", "s": ["2(n − 1) = 6 → n = 4; m + n = 5. Ответ C."], "n": ["B — n = 3."], "t": "Коэффициенты равны."},
"21":{"i": "Полукруг (r = 1) + прямоугольник 2 × 1 − две четверти круга.", "s": ["π/2 + 2 − π/2 = 2. Ответ B."], "n": ["A — без вычета."], "t": "π-части сокращаются."},
"22":{"i": "y > x и y > 5.", "s": ["xy² > x²y, xy² > 5xy, y > 4x/3 → xy² больше всех. Ответ B."], "n": ["D — 4x/3 < y."], "t": "Сравнивайте попарно."},
"24":{"i": "Первая цифра 1 → средняя 0 → последняя 1: только 101.", "s": ["1/100. Ответ D."], "n": ["E — 2 числа."], "t": "Всего 100 чисел."},
"25":{"i": "Последние две цифры: 02, 07, 22, 67, 02, … — цикл 4.", "s": ["35 = 4 · 8 + 3 → как у 3-го: 22 → 2 + 2 = 4. Ответ B."], "n": ["C — 07."], "t": "Цикл по модулю 100."},
"27":{"i": "y = x²(x² − 2): нули 0, ±√2, между ними ниже оси.", "s": ["W-образный, минимумы ниже оси. Ответ E."], "n": ["D — минимумы на оси."], "t": "Найдите нули."},
"28":{"i": "Верхний конус подобен с k = ½ → объём ⅛.", "s": ["⅛ : ⅞ = 1 : 7. Ответ D."], "n": ["E — 1 : 8."], "t": "Объём ∝ k³."},
"29":{"i": "cos x(1 + sin x + 1 − sin x)/(1 − sin²x).", "s": ["2cos x/cos²x = 2sec x. Ответ D."], "n": ["B — сократили неверно."], "t": "1 − sin² = cos²."},
"30":{"i": "Нейтральный элемент — c (строка c: a, b, c, d).", "s": ["d * d = c → обратный к d — сам d. Ответ D."], "n": ["C — нейтральный, не обратный."], "t": "x * x⁻¹ = e."}
}
