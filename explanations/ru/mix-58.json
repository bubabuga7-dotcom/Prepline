{
"1":{"i":"Сначала перемножим скобки: (√5 − 2)(√5 + 4) = 5 + 2√5 − 8 = 2√5 − 3.","s":["(2√5 − 3)² = 20 + 9 − 12√5 = 29 − 12√5. Ответ D."],"n":["Остальные — с √2, его тут нет."],"t":"(ab)² = a²b²."},
"2":{"i":"Ветви вниз, вершина (−1; 6), f(0) = 5.","s":["−x² − 2x + 5: вершина x = −1, f(−1) = 6. Ответ A."],"n":["B — вершина в x = 1."],"t":"x вершины = −b/(2a)."},
"3":{"i":"by² = x² + 2ax → (x + a)² = by² + a².","s":["x = (by² + a²)^{1/2} − a. Ответ A."],"n":["D — a под корнем."],"t":"Полный квадрат."},
"4":{"i":"3 ∞ 4 = 3⁸.","s":["(3⁸) ∞ 2 = (3⁸)⁴ = 3³². Ответ B."],"n":["A — 3^{8·3}."],"t":"y^{2x}: при x = 2 — четвёртая степень."},
"5":{"i":"Угол C прямой → A + B = 90°.","s":["sin A = 3/5 → tg A = 3/4 → tg B = 4/3. Ответ D."],"n":["C — cos A."],"t":"tg B = ctg A."},
"6":{"i":"5,4·10⁴ = 0,54·10⁵.","s":["1,52 + 0,54 = 2,06 → 2,06·10⁵. Ответ A."],"n":["C, D — не стандартный вид."],"t":"Приведите к одной степени."},
"7":{"i":"Сторона 12; шесть равносторонних треугольников.","s":["6 · (√3/4) · 144 = 216√3. Ответ C."],"n":["A — один треугольник × 2."],"t":"S = (3√3/2)a²."},
"8":{"i":"2xy⁻²y⁴ / 4xy = y/2 → в степени −1: 2/y.","s":["xy / (2x³y) = 1/(2x²).","2/y · 1/(2x²) = 1/(x²y). Ответ C."],"n":["A — без степени −1."],"t":"Сначала упростите скобку."},
"9":{"i":"Сумма = 10 · (a + 2a)/2 = 15a = 675 → a = 45.","s":["Последняя 90 = 45 + 9d → d = 5. Ответ B."],"n":["A — 45/3."],"t":"От первого к десятому — 9 шагов."},
"10":{"i":"Коэффициент 24 : 16 = 3/2.","s":["2y − 3 = 15 → y = 9; x + 7 = 18 : 1,5 = 12 → x = 5.","x + y = 14. Ответ D."],"n":["Остальные — другое соответствие."],"t":"Наибольшая к наибольшей."},
