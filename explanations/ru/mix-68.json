{
"1":{"i": "Две скидки по 10%: 0,9 · 0,9 = 0,81.", "s": ["Итоговая скидка 19%. Ответ B."], "n": ["C — сложили проценты.", "E (22%) — в старом ключе, неверно."], "t": "Скидки перемножаются."},
"2":{"i": "Сложим уравнения: 4x + 3y = 24; решим: x = 3, y = 4.", "s": ["x + y = 7. Ответ E."], "n": ["B (4) — это y, в старом ключе."], "t": "Решите систему."},
"3":{"i": "Пары с разностью 2: (1,3),(2,4),(3,5),(4,6) и обратные — 8 из 36.", "s": ["8/36 = 2/9. Ответ E."], "n": ["D — без обратных пар."], "t": "Порядок кубиков важен."},
"5":{"i": "A(0;0), B(0;1), C(1;1) → E(2;2).", "s": ["BE = √(2² + 1²) = √5. Ответ A."], "n": ["B — только по горизонтали."], "t": "Координаты."},
"6":{"i": "x³ + 1/x³ = (x + 1/x)³ − 3(x + 1/x).", "s": ["27 − 9 = 18. Ответ C."], "n": ["E — без −9."], "t": "Куб суммы."},
"7":{"i": "Нечётные степени: (1/3)/(1 − 1/9) = 3/8; чётные: (2/9)/(8/9) = 1/4.", "s": ["3/8 + 1/4 = 5/8. Ответ E."], "n": ["A — только 1/3 + 1/3²…"], "t": "Разбейте на две геометрические прогрессии."},
"8":{"i": "x = 5: 2f(5) + f(−4) = 25; x = −4: 2f(−4) + f(5) = 16.", "s": ["Из первого × 2 минус второе: 3f(5) = 34 → f(5) = 34/3. Ответ B."], "n": ["A — подстановка только одного x."], "t": "Подставьте x и 1 − x."},
"9":{"i": "Для таких параллельных отрезков: 1/CZ = 1/AX + 1/BY.", "s": ["1/4 + 1/6 = 5/12 → CZ = 12/5 = 2⅖. Ответ C."], "n": ["Остальные — не по формуле."], "t": "Следует из двух пар подобных треугольников."},
"10":{"i": "a² = a + 1 → a³ = 2a + 1.", "s": ["a⁶ − 2a⁵ + a³ = a³(a³ − 2a² + 1) = a³(2a + 1 − 2a − 2 + 1) = 0.", "Значение 5. Ответ D."], "n": ["A — забыли +5."], "t": "Понижайте степень через a² = a + 1."},
"11":{"i": "|30h − 5,5m| = 90.", "s": ["≈ 1:22, 1:55, 2:27, 3:00, 3:33 — 5 раз. Ответ D."], "n": ["E — двойной счёт 3:00."], "t": "Минутная догоняет со скоростью 5,5°/мин."},
"12":{"i": "1 + … + 16 = 136, 4 строки.", "s": ["136 : 4 = 34. Ответ B."], "n": ["Остальные — арифметика."], "t": "Сумма всех / число строк."},
"13":{"i": "|a − b| = |b − a| — коммутативна; 0 — нейтральный; a * a = 0 — обратный.", "s": ["Ассоциативности нет: (1*1)*1 = 1, 1*(1*1) = 1, но (3*2)*1 = 0 ≠ 3*(2*1) = 2.", "A, C, D. Ответ D."], "n": ["C — ассоциативность ложна."], "t": "Ищите контрпример."},
"14":{"i": "(x − 2y)(x + 2y) = −3.", "s": ["Пары (1;−3), (−1;3), (3;−1), (−3;1) → (±1; ±1) — 4 решения. Ответ D."], "n": ["B — только положительные."], "t": "Разложите разность квадратов."},
"15":{"i": "AB = √2 → угол в каждом центре 90°.", "s": ["Пересечение = 2 сегмента: 2(π/4 − ½) = π/2 − 1. Ответ A."], "n": ["C — один сектор."], "t": "Сектор − треугольник."},
"16":{"i": "Хорда 10 касается коврика: R² − r² = 5² = 25.", "s": ["π(R² − r²) = 25π. Ответ D."], "n": ["E — 10²."], "t": "Радиусы знать не нужно."},
"17":{"i": "Сумма чётных коэффициентов = (f(1) + f(−1))/2.", "s": ["f(1) = 4⁵ = 1024; f(−1) = 2⁵ = 32 → (1024 + 32)/2 = 528. Ответ C."], "n": ["E — только f(1)."], "t": "Подставьте ±1."},
"18":{"i": "10x² − 3xy − y² = (5x + y)(2x − y).", "s": ["Асимптоты y = 2x и y = −5x → наклон 2. Ответ A."], "n": ["C — наклон 1/√2.", "B — парабола."], "t": "Старшие члены задают асимптоты."},
"19":{"i": "Делим на cos 15°: (1 + tg 15°)/(1 − tg 15°) = tg 60°.", "s": ["√3. Ответ B."], "n": ["A — √2."], "t": "tg(45° + α)."},
"20":{"i": "Сумма = 2k − 8; |S| = 0 при k = 4: C(8,4) = 70.", "s": ["|S| = 2 при k = 3 или 5: 56 + 56 = 112 — больше. Ответ B."], "n": ["A — 0 вероятен, но не самый."], "t": "Учитывайте ±."},
"21":{"i": "(S + 97)/(n + 1) = 90, (S + 73)/(n + 1) = 87.", "s": ["Разность: 24/(n + 1) = 3 → n = 7. Ответ E."], "n": ["Остальные — не то n."], "t": "Вычтите уравнения."},
"22":{"i": "17⁹ − 9⁹ = (17 − 9)(…), вторая скобка — сумма 9 нечётных → нечётна.", "s": ["Наибольшая степень двойки — 2³ = 8 → n = 3. Ответ A."], "n": ["Остальные — больше 3."], "t": "aⁿ − bⁿ = (a − b)(…)."},
"23":{"i": "∠QRO = ∠QOR = α; ∠PQO = 2α (внешний) = ∠POQ.", "s": ["∠POR = 3α = 60° → α = 20°. Ответ B."], "n": ["A — 18°."], "t": "Внешний угол треугольника."},
"24":{"i": "1/(√(n + 1) + √n) = √(n + 1) − √n.", "s": ["Телескоп: √25 − √1 = 4. Ответ C."], "n": ["E — без вычета."], "t": "Домножьте на сопряжённое."},
"25":{"i": "Герон: s = 4,5; S = √(4,5 · 2,5 · 1,5 · 0,5) = 3√15/4.", "s": ["R = abc/(4S) = 24/(3√15) = 8√15/15. Ответ B."], "n": ["D — среднее."], "t": "R = abc / 4S."},
"26":{"i": "Порядок 1, 2, 3, 4 фиксирован — одна из 4! расстановок.", "s": ["7! / 4! = 210. Ответ D."], "n": ["B — 180."], "t": "Деление на число перестановок."},
"27":{"i": "r + s + t = −2, rs + st + tr = 5.", "s": ["r² + s² + t² = 4 − 10 = −6. Ответ A."], "n": ["B — знак."], "t": "(Σr)² − 2Σrs."},
"28":{"i": "Максимум минимума — на пересечении x + 2 = −2x + 4 → x = 2/3.", "s": ["f = 8/3 (4x + 1 = 11/3 больше). Ответ C."], "n": ["E — 3."], "t": "Нарисуйте три прямые."},
"29":{"i": "Умножим на 8 sin 20° и трижды применим sin 2α.", "s": ["8 sin 20° · П = sin 160° = sin 20° → П = 1/8. Ответ C."], "n": ["D — 1/16."], "t": "2 sin α cos α = sin 2α."},
"30":{"i": "Наименьшая repunit, делящаяся на 13 — 111111 = 3 · 7 · 11 · 13 · 37.", "s": ["m — repunit из 6k единиц, всегда делится на 3, 7, 11, 37; на 17 — нет обязательно. Ответ D."], "n": ["Остальные — делители 111111."], "t": "Разложите 111111."}
}
