{
"1":{"i": "25 столбов → 24 промежутка по 1,5 м.", "s": ["36 + 25 · 0,16 = 36 + 4 = 40 м. Ответ E."], "n": ["B — 25 промежутков без столбов."], "t": "Промежутков на 1 меньше."},
"2":{"i": "1,3·10¹⁷ : 3,2·10⁷.", "s": ["≈ 0,41·10¹⁰ = 4,1·10⁹. Ответ B."], "n": ["A — неверная мантисса."], "t": "Мантиссы и степени отдельно."},
"3":{"i": "Q = 6k + 4.", "s": ["2Q + 6 = 12k + 14 — не кратно 6. Ответ C."], "n": ["Остальные кратны 6."], "t": "Подставьте Q = 4."},
"4":{"i": "Сумма углов △ABC: x + (37 + z) + 70 = 180.", "s": ["x = 73 − z. Ответ E."], "n": ["A — знак."], "t": "Угол B = 37 + z."},
"5":{"i": "Кратных 3: 8, кратных 5: 5, обоих (15): 1.", "s": ["(8 + 5 − 1)/25 = 12/25. Ответ D."], "n": ["E — без вычета."], "t": "Включения-исключения."},
"6":{"i": "3⁹ − 3⁸ = 2 · 3⁸, 3⁷ − 3⁶ = 2 · 3⁶.", "s": ["4 · 3¹⁴. Ответ E."], "n": ["B — потеряли 4."], "t": "Вынесите меньшую степень."},
"7":{"i": "ab/√(ab) = (ab)^{1/2}; корень 4-й степени: (ab)^{1/8}.", "s": ["Квадрат: (ab)^{1/4} — нет среди A–D. Ответ E."], "n": ["D — (ab)^{3/4}."], "t": "Показатели перемножаются."},
"8":{"i": "B = bc ≥ 2 · 1 = 2.", "s": ["В 214 B = 1 — невозможно. Ответ C."], "n": ["221: a = c = 1, b = 2 ✔."], "t": "Найдите минимум."},
"9":{"i": "A продано 10, B — 11 (тыс.); цена B = 1,6p.", "s": ["Выручка A 10p, B 17,6p → 10/27,6 ≈ 36%. Ответ B."], "n": ["E — по штукам."], "t": "Выручка = цена × количество."},
"10":{"i": "Проекция CD на землю: CD · cos 30°.", "s": ["10√3 · √3/2 = 15. Ответ C."], "n": ["A — сам отрезок."], "t": "Прилежащий катет."},
"11":{"i": "Наименьшая окружность — с диаметром PQ: r = 1.", "s": ["A ≥ π, больше — без ограничений. Ответ E."], "n": ["D — π достижимо."], "t": "Хорда ≤ диаметр."},
"12":{"i": "AB = 4, DH = 2, BE = 1.", "s": ["Белое 4 + 1 = 5 из 16 → закрашено 11/16. Ответ D."], "n": ["E — без малого квадрата."], "t": "Доли площадей."},
"13":{"i": "Общий знаменатель 2¹⁵: 8 + 8 + 6 + 4 = 26.", "s": ["26/2¹⁵ = 13/2¹⁴. Ответ E."], "n": ["C — числители без множителей."], "t": "Приведите к 2¹⁵."},
"14":{"i": "Оба курса: x + y − (n − z).", "s": ["Доля (x + y + z)/n − 1. Ответ B."], "n": ["A — знак."], "t": "Включения-исключения."},
"15":{"i": "Площадь квадрата 64 минус три угловых треугольника.", "s": ["½ · 5 · DE + ½ · 5 · EC + ½ · 3 · 8 = 2,5 · 8 + 12 = 32.", "64 − 32 = 32. Ответ C."], "n": ["A — посчитали не те треугольники."], "t": "DE + EC = 8 — положение E не важно."},
"16":{"i": "Среднее геометрическое: √((3 − 2√2)(3 + 2√2)).", "s": ["√(9 − 8) = 1. Ответ A."], "n": ["C — среднее арифметическое."], "t": "b² = ac."},
"17":{"i": "cos 35° = sin 55°.", "s": ["5x = 55° → x = 11°. Ответ B."], "n": ["A — 5x = 35."], "t": "cos α = sin(90° − α)."},
"18":{"i": "⁴√(16a⁸b⁴/(10⁻⁴c¹²)) = 2a²b/(0,1c³).", "s": ["2 · (1/9) · (1/10) / (0,1 · 8/27) = (1/45) · (27/0,8) = 3/4. Ответ D."], "n": ["A — перевёрнуто."], "t": "Сначала упростите корень."},
"20":{"i": "Одинаковый множитель k за 3 ч: 10k² = 14,4.", "s": ["k = 1,2 → 12 г. Ответ A."], "n": ["C — среднее арифметическое."], "t": "Геометрический рост."},
"23":{"i": "Места: 7 «малых». Варианты: 1 большая + 4 малых, 2 большие + 1 малая, 7 малых.", "s": ["3 · C(7,4) + C(3,2) · 7 + 1 = 105 + 21 + 1 = 127. Ответ D."], "n": ["C (126) — потеряли вариант из 7 малых."], "t": "Перебирайте заполнения места."},
"24":{"i": "cos x − sec x = −sin²x/cos x; sin x − csc x = −cos²x/sin x.", "s": ["−cos x − sin x. Ответ A."], "n": ["B — знак."], "t": "Приведите к sin и cos."},
"25":{"i": "cos(π/2 + x) = −sin x.", "s": ["sin(x − 2π) = sin x ≠ −sin x. Ответ D."], "n": ["Остальные равны −sin x."], "t": "Формулы приведения."},
"26":{"i": "Пятёрок в 50!: 10 + 2.", "s": ["12 нулей. Ответ A."], "n": ["B — 14."], "t": "⌊50/5⌋ + ⌊50/25⌋."},
"27":{"i": "5* = 4* · 1/5.", "s": ["1/5. Ответ E."], "n": ["A — перевёрнуто."], "t": "Произведения сокращаются."},
"28":{"i": "z ≥ x − 2 → x ≤ z + 2; z ≤ x + 5 → x ≥ z − 5.", "s": ["z − 5 ≤ x ≤ z + 2. Ответ B."], "n": ["C — знаки."], "t": "Выразите x из каждой части."},
"29":{"i": "sin 181° < 0, cos(−91°) = cos 91° < 0.", "s": ["tg(−275°) = −tg 275° > 0, ctg 350° < 0 → −, −, +, −. Ответ B."], "n": ["A — cos."], "t": "Знаки по четвертям."},
"30":{"i": "На квадрат остаётся 40 − 2πr → сторона 10 − πr/2.", "s": ["πr² + (10 − ½πr)². Ответ E."], "n": ["D — периметр вместо стороны."], "t": "Сторона = периметр/4."}
}
