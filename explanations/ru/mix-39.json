{
"1":{"i": "Возводим в куб каждый множитель.", "s": ["(6/3)³ = 8.", "(∛x)³ = x; y³; (z²)³ = z⁶.", "8xy³/z⁶."], "n": ["B — 6 и z⁴: забыли куб.", "C, E — y² вместо y³.", "D — 4 вместо 8."], "t": "(z²)³ = z⁶ — показатели перемножаются."},
"2":{"i": "70% = 7/10, а 70 = 2 · 5 · 7.", "s": ["70⁷⁰ = 2⁷⁰ · 5⁷⁰ · 7⁷⁰.", "· 7/(2 · 5) = 2⁶⁹ · 5⁶⁹ · 7⁷¹."], "n": ["A, B, D — делили не на 10 или не умножили на 7.", "E — лишний раз поделили на 2."], "t": "Процент = умножение на дробь."},
"3":{"i": "m · n³ = const.", "s": ["6 · (0,3)³ = 6 · 0,027 = 0,162.", "n = 30 → n³ = 27 000.", "m = 0,162/27 000 = 6 · 10⁻⁶ = 0,6 · 10⁻⁵."], "n": ["E — 6 · 10⁻⁵: ошибка на порядок.", "Остальные — неверный расчёт."], "t": "n выросло в 100 раз → m уменьшилось в 100³ = 10⁶ раз."},
"4":{"i": "Обратный пеленг = пеленг ± 180°.", "s": ["Караганда от Экибастуза: 210°.", "Экибастуз от Караганды: 210° − 180° = 030°."], "n": ["Остальные — пытались использовать равнобедренный треугольник; здесь это лишние данные."], "t": "Не все данные в условии нужны."},
"5":{"i": "Перемножаем коэффициенты изменений.", "s": ["−30% → × 0,7; +150% → × 2,5.", "0,7 · 2,5 = 1,75 = 35/20."], "n": ["A — +150% понято как × 1,5.", "Остальные — неверно."], "t": "«Увеличили на 150%» = × 2,5."},
"6":{"i": "Обратные действия в обратном порядке.", "s": ["y − 3 = (2x − 1)³.", "2x − 1 = ∛(y − 3).", "x = ∛(y − 3)/2 + ½."], "n": ["A — знак у 3 и ½.", "D, E — куб вместо корня."], "t": "Последним действием было «+3» — снимаем его первым."},
"7":{"i": "Центры кругов — равносторонний треугольник со стороной 4; закрашено = треугольник − 3 сектора по 60°.", "s": ["Треугольник: (√3/4) · 16 = 4√3.", "Три сектора 60° радиуса 2 = половина круга: ½ · 4π = 2π.", "4√3 − 2π."], "n": ["A — сторона 2 вместо 4.", "Остальные — неверно."], "t": "3 × 60° = 180° — полкруга."},
"8":{"i": "Решаем квадратное неравенство.", "s": ["108 − 2n² &gt; 5n + 3 → 2n² + 5n − 105 &lt; 0.", "Корень: n = (−5 + √865)/4 ≈ 6,1.", "Наибольшее целое n = 6."], "n": ["C (7): T = 10, S = 38 — уже меньше.", "Остальные — неверно."], "t": "Проверка n = 6: T = 36 &gt; S = 33 ✓."},
"9":{"i": "Минутная 6°/мин, часовая 0,5°/мин.", "s": ["Минутная: 50 · 6 = 300°.", "Часовая: 150 + 50 · 0,5 = 175°.", "300 − 175 = 125°."], "n": ["F — без сдвига часовой.", "Остальные — неверно."], "t": "Часовая стрелка тоже движется."},
"10":{"i": "Корни r и r + 1, сумма по Виета −3.", "s": ["2r + 1 = −3 → r = −2.", "Корни −2 и −1 → больший −1."], "n": ["B — меньший корень.", "C, D — знак."], "t": "Проверка: c = 2, x² + 3x + 2 = (x + 1)(x + 2) ✓."},
"11":{"i": "Сторона ромба — из половин диагоналей, затем коэффициент подобия.", "s": ["Сторона: √(16 + 9) = 5; площадь 8 · 6/2 = 24.", "k = √300/5 → k² = 300/25 = 12.", "24 · 12 = 288."], "n": ["Остальные — k вместо k² или неверно."], "t": "Площадь растёт в k² раз."},
"12":{"i": "Жидкость — подобный конус с k = ⅔.", "s": ["V = (⅔)³ · V_полн = 8/27 V_полн → V_полн = 27V/8.", "Добавить: 27V/8 − V = 19V/8."], "n": ["A — линейно по высоте.", "Остальные — неверно."], "t": "Объёмы подобных тел ∝ k³."},
"13":{"i": "Сначала скобка.", "s": ["3 ⊕ 2 = 2/3 − 3/2 = −5/6.", "1 ⊕ (−5/6) = −5/6 − 1/(−5/6) = −5/6 + 6/5 = 11/30."], "n": ["B — только внутренний шаг.", "Остальные — ошибки со знаками."], "t": "a ⊕ b = b/a − a/b — порядок важен."},
"14":{"i": "Сравниваем нижние компоненты.", "s": ["2 · 11 + 5 · (−k) = 42 → 22 − 5k = 42 → k = −4."], "n": ["E — делили на 10.", "Остальные — неверно."], "t": "Компоненты векторов складываются отдельно."},
"16":{"i": "Умножаем на 6.", "s": ["2(x − 5) + 3(7 − 2x) + 48 &gt; 0.", "2x − 10 + 21 − 6x + 48 &gt; 0 → 59 − 4x &gt; 0.", "x &lt; 59/4."], "n": ["F — знак не перевернули при делении на −4.", "Остальные — ошибки раскрытия."], "t": "Делим на отрицательное — знак меняется."},
"19":{"i": "По частям.", "s": ["(4 · 10²)² = 16 · 10⁴.", "16 · 10⁴ · 5 · 10⁻⁴ = 80 = 8 · 10¹."], "n": ["Остальные — ошибка в степени."], "t": "10⁴ · 10⁻⁴ = 1."},
"20":{"i": "Две полусферы = шар; плюс боковая поверхность цилиндра.", "s": ["Шар: 4π · 225 = 900π.", "Цилиндр: 2π · 15 · 88 = 2640π.", "3540π."], "n": ["Остальные — неверная длина цилиндра (118 вместо 88) или полусфера одна."], "t": "Основания цилиндра внутри — не считаются."},
"21":{"i": "Подставляем точки.", "s": ["Q(0; −2): 2b = −9 → b = −4,5.", "P(2; −4): 2a + 4b = −9 → 2a = 9 → a = 4,5.", "a + b = 0."], "n": ["A — только a.", "Остальные — ошибки знака."], "t": "Точка на оси убирает одну переменную."},
"22":{"i": "Треугольник ACD прямоугольный.", "s": ["AD = √(3 + 1) = 2 → BD = 2.", "BC = 3 → AB = √(3 + 9) = 2√3."], "n": ["A — это AD.", "F — BD + BD.", "Остальные — неверно."], "t": "AB — гипотенуза треугольника ABC."},
"23":{"i": "Два различных корня ⇔ D &gt; 0.", "s": ["2x² − 4x − (13 + k) = 0.", "D = 16 + 8(13 + k) &gt; 0 → k &gt; −15."], "n": ["Остальные — ошибка при переносе k."], "t": "Перенесите k в левую часть."},
"24":{"i": "Квадрат a × a и четыре полукруга диаметра a.", "s": ["Полукругов 4 = два круга радиуса a/2: 2 · πa²/4 = πa²/2.", "S = a² + ½πa²."], "n": ["A — два полукруга.", "Остальные — без квадрата или неверно."], "t": "Радиус = a/2."},
"25":{"i": "Сравниваем площади поверхностей.", "s": ["Было: 6 · 16 = 96.", "Стало: 64 · 6 = 384.", "Рост: 288/96 = 300%."], "n": ["E — новое значение в процентах от старого.", "Остальные — неверно."], "t": "«Увеличение» = (новое − старое)/старое."},
"27":{"i": "Ветви вверх, ≤ 0 — между корнями.", "s": ["1 ≤ x ≤ 3."], "n": ["A, C — неверные корни.", "B — неполно."], "t": "Корни видны сразу: 1 и 3."},
"28":{"i": "Подставляем варианты: медленная работала 9 ч, быстрая — 2 ч.", "s": ["B: 9/12 + 2/8 = ¾ + ¼ = 1 ✓."], "n": ["Остальные: сумма ≠ 1."], "t": "Медленная труба работала 7 + 2 = 9 часов."},
"29":{"i": "Складываем все три уравнения.", "s": ["15x + 15y + 15z + 13 = 58.", "x + y + z = 3.", "3 − 34 = −31."], "n": ["Остальные — неверное сложение свободных членов."], "t": "Коэффициенты при каждой переменной в сумме 15 — так и задумано."},
"30":{"i": "Одинаковые единицы.", "s": ["600 : 2200 = 6 : 22 = 3 : 11."], "n": ["Остальные — ошибки в переводе кг в г."], "t": "2,2 кг = 2200 г."}
