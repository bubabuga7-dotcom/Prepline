{
"1":{"i": "3x² − 6x = 3x(x − 2) — сокращаем на (x − 2).", "s": ["3x(4x − 3) = 12x² − 9x. Ответ A."], "n": ["Остальные — ошибка при умножении."], "t": "Сначала вынесите общий множитель."},
"2":{"i": "a₅ = a₁ + 3¹ + 3² + 3³ + 3⁴.", "s": ["1 + 3 + 9 + 27 + 81 = 121. Ответ C."], "n": ["A — только 3⁴."], "t": "Разности складываются."},
"3":{"i": "t = x²: 4t² + 9t − 63 = 0.", "s": ["D = 81 + 1008 = 1089 = 33² → t = (−9 + 33)/8 = 3.", "x = ±√3. Ответ B."], "n": ["Отрицательное t корней не даёт."], "t": "Биквадратное уравнение."},
"4":{"i": "S = ½ · d₁ · d₂ · sin α.", "s": ["½ · 15 · 20 · (√3/2) = 75√3. Ответ C."], "n": ["Остальные — арифметика."], "t": "Площадь через диагонали."},
"5":{"i": "Угол правильного пятиугольника 108°; △BCD равнобедренный (BC = CD).", "s": ["x = (180 − 108)/2 = 36°. Ответ B."], "n": ["D — 72 = 2x."], "t": "Углы при основании равны."},
"6":{"i": "V = (4/3)πr³, r = 7.", "s": ["(4/3) · 343π = 1372π/3. Ответ D."], "n": ["B — без 4."], "t": "Не забудьте 4/3."},
"7":{"i": "Пересекающиеся хорды: DS · SB = AS · SC.", "s": ["6 · 8 = 12 · CS → CS = 4. Ответ D."], "n": ["B — неверная пара отрезков."], "t": "Произведения частей хорд равны."},
"8":{"i": "X² = 19 − √(25 − 7(Y + 9)²) → √(…) = 19 − X².", "s": ["7(Y + 9)² = 25 − (19 − X²)² → Y = √(−((19 − X²)² − 25)/7) − 9. Ответ B."], "n": ["A — 17 вместо 19.", "C, D — выражают R и +9."], "t": "Действия в обратном порядке."},
"10":{"i": "S сектора = ½ · l · r.", "s": ["½ · 4π · 9 = 18π см². Ответ C."], "n": ["B — ошибка в r."], "t": "Через длину дуги."},
"11":{"i": "AB = BE и ∠B = 60° → △ABE равносторонний → AE = AB = AD.", "s": ["∠EAD = 114 − 60 = 54° → ∠ADE = (180 − 54)/2 = 63°.", "x = 180 − 63 = 117°. Ответ D."], "n": ["A, C — другой угол."], "t": "Ищите равнобедренные треугольники."},
"12":{"i": "l = √(5² + 12²) = 13.", "s": ["S = πr² + πrl = 25π + 65π = 90π. Ответ A."], "n": ["Остальные — ошибка в l."], "t": "Полная = основание + боковая."},
"13":{"i": "(2x − 2)² − (x + 8)² = 3x² − 24x − 60.", "s": ["3(x − 4)² − 48 − 60 = 3(x − 4)² − 108 → r = −108. Ответ D."], "n": ["C — забыли −48 → −96 неверно."], "t": "Выделите полный квадрат."},
"14":{"i": "1 м³ = 1000 л.", "s": ["12 697 : 1000 = 12,697 м³. Ответ B."], "n": ["A — ÷10 000."], "t": "л → м³: ÷1000."},
"15":{"i": "55 : 4 = 13,75; 10¹⁹ : 10⁵ = 10¹⁴.", "s": ["13,75·10¹⁴ = 1,375·10¹⁵. Ответ C."], "n": ["A, B, D — не стандартный вид."], "t": "Мантисса от 1 до 10."},
"16":{"i": "Через 2 года: 15 000 · 0,8² = 9600.", "s": ["Потеря 15 000 − 9600 = 5400. Ответ A."], "n": ["B — 20% · 2 простыми."], "t": "Спрашивают снижение, не остаток."},
"17":{"i": "AG — диагональ параллелепипеда.", "s": ["√(3² + 12² + 4²) = √169 = 13. Ответ B."], "n": ["Остальные — не по Пифагору."], "t": "√(a² + b² + c²)."},
"18":{"i": "Точки (0; 3) и (6; 0): k = −3/6 = −½.", "s": ["y = −½x + 3. Ответ A."], "n": ["Остальные — не тот b."], "t": "b — пересечение с осью y."},
"19":{"i": "x√y = const = 8 · 3 = 24.", "s": ["6√y = 24 → √y = 4 → y = 16. Ответ B."], "n": ["A — без корня."], "t": "Обратная пропорциональность корню."},
"20":{"i": "Новая площадь: 1,4 · 0,25 = 0,35 от старой.", "s": ["Уменьшение 65%. Ответ C."], "n": ["B — сама доля 35%."], "t": "Перемножьте множители."},
"21":{"i": "△PQR: tg θ = 3/4 → PQ = 4k, PR = 5k.", "s": ["△PSR: sin ∠R = PS/PR = 7/9 → PS = 35k/9.", "PQ : PS = 4 : 35/9 = 36 : 35. Ответ C."], "n": ["D — 4 : 7."], "t": "Общая сторона PR."},
"22":{"i": "8 + 4p + 2q + p² = 0; 1 + p + q + p² = −3,5 → q = −4,5 − p − p².", "s": ["Подставим: −p² + 2p − 1 = 0 → (p − 1)² = 0 → p = 1. Ответ A."], "n": ["Остальные — ошибка в системе."], "t": "Выразите q и подставьте."},
"23":{"i": "0,(063) = 63/999 = 7/111; 0,(64) = 64/99.", "s": ["Общий знаменатель 3663: 231 + 2368 = 2599 → 2599/3663. Ответ B."], "n": ["Остальные — неверный знаменатель."], "t": "НОК(111, 99) = 3663."},
"24":{"i": "PR = √2 (диагональ квадрата), XP = 4.", "s": ["XR = √(16 + 2) = 3√2; cos = PR/XR = 1/3. Ответ A."], "n": ["D — sin вместо cos."], "t": "Проекция XR — это PR."},
"26":{"i": "−6 < x − 5 < 6 → −1 < x < 11.", "s": ["Целые 0, 1, …, 10: сумма 55. Ответ C."], "n": ["D — включили 11."], "t": "Строгое неравенство."},
"28":{"i": "x₁² + x₂² = (x₁ + x₂)² − 2x₁x₂ = (3m + 4)² − 2(m − 1).", "s": ["9m² + 22m + 18 = 10 → 9m² + 22m + 8 = 0 → m = −2 или −4/9. Ответ B."], "n": ["C — знак."], "t": "Виета."},
"29":{"i": "0,25a + 0,4(120 − a) = 36.", "s": ["48 − 0,15a = 36 → a = 80 кг, второго 40 кг. Ответ C."], "n": ["B — 90 кг даст 28,75%."], "t": "Масса золота сохраняется."},
"30":{"i": "(xyz)² = 24 · 48 · 72 = 82 944 → xyz = 288.", "s": ["z = 288/24 = 12, y = 6, x = 4 → 22. Ответ B."], "n": ["C — ошибка в делении."], "t": "Перемножьте все три."}
