{
"1":{"i": "Возводим скобку в куб, затем умножаем.", "s": ["(3x^(−1/3))³ = 27x⁻¹.", "3x · 27/x = 81."], "n": ["F (81x²) — сложили степени неверно.", "A, D — перевёрнуто.", "B, E — неверно."], "t": "(x^(−1/3))³ = x⁻¹."},
"2":{"i": "aₙ = a₁ + (n − 1)d.", "s": ["8 + 15d = −37 → d = −3."], "n": ["A — знак.", "Остальные — неверно."], "t": "От 1-го до 16-го члена — 15 шагов."},
"3":{"i": "Подобные треугольники: BC ↔ FG даёт коэффициент.", "s": ["k = 24/16 = 1,5.", "EF = 18 = 1,5(x + 7) → x = 5.", "EG = 2y − 3 = 1,5 · 10 = 15 → y = 9.", "x + y = 14."], "n": ["Остальные — неверное соответствие сторон."], "t": "Сначала найдите пару известных соответствующих сторон."},
"4":{"i": "Полная поверхность цилиндра: 2πr² + 2πrh (по рисунку h = 8).", "s": ["2π · 9 = 18π.", "2π · 3 · 8 = 48π.", "66π."], "n": ["B, D — без оснований или неверно.", "A, E — неверно."], "t": "В тексте опечатка (h = 3) — по ответам высота 8, как на рисунке."},
"5":{"i": "Углы вокруг точки в сумме 360°.", "s": ["x/4 + x/2 + x/6 + x/3 = (3 + 6 + 2 + 4)x/12 = 15x/12.", "15x/12 = 360 → x = 288."], "n": ["A, C, D, E — неверное сложение дробей."], "t": "Общий знаменатель 12."},
"6":{"i": "Первая цифра — 8 вариантов (2–9), последняя — 10.", "s": ["P(первая = 3) = 1/8.", "P(последняя = 5) = 1/10.", "1/80."], "n": ["D — первая цифра из 9.", "E — из 10.", "A, B — неверно."], "t": "Средние цифры не влияют на долю."},
"7":{"i": "Прирост площади = π(100² − 60²).", "s": ["10 000 − 3600 = 6400.", "6400π ≈ 20 100 → ≈ 20 000."], "n": ["E — вся площадь 100².", "A — π · 40² … неверно.", "B, C — без π или неверно."], "t": "r² − r₁² ≠ (r − r₁)²."},
"8":{"i": "Остатки складываются.", "s": ["n + 29 → остаток 5 + 29 = 34 → 34 mod 9 = 7."], "n": ["Остальные — неверно."], "t": "Проверка: n = 5 → 34 ÷ 9 = 3 ост. 7."},
"9":{"i": "Переводим размеры в сантиметры, затем объём.", "s": ["r = 3 · 2,5 = 7,5 см; h = 6 · 2,5 = 15 см.", "V = ⅓π · 56,25 · 15 = 281,25π."], "n": ["A — в дюймах (18π) … неверно.", "C, D, E — ошибки перевода."], "t": "Переводите длины до вычисления объёма (иначе нужно ×2,5³)."},
"10":{"i": "Первые 6 простых: 2, 3, 5, 7, 11, 13.", "s": ["Сумма 41."], "n": ["C (34) — без 7 или с 1.", "Остальные — неверно."], "t": "1 — не простое."},
"11":{"i": "Упрощаем каждую скобку.", "s": ["2xy⁻²y⁴/(4xy) = 2xy²/(4xy) = y/2 → в степени −1: 2/y.", "xy/(2x³y) = 1/(2x²).", "2/y · 1/(2x²) = 1/(x²y)."], "n": ["Остальные — неверное сокращение."], "t": "Отрицательная степень — переворот."},
"12":{"i": "Площадь ∝ основание × высота.", "s": ["1,4 · 0,6 = 0,84 → уменьшение на 16%."], "n": ["C — «+40% и −40% компенсируются» — неверно."], "t": "Множители перемножаются."},
"13":{"i": "Средневзвешенное: 12 : 5 : 3 частей.", "s": ["12 · 30 + 5 · 20 + 3r = 20 · 25.", "360 + 100 + 3r = 500 → r = 40/3 = 13⅓%."], "n": ["A, B, D, E — неверно.", "F — результат достижим."], "t": "Всего 20 частей."},
"14":{"i": "Находим центр и радиус, затем применяем преобразования.", "s": ["Центр (5; 4), диаметр √(16 + 4) = √20 → r = √5.", "Сдвиг на −3: (2; 4); отражение в оси x: (2; −4).", "Увеличение в 4 раза: r = 4√5 → r² = 80.", "(x − 2)² + (y + 4)² = 80."], "n": ["B (320) — взяли диаметр как радиус.", "A, C — знак y-центра.", "F — r² = 20."], "t": "Увеличение умножает радиус, r² растёт в 16 раз. (Исходный ключ B — исправлено.)"},
"15":{"i": "Прямая через (2; 3) и (4; 1): y = −x + 5.", "s": ["Проверяем: (6; −1): −6 + 5 = −1 ✓."], "n": ["Остальные точки не на прямой."], "t": "Сумма координат на прямой x + y = 5."},
"16":{"i": "Выносим (−1)ⁿ.", "s": ["(−1)ⁿ − (−1)ⁿ⁻¹ + (−1)ⁿ⁺² = (−1)ⁿ(1 + 1 + 1) = 3(−1)ⁿ.", "Сумма 39 членов: −3 + 3 − 3 … — 19 пар дают 0, остаётся −3."], "n": ["D — чётное число членов.", "A, G — неверно."], "t": "(−1)ⁿ⁻¹ = −(−1)ⁿ."},
"17":{"i": "Строим последовательность.", "s": ["1, 3, 7, 15, 31.", "Сумма 57."], "n": ["A — пятый член.", "C — неверно."], "t": "Члены = 2ⁿ − 1."},
"18":{"i": "C/S = 2πr/(πr²).", "s": ["= 2/r."], "n": ["A — перевёрнуто.", "B, C, E — неверно."], "t": "Сокращаем π и r."},
"20":{"i": "Средняя линия трапеции = полусумма оснований.", "s": ["7x − 4 = (38 + 6x − 6)/2 → 14x − 8 = 6x + 32 → x = 5.", "UV = 6 · 5 − 6 = 24."], "n": ["A — это x.", "C, D, E — неверно."], "t": "Спрашивают UV, а не x."},
"21":{"i": "Считаем каждое значение.", "s": ["A: 2 · 8 + 8 = 24; B: 6 + 3 = 9 ✓ нечётное.", "C: 9 + 27 = 36; D: 12 + 32 = 44; E: 35 + 5 = 40."], "n": ["A, C, D, E — чётные."], "t": "(a/c)·b + a·c."},
"22":{"i": "Система по количеству и стоимости.", "s": ["t + c = 10; 8t + 12c = 104.", "80 + 4c = 104 → c = 6."], "n": ["Остальные — сумма ≠ 104."], "t": "Проверка: 4 · 8 + 6 · 12 = 104 ✓."},
"23":{"i": "EF = ED = 13 → EG — серединный перпендикуляр к FD.", "s": ["x + 5 = 3x − 9 → x = 7 → FG = 12.", "EG = √(169 − 144) = 5."], "n": ["A (12) — FG.", "C — x.", "D, E — неверно."], "t": "5-12-13."},
"24":{"i": "Пять углов x вокруг центра → x = 72°. y — угол при основании равнобедренного треугольника из двух радиусов.", "s": ["5x = 360 → x = 72.", "Радиусы, между которыми 2x = 144°, образуют равнобедренный треугольник.", "y = (180 − 144)/2 = 18.", "y : x = 18 : 72 = 1/4."], "n": ["Остальные — неверный угол при вершине."], "t": "Два радиуса → равнобедренный треугольник."},
"26":{"i": "Находим XZ, затем XY, затем WY.", "s": ["XZ = (3a + 15) − (7a + 5) = 10 − 4a.", "XY = 5 − 2a.", "WY = 7a + 5 + 5 − 2a = 5a + 10."], "n": ["Остальные — неверные вычитания."], "t": "WY = WX + XY."},
"27":{"i": "Площади равны: правый прямоугольник 4 · 2 = 8.", "s": ["R во II четверти: x < 0, y > 0.", "(−2; 4): 2 · 4 = 8 ✓."], "n": ["A, B — y < 0.", "D, E — x > 0."], "t": "Смотрите на четверть по рисунку."},
"29":{"i": "Подставляем в определение.", "s": ["2 · 5 + 2 + 5 = 17."], "n": ["A — сумма.", "B — произведение.", "D, E — неверно."], "t": "ab + a + b."},
"30":{"i": "Если 7 и 2 — корни, подстановка даёт 0 = k.", "s": ["3(7 − 7)(7 − 2) = 0 = k."], "n": ["Остальные — неверно."], "t": "Корень обращает левую часть в ноль."}
