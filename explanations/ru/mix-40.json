{
"1":{"i": "Собираем числа и степени отдельно.", "s": ["3m²n · 9mn³ = 27m³n⁴.", "(9mn²)⁻² = 1/(81m²n⁴).", "27m³n⁴/(81m²n⁴) = m/3."], "n": ["A — забыли знаменатель 81.", "E — n не сокращён.", "Остальные — ошибки в степенях."], "t": "(9mn²)⁻² = 1/(9mn²)²."},
"2":{"i": "Строки заканчиваются квадратами нечётных чисел: 1, 9, 25, 49, …; строка k содержит 8(k − 1) чисел.", "s": ["169 = 13² → конец 7-й строки, её длина 48 → 169 стоит на 48-м месте.", "8-я строка начинается со 170.", "48-е место: 169 + 48 = 217."], "n": ["Остальные — неверная длина строки."], "t": "Числа стоят по левому краю: 2 под 1, 10 под 2."},
"3":{"i": "Угол между направлениями на Актобе (270°) и Алматы (150°) — 120°.", "s": ["Треугольник равнобедренный: стороны 1300, угол между ними 120°.", "По теореме косинусов: d² = 2 · 1300² (1 + ½) = 3 · 1300² → d = 1300√3."], "n": ["B — половина.", "D — угол 60°."], "t": "Основание равнобедренного треугольника с углом 120° = боковая · √3."},
"4":{"i": "(x₁ − x₂)² = (x₁ + x₂)² − 4x₁x₂.", "s": ["16 = b² − 20 → b² = 36 → b = 6 (b &gt; 0)."], "n": ["B — отрицательное.", "Остальные — неверно."], "t": "Виета: сумма b, произведение 5."},
"5":{"i": "Обратные действия.", "s": ["T/(2π) — возводим в квадрат: T²/(4π²) = m/(qB²) · (k/(qE) − r).", "k/(qE) − r = T²qB²/(4π²m).", "r = k/(qE) − T²qB²/(4π²m)."], "n": ["A — знак.", "E, G — забыли квадрат.", "D — перевёрнуто."], "t": "Множитель m/(qB²) переносим, переворачивая его."},
"6":{"i": "Угол при A 45° задаёт направление AB; θ связан с наклоном прямой BM.", "s": ["B = (8; 8) относительно A, M = (11; 0).", "Прямая BM: сдвиг 3 вправо на 8 вниз.", "В прямоугольном треугольнике MHC угол θ = 90° − ∠HMC, tg ∠HMC = 8/3 → tg θ = 3/8."], "n": ["E — перевёрнуто.", "Остальные — неверно."], "t": "AB = 8√2 при 45° → катеты по 8."},
"7":{"i": "Перпендикуляр: наклон −1/k; тот же перехват с осью y.", "s": ["4x − 5y = 20: наклон 4/5, перехват −4.", "Перпендикуляр: y = −5x/4 − 4 → 5x + 4y = −16."], "n": ["Остальные — наклон или перехват не тот."], "t": "k₁ · k₂ = −1."},
"8":{"i": "Делим на масштаб.", "s": ["30 ÷ 2,5 = 12 см."], "n": ["E — бо́льшая сторона.", "Остальные — неверно."], "t": "Спрашивают меньшую сторону."},
"9":{"i": "Конечная дробь ⇔ знаменатель вида 2ᵃ · 5ᵇ.", "s": ["10 + x &gt; 10: ближайшее такое число — 16.", "x = 6."], "n": ["B: 12 = 4 · 3 ✗. A: 15 = 3 · 5 ✗.", "C (20) — подходит, но не наименьшее."], "t": "Множители 3, 7, 11 … дают периодическую дробь."},
"10":{"i": "Разность квадратов.", "s": ["4⁶ − 1 = (4³ − 1)(4³ + 1) = 63 · 65 = 3² · 7 · 5 · 13.", "Наибольший простой множитель — 13."], "n": ["Остальные — не делят 4095."], "t": "a² − b² = (a − b)(a + b)."},
"11":{"i": "Приводим к (x − 20)(y − 20) = 400.", "s": ["20(x + y) = xy → xy − 20x − 20y + 400 = 400.", "y максимален, когда x − 20 = 1 → y − 20 = 400 → y = 420."], "n": ["Остальные — не максимальные."], "t": "Трюк Саймона: добавить константу и разложить."},
"12":{"i": "Измерения a, b, c. В каждом положении 120 = площадь дна × глубина.", "s": ["ab = 60, ac = 40, bc = 24.", "(abc)² = 60 · 40 · 24 = 57 600 → abc = 240."], "n": ["Остальные — неверно."], "t": "Перемножьте три равенства."},
"13":{"i": "Выделяем целую часть: 2 · (7n + 12) = 7(2n + 3) + 3.", "s": ["Выражение целое только если 2n + 3 делит 3: 2n + 3 ∈ {±1, ±3}.", "n = −1: 5; n = −2: 2; n = 0: 4; n = −3: 3.", "Сумма 14."], "n": ["Остальные — пропущено одно из значений."], "t": "Проверяйте и отрицательные делители."},
"14":{"i": "0,1(7) = (17 − 1)/90 = 16/90.", "s": ["16/90 = 32/180."], "n": ["C — 0,1888…", "B, D — двузначный период."], "t": "Смешанная периодическая дробь: (число − непериодическая часть)/90."},
"15":{"i": "Прямоугольный треугольник ABC: AB = 5, AC = 10 → ∠BAC = 60°, E — середина AC на окружности.", "s": ["AE = AB = 5, ∠A = 60° → треугольник ABE равносторонний, ∠AEB = 60°.", "∠ABD = 50° и AB = AD → ∠BAD = 80°.", "∠BED = ½ · 80° = 40°.", "∠FEA = 60° − 40° = 20°."], "n": ["Остальные — неверно найден вписанный угол."], "t": "Вписанный угол — половина центрального."},
"16":{"i": "Раскладываем 54 000.", "s": ["54 000 = 54 · 1000 = 2 · 3³ · 2³ · 5³ = 2⁴ · 3³ · 5³.", "4 + 3 + 3 = 10."], "n": ["Остальные — неверное разложение."], "t": "1000 = 2³ · 5³."},
"17":{"i": "4k и 5k.", "s": ["(4k + 1)/(5k − 1) = 7/8 → 32k + 8 = 35k − 7 → k = 5.", "Всего 9k = 45."], "n": ["Остальные — не дают нужных отношений."], "t": "Общее количество не меняется."},
"18":{"i": "0,6a = b/3.", "s": ["a/b = 1/1,8 = 5/9.", "x − y = 5 − 9 = −4."], "n": ["E — знак.", "Остальные — неверно."], "t": "Отношение «первое к второму»."},
"19":{"i": "Всё к основанию 5.", "s": ["5^(6x − 6) / 5^(4x + 2) = 5^(4x).", "2x − 8 = 4x → x = −4."], "n": ["B — знак.", "Остальные — неверно."], "t": "125 = 5³, 25 = 5², 625 = 5⁴."},
"20":{"i": "Умножаем на 20.", "s": ["8(x − 3) − 5(x + 7) &lt; 60.", "3x − 59 &lt; 60 → x &lt; 119/3."], "n": ["A, F — знак.", "B, D — 49 вместо 59.", "E — неверный знаменатель."], "t": "Делим на положительное — знак сохраняется."},
"21":{"i": "Сумма векторов = итоговое смещение (6; −9).", "s": ["2p + q = 6; −5p − 3q = −9.", "q = 6 − 2p → −5p − 18 + 6p = −9 → p = 9, q = −12.", "p + q = −3."], "n": ["Остальные — неверное смещение."], "t": "Смещение = конец − начало."},
"22":{"i": "Опускаем высоту из C: угол 135° даёт треугольник 45-45-90.", "s": ["BC = 8√2 → высота 8, горизонталь 8.", "AB = 6 + 8 = 14.", "S = (6 + 14)/2 · 8 = 80."], "n": ["A, B — неверное основание.", "D, E — неверно."], "t": "135° = 90° + 45°."},
"23":{"i": "Поворот на 90° по часовой вокруг P: (dx; dy) → (dy; −dx).", "s": ["R относительно P: (5; 5) → (5; −5) → R' = (8; −1).", "Отражение в оси x: (8; 1)."], "n": ["C — только поворот относительно начала.", "Остальные — неверно."], "t": "Сначала переносим центр поворота в начало."},
"24":{"i": "Конус с тем же основанием и высотой = ⅓ цилиндра.", "s": ["V − V/3 = 2V/3."], "n": ["D — сам конус.", "Остальные — неверно."], "t": "Конус = ⅓ цилиндра."},
"25":{"i": "Подставляем обе точки.", "s": ["2q + 3p = 5; 4q + 7p = 5.", "Вычтем удвоенное первое: p = −5 → q = 10.", "q + p = 5."], "n": ["Остальные — ошибки знаков."], "t": "Система двух уравнений."},
"26":{"i": "Умножаем на 6.", "s": ["3(x − 2) − 4(3 − x) &lt; 6x − 24.", "7x − 18 &lt; 6x − 24 → x &lt; −6."], "n": ["C — знак.", "Остальные — ошибки раскрытия."], "t": "−⅔(3 − x) = −2 + ⅔x."},
"27":{"i": "Выделяем полный квадрат.", "s": ["x² − 12x + 35 = (x − 6)² − 1.", "p = 1, q = −6 → 3 − 6 = −3."], "n": ["Остальные — знак q."], "t": "(x + q)² с q = −6."},
"29":{"i": "X делит AC в отношении 1 : 5.", "s": ["AX = ⅙(m + n).", "XD = AD − AX = n − ⅙(m + n) = ⅙(5n − m)."], "n": ["Остальные — неверное деление диагонали."], "t": "AX/XC = 1/5 → AX = ⅙ AC."},
"30":{"i": "Находим обе константы.", "s": ["P = kQ²: 2 = 16k → k = ⅛.", "Q = c/R: c = 10.", "P = ⅛ · 100/R² = 25/(2R²)."], "n": ["Остальные — неверные константы."], "t": "Подставляйте Q через R."}
}
