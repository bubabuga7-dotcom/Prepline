{
"1":{"i": "Перебор по времени математики (все три курса в разное время).", "s": ["M = 8: S ∈ {10, 11}, E ≠ S → 2 · 2 = 4.", "M = 10: 2 + 1 = 3; M = 11: 2 + 1 = 3. Всего 10. Ответ E."], "n": ["B — без учёта совпадений."], "t": "Перебирайте аккуратно."},
"3":{"i": "sin 75° = cos 15°.", "s": ["sin 15° cos 15° = ½ sin 30° = 1/4. Ответ D."], "n": ["A — √3/4."], "t": "Двойной угол."},
"5":{"i": "К первой встрече вместе проплыли L, Боб — 20.", "s": ["Ко второй вместе 3L → Боб 60 = L + 18 → L = 42. Ответ D."], "n": ["C — 40."], "t": "Пропорция путей."},
"7":{"i": "Для прямоугольного треугольника S = AD · DB (отрезки касательных к гипотенузе).", "s": ["7 · 13 = 91. Ответ A."], "n": ["C — 100."], "t": "(x + r)(y + r) = 2S − … даёт S = xy."},
"9":{"i": "x² + (y − 1)² = 36/25 и x² + y² = 1.", "s": ["2 − 2y = 36/25 → y = 7/25 = 0,28. Ответ A."], "n": ["B — 0,25."], "t": "Вычтите уравнения."},
"10":{"i": "r = √2, центры на расстоянии 2 → центральный угол 90°.", "s": ["Сегмент π/2 − 1; линза 2(π/2 − 1) = π − 2. Ответ B."], "n": ["D — один сегмент."], "t": "Сектор − треугольник."},
"12":{"i": "a + b = 1/z, a + c = 1/y, b + c = 1/x.", "s": ["a = ½(1/z + 1/y − 1/x) = (xy + xz − yz)/(2xyz) → время 2xyz/(xz + xy − yz). Ответ D."], "n": ["A — производительность."], "t": "Время = 1/производительность."},
"13":{"i": "cos θ = (1 + 4 − 7)/(2 · 1 · 2) = −½.", "s": ["θ = 2π/3. Ответ C."], "n": ["E — 5π/6."], "t": "Теорема косинусов."},
"16":{"i": "Точка пересечения — центр гомотетии: d/(d + 26) = 8/18.", "s": ["18d = 8d + 208 → d = 20,8. Ответ C."], "n": ["A — 16,2."], "t": "Подобные прямоугольные треугольники."},
"20":{"i": "Сдвиг боковой стороны даёт треугольник со сторонами 16 − 10 = 6, 13, 6.", "s": ["6 + 6 < 13 — треугольник не существует → 0. Ответ A."], "n": ["B — не проверили."], "t": "Неравенство треугольника."},
"21":{"i": "a > 0, c > 0, оба корня > 0 → b < 0; f(1) < 0, f(−1) > 0.", "s": ["Положительны ac и a − b + c → 2. Ответ B."], "n": ["C — a + b + c = f(1) < 0."], "t": "a ± b + c = f(±1)."},
"23":{"i": "PO = 13, касательные длиной 12.", "s": ["Хорда касания XY = 2 · 5 · 12/13 = 120/13. Ответ A."], "n": ["E — без расчёта."], "t": "Высота к гипотенузе = ab/c."},
"25":{"i": "Отразим конец (1/6; 0) по DA, CD, BC: (13/6; 2).", "s": ["√((13/6 − 2/3)² + 2²) = √(2,25 + 4) = 2,5. Ответ B."], "n": ["C — 8/3."], "t": "Отражения выпрямляют путь."},
"27":{"i": "D > 0 (корни есть), оба отрицательны; 3142 = 2 · 1571 — целых корней нет.", "s": ["Σ 1/x = −1994/3142 > −1. Все A–D ложны. Ответ E."], "n": ["D — модуль меньше 1."], "t": "Виета."},
"101":{"i": "2 * 1 = 4 + 1 = 5.", "s": ["3 * 5 = 9 + 5 = 14. Ответ B."], "n": ["A — 9 + 3."], "t": "Сначала скобки."},
"102":{"i": "2¹⁶ − 16 = 16(2¹² − 1) = 16 · 4095.", "s": ["4095 = 3² · 5 · 7 · 13 → наибольший простой 13. Ответ C."], "n": ["D — 17 делит 2¹⁶ + 1."], "t": "2¹² − 1 = (2⁶ − 1)(2⁶ + 1)."},
"103":{"i": "x = 1: f(1 + f(1)) = f(5) = 4f(1).", "s": ["f(5) = 16. Ответ A."], "n": ["E — 4 + 20."], "t": "Подставьте x = 1."},
"104":{"i": "BN = BP, CM = CP.", "s": ["P = AB + BP + PC + AC = AN + AM = 14. Ответ C."], "n": ["A — без расчёта."], "t": "Отрезки касательных равны."},
"105":{"i": "A + D = (A + B) − (B + C) + (C + D).", "s": ["12 − 10 + 16 = 18. Ответ D."], "n": ["E — 20."], "t": "Комбинируйте суммы."},
"107":{"i": "1/r + 1/s = (r + s)/(rs).", "s": ["6/2 = 3. Ответ B."], "n": ["D — только r + s."], "t": "Виета."},
"108":{"i": "Удалённое число = 60n − 70(n − 1) = 70 − 10n > 0.", "s": ["n < 7 → n = 6. Ответ E."], "n": ["A — без условия положительности."], "t": "Число должно быть положительным."},
"109":{"i": "Магическая сумма 5 × 5: 5 · 26/2 = 65.", "s": ["A = 65 − (20 + 13 + 6 + 4) = 22. Ответ E."], "n": ["C — 17."], "t": "n(n² + 1)/2."},
"111":{"i": "(x + 1)(x² − x + 1) = x³ + 1 = 0.", "s": ["x³ = −1. Ответ A."], "n": ["C — знак."], "t": "Сумма кубов."},
"112":{"i": "Высота пересечения: 1/24 = 1/40 + 1/h.", "s": ["1/h = 1/60 → h = 60. Ответ D."], "n": ["E — 64."], "t": "«Гармоническое» правило."},
"113":{"i": "Варианты ≈ 1, поэтому имелось в виду √1,009 (опечатка).", "s": ["√(1 + 0,009) ≈ 1 + 0,0045 = 1,0045. Ответ B."], "n": ["A — 1,002."], "t": "√(1 + ε) ≈ 1 + ε/2."},
"118":{"i": "x679y делится на 72 = 8 · 9.", "s": ["На 8: 79y → 792 → y = 2. На 9: x + 24 ⋮ 9 → x = 3. Ответ E."], "n": ["A — 7."], "t": "Признаки делимости."},
"119":{"i": "Посчитаем вино после двух переливаний и приравняем.", "s": ["x − 4 = 4(x − 4)/x → x = 4. Ответ B."], "n": ["Остальные не дают равенства."], "t": "Доля вина в отобранной части."},
"120":{"i": "Продлим AB и DC до точки E: ∠E = 50° = ∠D → AE = AD; ∠BCE = 50° → BE = BC.", "s": ["AD = AB + BC → периметр 2AD + 5 = 35 → AD = 15. Ответ A."], "n": ["D — 20."], "t": "Равнобедренные треугольники."},
"122":{"i": "Последний элемент Sₙ = 1 + 2 + … + n.", "s": ["100 · 101/2 = 5050. Ответ D."], "n": ["C — 5000."], "t": "Треугольные числа."},
"124":{"i": "Чётный делитель: 2^a (a = 1…4), 3^b (0…2), 5^c (0…1).", "s": ["4 · 3 · 2 = 24. Ответ C."], "n": ["D — 30 − …"], "t": "Считайте показатели."},
"126":{"i": "Строка 2: 2 3 4 1. Строка 3: в столбце 4 — 2; a ∈ {1, 2} → a = 1, столбец 2 — 4.", "s": ["Строка 4: b = 1 (в столбце 2 уже 2, 3, 4). a + b = 2. Ответ A."], "n": ["Остальные — ошибка заполнения."], "t": "Латинский квадрат."},
"130":{"i": "Вычтем первое: z + t + w = 0, 2z + t = 2, y + 2z + 3t + 4w = 1.", "s": ["y = 3, x = −2, остальные свободны.", "В варианте A минус потерян (x = −2 определяется однозначно). Ответ A."], "n": ["D — x и y определены.", "E — решения есть."], "t": "Исключение переменных."}
}
