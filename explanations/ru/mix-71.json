{
"1":{"i": "2w(l + 3) = 3wl.", "s": ["2l + 6 = 3l → l = 6. Ответ D."], "n": ["C — подбор."], "t": "Ширина сокращается."},
"2":{"i": "3 # x = 3 + x + 3x = 3 + 4x.", "s": ["4x = 20 → x = 5. Ответ D."], "n": ["E — без +3."], "t": "Подставьте в определение."},
"3":{"i": "Центры образуют равносторонний треугольник со стороной 2.", "s": ["√3 − 3 · (π/6) = √3 − π/2. Ответ A."], "n": ["D — половина."], "t": "Треугольник минус три сектора по 60°."},
"5":{"i": "f(2) = f(1) + f(1) + 1 = 5.", "s": ["f(3) = f(2) + f(1) + 1 = 8. Ответ E."], "n": ["C — без +1."], "t": "Наращивайте по шагу."},
"6":{"i": "Цена (1 − p/100); нужно ×1/(1 − p/100).", "s": ["Рост = p/(100 − p) · 100% = 100p/(100 − p)%. Ответ E."], "n": ["A — p% мало."], "t": "Процент от новой базы."},
"7":{"i": "Под картой i: S − hᵢ; сумма подписей 5S.", "s": ["5S = 28 → S = 5,6. Ответ C."], "n": ["B — 28/6 неверно."], "t": "Каждое число входит 5 раз."},
"9":{"i": "(y − x)(y + x) = 187 = 11 · 17.", "s": ["y − x = 11, y + x = 17 → x = 3, y = 14 → xy = 42. Ответ D."], "n": ["Остальные не дают 187."], "t": "Разность квадратов."},
"15":{"i": "Общий знаменатель 3 · 5 · 7 · 11 · 13 = 15015; числитель 13 + 11 + 7 + 5 + 3 = 39.", "s": ["39/15015 = 1/385. Ответ D."], "n": ["A — не сократили."], "t": "Сократите на 39."},
"16":{"i": "Средняя линия PM делит CN пополам → CN = 8.", "s": ["O — центроид: CO = ⅔ · 8 = 16/3 → OQ = 16/3 − 4 = 4/3. Ответ B."], "n": ["E — 2."], "t": "Центроид делит медиану 2 : 1."},
"21":{"i": "Каждый сыграл G − 12 игр; сумма степеней = 2G.", "s": ["8(G − 12) = 2G → 6G = 96 → G = 16. Ответ D."], "n": ["C (14) — в старом ключе, неверно."], "t": "Каждая игра — два участника."},
"22":{"i": "A ≈ 4,51; B = 2 · 3/2 · 5/4 · 7/6 · 11/10 · 13/12 ≈ 5,21; C = H₁₆ ≈ 3,38.", "s": ["B > A > C. Ответ B."], "n": ["A — A и B перепутаны."], "t": "(1 − 1/p)⁻¹ = 1 + 1/p + 1/p² + …"},
"25":{"i": "Центр на прямой через O и (0; 2) → (0; k).", "s": ["36 + k² = (k − 2)² → k = −8 → (0; −8) — нет среди A–D. Ответ E."], "n": ["D — (0; −9)."], "t": "Касание → центры и точка на одной прямой."},
"27":{"i": "P — центр вписанной окружности, r = 2.", "s": ["S = r · p (полупериметр): 24 = 2p → p = 12, периметр 24. Ответ B."], "n": ["A — полупериметр."], "t": "S = r · p."}
