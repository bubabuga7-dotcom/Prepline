{
"1":{"i": "Делим уравнение на x.", "s": ["x² + 2 = 4x → x + 2/x = 4."], "n": ["Остальные — пытались найти x."], "t": "Не решайте уравнение — преобразуйте его."},
"2":{"i": "Складываем три суммы.", "s": ["2(T + J + A) = 72 → сумма 36.", "T = 12, J = 11, A = 13.", "144 + 121 + 169 = 434."], "n": ["Остальные — арифметика."], "t": "Каждое имя входит в две суммы."},
"3":{"i": "AC — диаметр → ∠B = 90°; радиус малой окружности OM ⊥ BC.", "s": ["OM ∥ AB, O — середина AC → OM — средняя линия: AB = 2r.", "r = 70 → R = 3r = 210."], "n": ["A — R = 90.", "Остальные — неверно."], "t": "Средняя линия = половина параллельной стороны."},
"4":{"i": "Площадь шестиугольника через радиус вписанной окружности: 2√3r².", "s": ["r² = 64√3.", "2√3 · 64√3 = 384."], "n": ["E — 576 = 9 · 64."], "t": "Шестиугольник = 6 треугольников с высотой r."},
"5":{"i": "Центр движется по квадрату, отступив на 1 от каждой стороны.", "s": ["Сторона 5 − 2 = 3 → путь 12."], "n": ["E — периметр большого квадрата.", "A, D — путь точки на окружности."], "t": "Внутри угла центр не поворачивает по дуге."},
"6":{"i": "Углы вокруг точки: 360°.", "s": ["Угол шестиугольника 120°, угол квадрата 90°, диагональ к центру делит угол квадрата: 45°.", "α = 360 − 120 − 90 − 45 = 105°."], "n": ["Остальные — неверный набор углов."], "t": "Отрезок от центра к вершине квадрата — половина диагонали, угол 45°."},
"7":{"i": "Вода = время × скорость.", "s": ["¾ · ¾ = 9/16 → экономия 7/16."], "n": ["E — оставшаяся доля.", "B, A — сложили или вычли неверно."], "t": "Сократить на ¼ — умножить на ¾."},
"8":{"i": "Прямая через центр круга делит круг пополам; чтобы делить и прямоугольник — она должна пройти через его центр.", "s": ["Центр прямоугольника (50; 25).", "Наклон: (30 − 25)/(75 − 50) = 1/5."], "n": ["Остальные — не через центр прямоугольника."], "t": "Любая прямая через центр симметричной фигуры делит её площадь пополам."},
"9":{"i": "Встреча: 550/(10 + 1) = 50 с.", "s": ["Ёж пробежал 50 м, разворачивается: ещё 50 с → финиш на 100 с.", "Кролик: 550/10 = 55 с.", "100 − 55 = 45."], "n": ["C (50) — время встречи.", "Остальные — неверно."], "t": "Встречное движение — скорости складываются."},
"10":{"i": "Возводим варианты в квадрат.", "s": ["(−3 + 2√5)² = 9 + 20 − 12√5 = 29 − 12√5 ✓."], "n": ["A: (2 − 4√5)² = 84 − 16√5.", "E: 89 + 24√5."], "t": "Удвоенное произведение 2ab√n = −12√5 → ab = −6."},
"12":{"i": "P ∝ 1/Q².", "s": ["1/1,2² ≈ 0,694 → снижение ≈ 31%."], "n": ["A — без квадрата."], "t": "Коэффициент 2/3 не влияет на проценты."},
"13":{"i": "2ˣ: положительна, возрастает, проходит (0; 1).", "s": ["Это B."], "n": ["D — 2^(−x).", "C — логарифм."], "t": "Показательная функция не пересекает ось x."},
"14":{"i": "Цилиндр + полушар.", "s": ["πr²l + ⅔πr³ = πr²/3 · (2r + 3l)."], "n": ["B — целый шар."], "t": "Вынесите πr²/3."},
"15":{"i": "По рисунку NL (длинная) переходит в PR, LM — в PQ: это поворот на 90° по часовой.", "s": ["L(a; a) → P(a; −a).", "Поворот на 90° (против часовой), затем на 180° = поворот на 90° по часовой."], "n": ["C (5, затем 4) = отражение в y = 0: длинная сторона ушла бы вниз."], "t": "Отслеживайте, куда идёт длинная сторона."},
"16":{"i": "Приводим к 10⁷.", "s": ["(4,6 + 1,4)/(4,6 − 0,4) = 6/4,2 = 10/7."], "n": ["Остальные — ошибки порядков."], "t": "2 · 10⁶ = 0,2 · 10⁷."},
"17":{"i": "В условии потерян вопрос; ключ — на сколько DVD дороже CD.", "s": ["Вычтем: 2d − 2c = 6,30 → d − c = 3,15."], "n": ["—"], "t": "Сложение даёт c + d = 10,45."},
"18":{"i": "(a − b)² = (a + b)² − 4ab.", "s": ["100 − 40 = 60 → 2√15."], "n": ["B — 100 − 80."], "t": "Не нужны сами числа."},
"19":{"i": "Нет пересечения ⇔ D &lt; 0.", "s": ["2 и 4: 1 − x² = 2 − x → x² − x + 1 = 0, D &lt; 0."], "n": ["Остальные пары дают D ≥ 0."], "t": "Приравняйте и посчитайте дискриминант."},
"20":{"i": "32 = 0,8 · цена.", "s": ["32/0,8 = 40."], "n": ["B — 32 · 1,2."], "t": "Скидка — от исходной цены."},
"21":{"i": "w + 3w = 20.", "s": ["w = 5, l = 15 → 75."], "n": ["Остальные — неверно."], "t": "Полупериметр = 20."},
"22":{"i": "AC горизонтальна.", "s": ["AC = 6, высота 6 − 2 = 4 → 12."], "n": ["Остальные — неверная высота."], "t": "Горизонтальное основание удобно."},
"23":{"i": "(a + b)² − (a − b)² = 4ab.", "s": ["4√70."], "n": ["D — 2ab."], "t": "Не раскрывайте полностью."},
"24":{"i": "+125% = × 2,25; −40% = × 0,6.", "s": ["1,35 = 27/20."], "n": ["Остальные — +125% как × 1,25."], "t": "Тот же тип, что mix-43."},
"25":{"i": "Вписанная трапеция с AB = BC = CD (равнобедренная) → дуги по 60°.", "s": ["∠BCD опирается на дугу BAD = 60° + 180° = 240°.", "∠BCD = 120°."], "n": ["Остальные — неверная дуга."], "t": "Вписанный угол = половина дуги."},
"26":{"i": "Приравниваем.", "s": ["2x² − 4x − 6 = 0 → x = 3, −1.", "Точки (3; −9), (−1; −1): наклон −2 → y = −2x − 3."], "n": ["Остальные не проходят через точки."], "t": "Проверьте обе точки."},
"27":{"i": "Угол между запад (270°) и 150° — 120°.", "s": ["Равнобедренный с боковой 1300 и углом 120° → основание 1300√3."], "n": ["B — половина."], "t": "Тот же тип, что mix-40."},
"28":{"i": "2ab = (a + b)² − (a² + b²).", "s": ["144 − 74 = 70 → 35."], "n": ["Остальные — неверно."], "t": "Числа 5 и 7."},
"29":{"i": "0,7(8) = (78 − 7)/90.", "s": ["71/90."], "n": ["C — 78/90 = 0,8(6).", "A — 0,(78)."], "t": "Смешанная периодическая дробь."},
"30":{"i": "Переносим 1.", "s": ["(x + 2)/(x − 3) − 1 = 5/(x − 3) &gt; 0 → x &gt; 3."], "n": ["E — подставили только числа."], "t": "Не умножайте на x − 3 без учёта знака."}
