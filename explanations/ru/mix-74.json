{
"1":{"i": "Среднее 10% ровно посередине между 5% и 15%.", "s": ["Поровну: 50 и 50 мл. Ответ C."], "n": ["A — даст 9%."], "t": "Правило креста."},
"2":{"i": "Угол 50° — внешний угол △BPC при P.", "s": ["Внешний = ∠PBC + ∠PCB = (B − a) + a = B → B = 50°. Ответ A."], "n": ["E — 180 − 50."], "t": "Внешний угол = сумма двух несмежных."},
"3":{"i": "28² − 72² = (28 − 72)(28 + 72) = −4400.", "s": ["−4400 + 995 = −3405. Ответ B."], "n": ["A — без 995 и т. п."], "t": "Разность квадратов."},
"4":{"i": "Туда 4 · 5, обратно 5 · 4.", "s": ["20 · 20 = 400. Ответ D."], "n": ["B — сложили."], "t": "Правило произведения."},
"5":{"i": "Кратные 7 от 203 до 994.", "s": ["(994 − 203)/7 + 1 = 114. Ответ B."], "n": ["A — без +1."], "t": "(последний − первый)/шаг + 1."},
"6":{"i": "1: 2sin²x + cos²x = 2 − cos²x ⇔ 2sin²x + 2cos²x = 2 — верно.", "s": ["Ответ B."], "n": ["2: tg + ctg ≥ 2 по модулю.", "4: sin²cos² ≤ ¼."], "t": "Проверьте тождество."},
"7":{"i": "3 ⇑ 2 = 1/7.", "s": ["(x − 1)/(x + 2) = 1/7 → 6x = 9 → x = 1,5. Ответ A."], "n": ["B — знак."], "t": "Подставьте в определение."},
"8":{"i": "Подставим a = b = c = 1: слева 1.", "s": ["1 + 1 − 1 + 3 · 1 · (1 − 1 − 1) + H = 1 → H = 3. Ответ C."], "n": ["D — 6."], "t": "Удобные значения."},
"9":{"i": "V = π · 1² · 1 ≈ 3,14.", "s": ["1 × 1 × 3 = 3 — ближе всего. Ответ C."], "n": ["E — 6."], "t": "π ≈ 3."},
"10":{"i": "n³ + n² + n + 1 = n(n² + n + 1) + 1.", "s": ["Остаток 1. Ответ E."], "n": ["A — n + 1."], "t": "Выделите делитель."},
"11":{"i": "PA = PB = AB = 2 → △APB равносторонний.", "s": ["PH = 2 · √3/2 = √3. Ответ C."], "n": ["B — сторона 1."], "t": "Радиусы равны стороне."},
"12":{"i": "12/72 = 1/6 окружности.", "s": ["360 : 6 = 60°. Ответ A."], "n": ["C — 120."], "t": "Доля дуги = доля угла."},
"13":{"i": "Каждая сторона квадрата может пересечь окружность дважды.", "s": ["4 · 2 = 8. Ответ D."], "n": ["A — касание."], "t": "Отрезок и окружность — до 2 точек."},
"14":{"i": "∠BAN = A/2, ∠BAH = 90° − B.", "s": ["x = A/2 − (90° − B) = (B − C)/2 по модулю. Ответ D."], "n": ["E — сумма."], "t": "A = 180 − B − C."},
"15":{"i": "Левшей 5, правшей 10.", "s": ["Правши выше 2 м: 8; левши: 60% · 5 = 3 → 11. Ответ E."], "n": ["A — только левши."], "t": "40% ниже → 60% выше."},
"16":{"i": "△DBC: 1 < BD < 11; △ABD: 5 < BD < 13.", "s": ["5 < BD < 11 → 7. Ответ B."], "n": ["C — 11 не строго."], "t": "Неравенство треугольника."},
"17":{"i": "Большая машина — в одно из 4 внутренних мест.", "s": ["4 · 5! = 480. Ответ C."], "n": ["E — без ограничения."], "t": "Сначала ограниченный объект."},
"18":{"i": "x, x + 2, …, x + 14.", "s": ["Среднее (x + x + 14)/2 = x + 7. Ответ C."], "n": ["D — x + 8."], "t": "Среднее крайних."},
"19":{"i": "A, B, C, E опровергаются простыми примерами (x = 0,5; 0,2 и т. п.).", "s": ["D при 0 ≤ x < 1 даёт равенство {x³} = {x}³; задумано как верное (хотя при x = 2,95 нарушается — неточность в задании). Ответ D."], "n": ["E — x = 0,2: 0 > 0,4 неверно."], "t": "Ищите контрпримеры."},
"20":{"i": "△ABC ~ △EBD, k = 5.", "s": ["Площадь × 25: 125a² + 250. Ответ D."], "n": ["B — ×5."], "t": "Площади ∝ k²."},
"21":{"i": "График [x] — горизонтальные ступеньки.", "s": ["«Ступеньки». Ответ A."], "n": ["E — зигзаг непрерывен."], "t": "Кусочно-постоянная функция."},
"23":{"i": "Центры (r; r) и (s − r; s − r), расстояние 2r.", "s": ["(s − 2r)√2 = 2r → s = r(2 + √2); диагональ s√2 = 2r(1 + √2). Ответ C."], "n": ["B — это сторона."], "t": "Центры на диагонали."},
"24":{"i": "3k · 2k · 2k = 12k³ = V.", "s": ["h = 2k = ∛(8V/12) = ∛(2V/3). Ответ D."], "n": ["B — ∛(V/3)."], "t": "Выразите k."},
"25":{"i": "Сегмент над BH: πr²/4 − r²/2; область HAC: 2r² − r²/2 − πr²/4.", "s": ["Сумма = r² = 54 → r = 3√6. Ответ E."], "n": ["C — √6."], "t": "π-части сокращаются."},
"27":{"i": "2 sin x cos x = sin 2x, далее удваиваем.", "s": ["sin 2x cos 2x cos 4x cos 8x = sin 16x/8. Ответ E."], "n": ["A — cos."], "t": "Последовательно применяйте sin 2α."},
"28":{"i": "2 + 2cos²x − 1 = 3cos x → 2c² − 3c + 1 = 0.", "s": ["c = 1 или ½ → 0, π/3, 5π/3, 2π. Ответ A."], "n": ["C — c = −½."], "t": "cos 2x = 2cos²x − 1."},
"29":{"i": "Две амёбы — это одна через минуту.", "s": ["60 − 1 = 59. Ответ B."], "n": ["A — половина."], "t": "Удвоение каждую минуту."},
"30":{"i": "Дождь ⇒ облачно; сегодня не облачно.", "s": ["Контрапозиция: сегодня не дождь. Ответ C."], "n": ["B — противоречие."], "t": "Modus tollens."}
}
