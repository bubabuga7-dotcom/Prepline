"1":{"i":"Наклон (3 − 1)/(0 − 2) = −1, пересечение с осью y — 3.","s":["Точная прямая y = −x + 3 — такого варианта нет (ошибка в условии).","В ключе — B (y = −x + 2): тот же наклон −1. Ответ B."],"n":["A, C — наклон +1.","E — наклон −3."],"t":"Проверяйте обе точки подстановкой."},
"2":{"i":"Квадрат a² + 4 полукруга диаметром a.","s":["4 · ½ · π(a/2)² = πa²/2.","a² + ½πa². Ответ C."],"n":["A — посчитали 2 полукруга."],"t":"Радиус = a/2."},
"3":{"i":"x(3x² − 10x − 8).","s":["3x² − 10x − 8 = (3x + 2)(x − 4). Ответ D."],"n":["A — неверные знаки."],"t":"Проверьте раскрытием."},
"4":{"i":"Брату 5/8 · 5000 = 3125.","s":["Другу 1/5 · 3125 = 625. Ответ C."],"n":["E — доля сестры/1,5."],"t":"Две пропорции по очереди."},
"5":{"i":"НОК(40, 42) = 840 с = 14 мин.","s":["10:14. Ответ A."],"n":["Остальные — не НОК."],"t":"40 = 2³·5, 42 = 2·3·7."},
"6":{"i":"Большой квадрат x + y, малый x.","s":["x² = (x + y)²/3 → x√3 = x + y → y = x(√3 − 1).","x/y = 1/(√3 − 1) = (√3 + 1)/2. Ответ A."],"n":["B — отношение сторон квадратов."],"t":"Отношение площадей = квадрат отношения сторон."},
"7":{"i":"(y − 1)² = (x + 3)/x = 1 + 3/x.","s":["3/x = (y − 1)² − 1 = y(y − 2).","x = 3 / (y(y − 2)). Ответ A."],"n":["B — забыли вычесть 1."],"t":"Изолируйте корень."},
"8":{"i":"f(x) = x² − 4, g(x) = (x + 1)².","s":["x → x + 1 — влево на 1; −4 → 0 — вверх на 4. Ответ B."],"n":["E — вправо."],"t":"x + 1 — влево."},
"9":{"i":"(x + 7)(x − 2) ≤ 0.","s":["−7 ≤ x ≤ 2. Ответ B."],"n":["C — без концов.","A — неверные корни."],"t":"«≤» — концы включены."},
"10":{"i":"A(1,1), B(2,3), C(4,2).","s":["Поворот на 90° по часовой: (x, y) → (y, −x): (1,−1), (3,−2), (2,−4).","Отражение в оси x: (1,1), (3,2), (2,4). Ответ C."],"n":["D — без отражения."],"t":"По очереди, точка за точкой."},
"11":{"i":"Цилиндр π · 25 · 10 = 250π; шар (4/3)π · 125 = 500π/3.","s":["250π : (500π/3) = 3/2. Ответ D."],"n":["E — обратное отношение."],"t":"Шар — 2/3 описанного цилиндра."},
"12":{"i":"2 части = 16 → 1 часть = 8.","s":["Сумма 10 частей = 80. Ответ C."],"n":["A — 8 частей."],"t":"Сумма частей 2 + 3 + 5."},
"13":{"i":"x + 3x = 90°.","s":["x = 22,5 → 3x = 67,5. Ответ E."],"n":["B — сам x."],"t":"Острые углы прямоугольного треугольника."},
"14":{"i":"8◆2 = 4, 4◆9 = 6.","s":["4◆6 = √24 = 2√6. Ответ C."],"n":["B — 4√3 = √48."],"t":"Сначала скобки."},
"15":{"i":"Касается оси x → радиус = |y центра| = 4.","s":["Длина 2π · 4 = 8π. Ответ C."],"n":["E — площадь."],"t":"Расстояние до оси."},
"16":{"i":"30 + 35 + 5 = 70% → остальные 30% = 7,2 ч.","s":["7,2 − 5 = 2,2 ч = 132 мин. Ответ D."],"n":["A — в часах."],"t":"Переведите в минуты."},
"17":{"i":"12 · 8 = 96 машино-дней.","s":["За 6 дней: 96 : 6 = 16 → ещё 4. Ответ C."],"n":["E — пропорция прямая."],"t":"Обратная пропорция."},
"18":{"i":"Медленная s ч, быстрая s − 4.","s":["9/s + 2/(s − 4) = 1.","s = 12: 0,75 + 0,25 = 1 → 8 и 12 ч. Ответ B."],"n":["Остальные не дают 1."],"t":"Подставьте варианты."},
"19":{"i":"(x + y)² = (x − y)² + 4xy.","s":["144 + 432 = 576 → ±24. Ответ B."],"n":["A — без 4xy."],"t":"Тождество квадратов."},
"20":{"i":"Сумма корней 2, произведение 1 − 3 = −2.","s":["x² − 2x − 2 = 0. Ответ A."],"n":["D — произведение +2."],"t":"Теорема Виета."},
"21":{"i":"½ · h(h + 3) = 2.","s":["h² + 3h − 4 = 0 → h = 1, основание 4. Ответ B."],"n":["A — площадь 5."],"t":"Площадь треугольника — половина."},
"22":{"i":"x = −3y + 12 → y = (12 − x)/3.","s":["y = −x/3 + 4. Ответ C."],"n":["B — 12 не поделили."],"t":"Поменяйте x и y."},
"23":{"i":"∠PQM = 180 − 80 − 30 = 70°.","s":["PQ = PR → ∠PRQ = 70° → ∠QPR = 40°.","∠RPM = 40 − 30 = 10°. Ответ D."],"n":["A — 80 − 60."],"t":"Равнобедренный треугольник."},
"24":{"i":"(1/4)^{1/2} = 1/2 → показатель −1/2.","s":["(1/4)^{−1/2} = 4^{1/2} = 2. Ответ A."],"n":["B — забыли минус."],"t":"Отрицательная степень — переворот."},
"25":{"i":"Сгиб — осевая симметрия: расстояния сохраняются.","s":["От правого верхнего угла: (√2 − p)² + 1 = 2 → p = √2 − 1.","От точки d: p² + d² = (1 − d)² → d = (1 − p²)/2 = √2 − 1. Ответ B."],"n":["A — подбор."],"t":"Отражённая точка на том же расстоянии."},
"26":{"i":"x/40 → нужно x/8 = 5 · x/40.","s":["Умножить на 5. Ответ C."],"n":["E — наоборот."],"t":"40 : 8 = 5."},
"27":{"i":"Нечётное⁴ — нечётное.","s":["Нечётное + чётное = нечётное: 3⁴ + 2 = 83. Ответ B."],"n":["Остальные: нечётное + нечётное = чётное."],"t":"Чётность."},
"28":{"i":"Радиус малого — половина большого → площадь 1/4.","s":["Снаружи 1 − 1/4 = 3/4. Ответ B."],"n":["A — неверная доля."],"t":"Площадь ∝ r²."},
"29":{"i":"200 : 5 = 40 кг сверх нормы → норма 30 кг.","s":["По: 45 − 30 = 15 кг · 5 = 75 $. Ответ D."],"n":["B — 5 кг перевеса."],"t":"Сначала норма."},
"30":{"i":"n + (n + 2) + … + (n + 10) = 6n + 30 = 60.","s":["n = 5. Ответ E."],"n":["A — сумма 36."],"t":"Средние двух центральных = 10."}
