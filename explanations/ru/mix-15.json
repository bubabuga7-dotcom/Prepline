{
"1":{"i": "Замечаем, что f(x) = (x + 1)².", "s": ["g(30) = 60 − 5 = 55.", "f(55) = 56² = 3136."], "n": ["A–D — арифметические ошибки при возведении в квадрат."], "t": "Узнавайте полный квадрат — считать проще."},
"2":{"i": "Касательная перпендикулярна радиусу; OP — биссектриса угла APB.", "s": ["∠OAP = 90°.", "∠APO = 40°/2 = 20°.", "∠AOP = 180° − 90° − 20° = 70°."], "n": ["E (140°) — это ∠AOB.", "B (50°) — 90 − 40.", "A, D — неверно."], "t": "Две касательные из одной точки симметричны относительно OP."},
"3":{"i": "Приводим к основанию 3 и приравниваем показатели.", "s": ["27^(x²) = 3^(3x²).", "2x + 1 = 3x² → 3x² − 2x − 1 = 0.", "(3x + 1)(x − 1) = 0 → x = 1 (положительный)."], "n": ["A, C, D, E — не удовлетворяют уравнению."], "t": "Проверка: 3³ = 27¹ ✓."},
"5":{"i": "DE ∥ BC → треугольники ADE и ABC подобны.", "s": ["AB = 3 + 2 = 5 → k = 3/5.", "DE = 3/5 · 15 = 9 см."], "n": ["A (6) — взяли 2/5.", "C, D, E — неверный коэффициент."], "t": "Отношение берём к целой стороне AB, а не к DB."},
"6":{"i": "Через суммы зарплат.", "s": ["10 · 50 000 + N · A = 54 000(10 + N).", "N · A = 40 000 + 54 000N.", "A = 54 000 + 40 000/N."], "n": ["B — потерян член 54 000.", "C, D — неверное деление на N."], "t": "Проверка смыслом: новые сотрудники должны получать больше 54 000, чтобы поднять среднее."},
"7":{"i": "Теорема Безу: множитель (ax − b) ⇔ корень x = b/a.", "s": ["Для 3x − 1 проверяем x = 1/3.", "3/27 + 2/9 − 19/3 + 6 = (1 + 2 − 57 + 54)/9 = 0 ✓."], "n": ["A: x = 2/3 → ≠ 0.", "B: x = −½ → ≠ 0.", "C: x = 3 → 81 + 18 − 57 + 6 ≠ 0.", "D: x = −2 → −24 + 8 + 38 + 6 ≠ 0."], "t": "Подставляйте корень множителя, а не сам множитель."},
"8":{"i": "Заштрихована половина сегмента, отсекаемого хордой AB (OC — ось симметрии).", "s": ["Сектор: (30/360) · π · 144 = 12π.", "Треугольник AOB: ½ · 12 · 12 · sin 30° = 36.", "Сегмент: 12π − 36 → половина: 6π − 18."], "n": ["B — весь сегмент... с ошибкой.", "C, D, E — неверные площади."], "t": "Сегмент = сектор − треугольник."},
"9":{"i": "Средняя скорость = весь путь / всё время.", "s": ["Путь 2D, средняя 3 → время 2D/3.", "Туда D/4, обратно D/4 + D/(2w).", "D/2 + D/(2w) = 2D/3 → 1/(2w) = 1/6 → w = 3."], "n": ["A, B, C, E — не дают среднюю 3."], "t": "D сокращается — его можно взять любым (например, 12)."},
"10":{"i": "Разность квадратов / полный квадрат.", "s": ["(x − 2)(x + 2)/(x + 2)² = (x − 2)/(x + 2)."], "n": ["B — перевёрнуто.", "C, D, E — неверное сокращение."], "t": "Сокращаем только множители."},
"11":{"i": "Объём конуса — треть цилиндра с тем же основанием и высотой.", "s": ["Конус: ⅓πr²h; цилиндр: πr²h → 1 : 3."], "n": ["E — перевёрнуто.", "A, B, D — неверно."], "t": "Пирамида и конус — ⅓ соответствующей призмы/цилиндра."},
"12":{"i": "Упрощаем каждый корень.", "s": ["4√27 = 12√3; 2√75 = 10√3 → 22√3.", "6√32 = 24√2; 3√50 = 15√2 → 39√2.", "(22√3 − 39√2)/3 = 22√3/3 − 13√2."], "n": ["C — 39/3 ≠ 22.", "A, B, D — неверные коэффициенты."], "t": "Группируйте одинаковые корни."},
"13":{"i": "НОД всегда делит НОК.", "s": ["1200 = 2⁴ · 3 · 5².", "45 = 3² · 5 — содержит 3², а в 1200 только 3¹ → 45 не делит 1200."], "n": ["A (20), B (25), D (60) — делят 1200."], "t": "Проверка делимости: 1200 ÷ 45 не целое."},
"14":{"i": "Наклон перпендикуляра = −1/k.", "s": ["k = −2 → перпендикуляр ½.", "y + 1 = ½(x − 2) → y = 0,5x − 2."], "n": ["C — неверный перехват.", "A, B, E — неверный наклон."], "t": "Проверка точки (2; −1): 1 − 2 = −1 ✓."},
"15":{"i": "Делим на x и дважды возводим в квадрат.", "s": ["x + 1/x = √11.", "x² + 1/x² = 11 − 2 = 9.", "x⁴ + 1/x⁴ = 81 − 2 = 79."], "n": ["B (81) — забыли −2.", "C, D, E — неверно."], "t": "Каждый раз вычитаем 2."},
"16":{"i": "Второе неравенство не имеет решений.", "s": ["x² − 4x + 6 = (x − 2)² + 2 ≥ 2 > 0 — всегда положительно.", "Значит, < 0 не бывает никогда → общих решений нет."], "n": ["B — решение только первого неравенства.", "A, C, D — неверно."], "t": "Если D < 0 и ветви вверх — выражение всегда положительно."},
"17":{"i": "Теорема косинусов.", "s": ["QR² = 100 + 36 − 2 · 10 · 6 · cos 60° = 136 − 60 = 76.", "QR = √76 = 2√19."], "n": ["B — без −60.", "D (14) — сложили стороны.", "C, E — неверно."], "t": "cos 60° = ½."},
"18":{"i": "Время прохождения буя даёт длину конвоя.", "s": ["54 км/ч = 15 м/с.", "Длина конвоя: 15 · 20 = 300 м.", "За 80 с: 1200 м = пролив + конвой → пролив 900 м."], "n": ["C (1200) — забыли длину конвоя.", "A, D — неверно."], "t": "Чтобы полностью пройти пролив, нужно проехать пролив + свою длину."},
"19":{"i": "P(3) = 0.", "s": ["27 + 9k − 30 + 6 = 3 + 9k = 0 → k = −1/3."], "n": ["A, B, D, E — P(3) ≠ 0."], "t": "Теорема Безу."},
"20":{"i": "Радиус — расстояние от центра до начала координат.", "s": ["r² = 1² + 4² = 17.", "(x + 1)² + (y − 4)² = 17."], "n": ["A — r² = 5.", "B — знаки центра.", "D — центр в начале.", "E — неверно."], "t": "(x − a)² → центр a."},
"21":{"i": "$150 — это 80% исходной цены.", "s": ["150 ÷ 0,8 = 187,50."], "n": ["C (180) — добавили 20% к 150.", "A, B, E — неверно."], "t": "Нельзя просто прибавить 20% к новой цене."},
"22":{"i": "y ∝ 1/√x.", "s": ["x × 0,64 → √x × 0,8.", "y × 1/0,8 = 1,25 → рост на 25%."], "n": ["B, D — уменьшение (а связь обратная).", "C — 1/0,8 ≠ 1,2."], "t": "Уменьшение на 36% = × 0,64 = 0,8²."},
"23":{"i": "Амплитуда A — максимум; нули cos x при 90° и 270°.", "s": ["A = 4.", "cos x = 0 при 90° и 270° — совпадает → B = 1."], "n": ["B, C, D — нули были бы в других точках.", "E — амплитуда 2."], "t": "Период cos(Bx) = 360°/B."},
"24":{"i": "Делим вторую сумму на первую.", "s": ["a/(1 − r) = 30; a²/(1 − r²) = 450.", "Делим: a/(1 + r) = 15.", "(1 + r)/(1 − r) = 30/15 = 2 → r = 1/3."], "n": ["A, C, D, E — не удовлетворяют обоим условиям."], "t": "1 − r² = (1 − r)(1 + r)."},
"26":{"i": "Приравниваем y.", "s": ["x² + 2x − 3 = x − 1 → x² + x − 2 = 0.", "x = 1 или −2 → (1; 0) и (−2; −3)."], "n": ["Другие пары не лежат на прямой y = x − 1."], "t": "Проверяйте на прямой — быстро."},
"27":{"i": "Проверяем каждое утверждение.", "s": ["I: четыре равные стороны — определение ромба ✓.", "II: у любого ромба диагонали перпендикулярны → «ромб только если перпендикулярны» ✓.", "III: углы 90° — это прямоугольник; ромб не обязан ✗."], "n": ["A — пропускает II.", "C, D — включают ложное III."], "t": "«P only if Q» = «P ⇒ Q»."},
"28":{"i": "Перемножаем мантиссы и степени.", "s": ["4,5 · 10⁻⁴ · 3 · 10⁷ = 13,5 · 10³ = 1,35 · 10⁴."], "n": ["C, E — не стандартная форма.", "A, D — неверная степень."], "t": "Стандартная форма: 1 ≤ a < 10."},
"29":{"i": "Третья четверть: sin и cos отрицательны.", "s": ["tg = 5/12 → треугольник 5-12-13.", "cos = −12/13."], "n": ["A — знак.", "C, D — это sin."], "t": "tg > 0 в I и III четвертях."},
"30":{"i": "m < 0, n > 0 → mn < 0. Ищем крайние значения.", "s": ["Самое отрицательное: −5 · 8 = −40.", "Ближе к нулю: −2 · 3 = −6.", "−40 < mn < −6."], "n": ["A — пустой промежуток.", "C, D — неверные концы."], "t": "Перебирайте произведения концов промежутков."}
}
