{
"1":{"i": "Объёмы воды стали равны → в каждом половина исходного объёма большого сосуда L.", "s": ["Большой: p = (L/2)/L = 0,5.", "Малый: q = (L/2)/S, а S &lt; L → q &gt; 0,5."], "n": ["B, A — q ≠ 0,5, т.к. малый сосуд меньше.", "D, E — p ровно 0,5."], "t": "Половина большого объёма заполняет малый сосуд больше чем наполовину."},
"2":{"i": "Через суммы времён.", "s": ["20 · 54 + PT = 56(20 + P).", "1080 + PT = 1120 + 56P → P(T − 56) = 40.", "P = 40/(T − 56)."], "n": ["A — вычли 54 вместо 56.", "B, D — 1080 вместо 40.", "E — неверно."], "t": "Новое среднее (56) — в знаменателе."},
"3":{"i": "2πr² + 2πrh = πr²h.", "s": ["Делим на πr: 2r + 2h = rh.", "h = 2r/(r − 2)."], "n": ["B — знак.", "C, D, E — неверно."], "t": "Полная поверхность — с двумя основаниями."},
"4":{"i": "Каждый новый квадрат — 5/9 площади предыдущего.", "s": ["(1/3)² + (2/3)² = 5/9.", "Четвёртый — три шага: (5/9)³ = 125/729."], "n": ["D — два шага.", "B, E — коэффициент для стороны.", "A — неверно."], "t": "Первый квадрат — исходный."},
"5":{"i": "BC ∥ DE → треугольники ABC и ADE подобны.", "s": ["AD = AB + BD = 4 + x − 4 = x.", "x/(x + 3) = 4/x → x² = 4x + 12 → x = 6.", "DE = 9."], "n": ["A, B — неверное подобие.", "D, E — ошибка в AD."], "t": "Соответствие: AB ↔ AD, BC ↔ DE."},
"6":{"i": "Вернуться можно, только если второй ход — в противоположную сторону на то же расстояние.", "s": ["Первый ход — любой.", "Второе направление: 1/4; расстояние: 1/4.", "1/16."], "n": ["A, B — лишние множители для первого хода.", "D, E — неверно."], "t": "Первый ход не ограничен."},
"7":{"i": "Возводим скобку в куб, затем умножаем.", "s": ["(3x^(−1/3))³ = 27x⁻¹.", "3x · 27/x = 81."], "n": ["Остальные — неверные степени."], "t": "(x^(−1/3))³ = x⁻¹."},
"8":{"i": "Минутная 6°/мин, часовая 30°/ч + 0,5°/мин.", "s": ["Минутная: 45 · 6 = 270°.", "Часовая: 9 · 30 + 45 · 0,5 = 292,5°.", "Разница 22,5°."], "n": ["A — забыли сдвиг часовой стрелки.", "Остальные — неверно."], "t": "Часовая стрелка движется между цифрами."},
"9":{"i": "Для целых y: y² ≥ y.", "s": ["x &gt; y² ≥ y → x &gt; y."], "n": ["A, B, C, E — есть контрпримеры."], "t": "Проверяйте и отрицательные числа."},
"10":{"i": "Не пересекаются ⇔ уравнение пересечения без корней.", "s": ["3 и 4: 1 − x² = x + 6 → x² + x + 5 = 0, D &lt; 0."], "n": ["Все другие пары дают уравнения с корнями."], "t": "Проверяйте дискриминант."},
"11":{"i": "Каждый следующий треугольник подобен предыдущему: его катет — гипотенуза предыдущего.", "s": ["Малый: катеты 1 и 3, гипотенуза √10, площадь 1,5.", "Коэффициент k = √10/3 → площадь × 10/9.", "Два шага: 1,5 · 100/81 = 50/27."], "n": ["A, E — неверный коэффициент.", "C, D — неверно."], "t": "Площадь растёт в k² раз."},
"13":{"i": "Площади ∝ d²: 1, 4, 9, 16 (в единицах πd²/4).", "s": ["Заштриховано: (16 − 9) + (4 − 1) = 10 единиц.", "10 · πd²/4 = (5/2)πd²."], "n": ["D — без /4.", "B, C, E — неверно."], "t": "Площадь через диаметр: πD²/4."},
"14":{"i": "По частям со степенями 10.", "s": ["(5 · 10⁻³)² = 2,5 · 10⁻⁵.", "2 · 10⁵/(2,5 · 10⁻⁵) = 8 · 10⁹ → ∛ = 2000.", "√3600 = 60 → 1940."], "n": ["C — ошибка в степени.", "A, B, D — неверно."], "t": "∛(8 · 10⁹) = 2 · 10³."},
"15":{"i": "Опускаем высоту h из C и выражаем отрезки на AB через h.", "s": ["AH = 6h, HB = 1,5h → AB = 7,5h, AM = 3,75h.", "MH = 2,25h → tg θ = h/2,25h = 4/9."], "n": ["Остальные — неверное положение M."], "t": "Выражайте всё через одну высоту."},
"17":{"i": "Металл ∝ d, дерево ∝ d².", "s": ["2ad + 4bd² = 3(ad + bd²) → ad = bd²: затраты на металл и дерево равны.", "Металл втрое дороже за единицу → его по площади втрое меньше.", "Доля металла: 1/(1 + 3) = 25%."], "n": ["C (50%) — доля затрат, а не площади.", "Остальные — неверно."], "t": "Спрашивают долю знака (площади), а не стоимости."},
"18":{"i": "Приводим к одной степени 10⁷.", "s": ["x + 7y = 4,6 + 1,4 = 6 (·10⁷).", "x − 2y = 4,6 − 0,4 = 4,2 (·10⁷).", "6/4,2 = 10/7."], "n": ["Остальные — ошибки с порядками."], "t": "2 · 10⁶ = 0,2 · 10⁷."},
"19":{"i": "1 − 16x² = (1 − 4x)(1 + 4x) = −(4x − 1)(1 + 4x).", "s": ["Дробь: −x²(1 + 4x)/(2x³) = −(1 + 4x)/(2x) = −2 − 1/(2x).", "4 − (−2 − 1/(2x)) = 6 + 1/(2x)."], "n": ["E — знак у 1/(2x).", "A–D — потерян минус при сокращении."], "t": "1 − 4x = −(4x − 1)."},
"20":{"i": "Поворот: (x; y) → (y; −x); отражение в y = x: → (−x; y).", "s": ["Итог — отражение в оси y.", "Повторное отражение в оси y возвращает назад."], "n": ["A — отражение в оси x даёт (x; −y).", "D, E — повороты не отменяют отражение."], "t": "Отражение — само себе обратное."},
"21":{"i": "Исключаем z.", "s": ["z ∝ x^(1/2); y ∝ z⁻³ ∝ x^(−3/2).", "y² ∝ x⁻³ → куб x обратно пропорционален квадрату y."], "n": ["A, C — прямая пропорциональность.", "B — степени перепутаны."], "t": "x растёт, y падает → связь обратная."},
"22":{"i": "Стороны кубов 2, √2, 1.", "s": ["Грани: 6 · (4 + 2 + 1) = 42.", "Спрятано: 2 · 2 + 2 · 1 = 6.", "36 см²."], "n": ["Остальные — неверный учёт спрятанных граней."], "t": "Каждое соединение прячет площадь меньшей грани дважды."},
"24":{"i": "Раскладываем и сокращаем.", "s": ["x(x − 4)/((x − 4)(x + 4)) = x/(x + 4)."], "n": ["C — сократили не тот множитель.", "A, D, E — «сокращение» слагаемых."], "t": "Сокращать можно только множители."},
"25":{"i": "Приводим к основанию 2.", "s": ["2^(2p) · 2^(3q) = 2^(2p + 3q) → n = 2p + 3q."], "n": ["C — 8 = 2³, а не 2⁴.", "Остальные — неверно."], "t": "При умножении показатели складываются."},
"26":{"i": "Треугольник станция–библиотека–театр равнобедренный.", "s": ["Из библиотеки на станцию: 180 + x; на театр: 90.", "Угол при библиотеке: 90 + x → углы при основании (90 − x)/2 = 45 − x/2.", "Из театра на библиотеку — 270°; станция южнее на 45 − x/2.", "Пеленг: 270 − 45 + x/2 = 225 + x/2."], "n": ["E — знак при x/2.", "Остальные — неверный угол."], "t": "Пеленг отсчитывается от севера по часовой."},
"27":{"i": "Через суммы баллов.", "s": ["n₁ = 2n, n₂ = n, n₃ = m.", "122n + 63n + 70m = 65(3n + m) → 5m = 10n → m = 2n = n₁."], "n": ["Остальные — неверное уравнение."], "t": "Средние → суммы."},
"28":{"i": "Проекция XR на пол — диагональ PR.", "s": ["PR = √2, XR = √(2 + 16) = 3√2.", "cos = √2/(3√2) = 1/3."], "n": ["Остальные — неверные стороны."], "t": "Угол с горизонталью — прилежащий катет на полу."},
"30":{"i": "Без возвращения.", "s": ["3/8 · 2/7 = 6/56 = 3/28."], "n": ["C — с возвращением.", "Остальные — неверно."], "t": "Второй раз шаров на один меньше."}
}
