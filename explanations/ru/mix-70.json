{
"1":{"i": "Нечётные: 1, 3, 5 → 1/8 + 1/24 + 1/24.", "s": ["3/24 + 2/24 = 5/24. Ответ B."], "n": ["E — честный кубик."], "t": "Складывайте вероятности граней."},
"2":{"i": "Фигура — шестиугольник (4 угла + 2 «вогнутые» вершины).", "s": ["(6 − 2) · 180 = 720°. Ответ E."], "n": ["B — забыли вогнутые углы."], "t": "Считайте вершины."},
"3":{"i": "32 = 2⁵ — может давать одно число (например, 32).", "s": ["Достаточно одного чётного. Ответ A."], "n": ["E — не обязательно."], "t": "Ищите минимальный пример."},
"4":{"i": "Нули = число пятёрок в n!.", "s": ["15!: 5, 10, 15 → 3 нуля; 14! — только 2. Ответ D."], "n": ["A — 2 нуля."], "t": "Считайте множители 5."},
"5":{"i": "Вычтем: y + 2z = 25.", "s": ["x + y + z = (x + 3y + 5z) − 2(y + 2z) = 200 − 50 = 150. Ответ C."], "n": ["Остальные — подбор."], "t": "Комбинируйте уравнения."},
"6":{"i": "1/(k(k + 1)) = 1/k − 1/(k + 1).", "s": ["Телескоп: 1 − 1/100 = 99/100. Ответ A."], "n": ["B — предел."], "t": "Разложите на разность."},
"7":{"i": "Сумма 1 + 3 + … + 17 = 81.", "s": ["3 строки: 81 : 3 = 27. Ответ B."], "n": ["Остальные — арифметика."], "t": "Каждая строка — треть суммы."},
"8":{"i": "10^f = tg x + sec x; (sec x + tg x)(sec x − tg x) = 1 → 10^{−f} = sec x − tg x.", "s": ["g = (2 tg x)/2 = tg x. Ответ D."], "n": ["E — сумма, а не разность."], "t": "sec² − tg² = 1."},
"9":{"i": "x = 3: 27 + 18 + 5 = 10C → C = 5.", "s": ["При x²: A + C = 3 → A = −2. Ответ B."], "n": ["E — это C."], "t": "Удобное x обнуляет скобку."},
"10":{"i": "Сумма за день 1 + … + n = n(n + 1)/2; за 4 дня всем 26n.", "s": ["2n(n + 1) = 26n → n = 12. Ответ E."], "n": ["Остальные не подходят."], "t": "Посчитайте двумя способами."},
"11":{"i": "AM = 6 · AC → коэффициент 6.", "s": ["Отношение площадей 36 — нет в A–D. Ответ E."], "n": ["C — 24."], "t": "Площади ∝ k²."},
"13":{"i": "3k + 2 ≡ 2 (mod 3); квадраты дают 0 или 1.", "s": ["Ни одного. Ответ A."], "n": ["Остальные невозможны."], "t": "Остатки квадратов по 3."},
"14":{"i": "Пересечение задают пары точек на l и пары на m.", "s": ["C(8,2) · C(8,2) = 28 · 28 = 784. Ответ A."], "n": ["E — 64²."], "t": "Четыре точки → одно пересечение."},
"15":{"i": "НОД(2¹⁵ + 3¹⁵, 2²⁵ + 3²⁵) = 2^{НОД} + 3^{НОД} при нечётных частных.", "s": ["НОД(15, 25) = 5 → 2⁵ + 3⁵ = 275. Ответ D."], "n": ["A, C — только делители."], "t": "a^{km} + b^{km} делится на a^k + b^k при нечётном m."},
"16":{"i": "1/1024 = 5¹⁰/10¹⁰ = 0,0009765625.", "s": ["5¹⁰ = 9 765 625 → сумма цифр 40. Ответ B."], "n": ["C — 41."], "t": "1/2¹⁰ = 5¹⁰/10¹⁰."},
"17":{"i": "Телескоп: y₁₀₀ − y₀.", "s": ["cos π − cos 0 = −2. Ответ A."], "n": ["C — сумма cos."], "t": "Промежуточные сокращаются."},
"18":{"i": "7n + 10 = 8n + 5 → n = 5, карт 45.", "s": ["45 = 9 · 5 → x = 9. Ответ C."], "n": ["B — это n."], "t": "Составьте уравнение."},
"19":{"i": "a³, …, a⁹ повторяются с периодом 7.", "s": ["b = a^k, b² = a^{2k}: 2k ≡ k (mod 7), k ≥ 3 → k = 7. Ответ C."], "n": ["Остальные — не кратны 7."], "t": "Цикл длины 7."},
"20":{"i": "x − 2 кратно НОК(3, 5, 6) = 30.", "s": ["x = 32 → 3 + 2 = 5. Ответ B."], "n": ["A — x = 2 исключён."], "t": "НОК."},
"21":{"i": "0,5¹⁰⁰ = 5¹⁰⁰/10¹⁰⁰; 5ⁿ при чётном n ≥ 4 оканчивается на …625.", "s": ["Третья ненулевая цифра справа — 6. Ответ D."], "n": ["A — 125 при нечётном n."], "t": "Последние цифры 5ⁿ."},
"23":{"i": "«Британский флаг»: AE² + CE² = BE² + DE².", "s": ["AE² = 16 + 64 − 25 = 55 → √55. Ответ D."], "n": ["A — √60."], "t": "Для любой точки в прямоугольнике."},
"24":{"i": "√(2 + 2cos θ) = 2cos(θ/2).", "s": ["a₁ = 2cos(π/4) → a₄ = 2cos(π/32). Ответ E."], "n": ["D — на шаг меньше."], "t": "Каждый шаг делит угол на 2."},
"25":{"i": "При 45° поверхность опускается на диаметр 6 по высоте.", "s": ["Уровни 10 и 4 → средний 7; V = 9π · 7 = 63π. Ответ B."], "n": ["D — средний 25/3."], "t": "Срез — средняя высота."},
"26":{"i": "2¹⁶ · 16! = 2 · 4 · … · 32 (все чётные до 32).", "s": ["Нечётные × чётные = 32!. Ответ C."], "n": ["B — 31!."], "t": "2k · k! = произведение чётных."},
"27":{"i": "sin 20° ≈ 0,342 (рад) → cos(sin 20°) ≈ 0,942.", "s": ["cos 20° ≈ 0,940; cos(cos 20°) ≈ 0,59; синусы меньше. Ответ C."], "n": ["E — чуть меньше."], "t": "Аргумент в радианах."},
"28":{"i": "Каждый внешний треугольник имеет стороны двух квадратов и угол 180° − угол ABC.", "s": ["sin(180° − α) = sin α → площади равны. Ответ E."], "n": ["A–D — частные случаи."], "t": "S = ½ab sin C."},
"29":{"i": "54 = 110110₂ — четыре единицы.", "s": ["Нечётных коэффициентов 2⁴ = 16. Ответ D."], "n": ["B — 2³."], "t": "Теорема Люка."},
"30":{"i": "Из видов 1 и 3: вокруг грани 1 — 3 (верх), 2, 4 (низ).", "s": ["Во втором виде 3 соседствует с 4 — а верх 3 противоположен 4, значит это другая грань с 3. Ответ C."], "n": ["Остальные не дают противоречия."], "t": "Противоположные грани не соседствуют."}
}
