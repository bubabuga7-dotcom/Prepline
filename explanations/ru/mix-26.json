{
"1":{"i": "Раскладываем квадратный трёхчлен на множители (метод «ac»).", "s": ["a · c = 6 · (−15) = −90; ищем числа с произведением −90 и суммой −1: −10 и 9.", "6x² − 10x + 9x − 15 = 2x(3x − 5) + 3(3x − 5) = (2x + 3)(3x − 5).", "x = −3/2 или x = 5/3."], "n": ["A, B, C, E — проверка подстановкой не даёт 0."], "t": "Проверка Виета: сумма корней = 1/6, произведение = −15/6 ✓."},
"2":{"i": "«Наименьшее число, для которого оба — делители» = НОК.", "s": ["НОК(10, 32) = 160.", "НОК(6, 20) = 60.", "160 − 60 = 100."], "n": ["D (160) — только первый НОК.", "A, B, E — неверно."], "t": "НОК = произведение ÷ НОД: 10 · 32 / 2 = 160."},
"3":{"i": "6s² = s³ → s = 6.", "s": ["V = 6³ = 216."], "n": ["Остальные — не кубы числа 6."], "t": "Объём спрашивают, а не ребро."},
"4":{"i": "Чётность: чётное · любое = чётное.", "s": ["A: x³y² чётное ✗.", "B: xy + 2 чётное → квадрат чётный ✗.", "C: xy² чётное и положительное (≥ 2) → xy² − 1 нечётное и ≥ 1 ✓.", "D: x + y может быть отрицательным (2 + (−5)).", "E: не обязательно целое."], "n": ["См. шаги."], "t": "Проверка на числах: x = 2, y = −1."},
"5":{"i": "Перпендикуляр: наклон −1/k.", "s": ["Наклон AB = (3 − (−3))/(4 − (−4)) = 6/8 = 3/4.", "Перпендикуляр: −4/3."], "n": ["D (3/4) — наклон самого AB.", "A, C, E — неверно."], "t": "k₁ · k₂ = −1. (Исходный ключ D — исправлено.)"},
"6":{"i": "Все треугольники подобны треугольнику 3-4-5.", "s": ["Средний: катеты 15 и 20 → гипотенуза 25.", "Нижний: гипотенуза 15 → катеты 9 и 12; b = 9 (меньший катет).", "Верхний: катет 25 — меньший (3 части) → гипотенуза a = 25 · 5/3 = 125/3.", "a − b = 125/3 − 27/3 = 98/3."], "n": ["Остальные — другие соответствия сторон."], "t": "Отношение 3 : 4 : 5 сохраняется во всех подобных треугольниках."},
"8":{"i": "Наибольший конус: радиус s/2, высота h.", "s": ["Пирамида: s²h/3.", "Конус: π(s/2)²h/3 = πs²h/12.", "Разность: s²h/3 · (1 − π/4)."], "n": ["D — без деления на 3.", "C — π/3.", "B, E — неверно."], "t": "Окружность, вписанная в квадрат, имеет радиус s/2."},
"9":{"i": "Разность квадратов: 1/x² − 1/y² = (1/x + 1/y)(1/x − 1/y).", "s": ["½ · ¼ = 1/8."], "n": ["A, B, C, E — пытались найти x и y по отдельности с ошибками."], "t": "Не нужно решать систему."},
"10":{"i": "Каждый шаг: сторона треугольника R√3, радиус вписанной окружности R/2.", "s": ["1-й треугольник: R√3; вписанная окружность R/2.", "2-й треугольник: (R/2)√3; окружность R/4.", "3-й треугольник: (R/4)√3 = R√3/4."], "n": ["C — ещё один шаг.", "B, D — без √3.", "E — два лишних шага."], "t": "В равностороннем треугольнике r = R/2."},
"11":{"i": "Виета.", "s": ["x² − 6x + 8 = 0."], "n": ["Остальные — неверные знаки/коэффициенты."], "t": "Корни 2 и 4 ✓."},
"12":{"i": "Метод сложения.", "s": ["4x + 6y = 12; 9x − 6y = −51.", "13x = −39 → x = −3; y = 4."], "n": ["Остальные пары не проходят оба уравнения."], "t": "Проверка: −6 + 12 = 6 ✓; −9 − 8 = −17 ✓."},
"13":{"i": "Параллельные прямые → равные (соответственные) и смежные углы.", "s": ["На прямой a между c и d: 3x − 5 = 2x + 15 → x = 20 → угол 55°.", "На прямой b: 5y − 25 + 55 = 180 (односторонние) → y = 30.", "x + y = 50."], "n": ["Остальные — неверное соотношение углов."], "t": "Внутренние односторонние углы дают 180°."},
"14":{"i": "Период «18» из двух цифр → /99.", "s": ["N = 18/99 = 2/11."], "n": ["A (2/9) — 0,222…", "C, D, E — неверно."], "t": "Проверка: 2 ÷ 11 = 0,1818…"},
"15":{"i": "Уравнение прямой, затем y = 0.", "s": ["Наклон (2 + 4)/(3 − 1) = 3.", "y = 3x − 7 → x = 7/3 → (7/3; 0)."], "n": ["B, D — это точки на оси y.", "A, C — неверно."], "t": "Пересечение с осью x: y = 0."},
"16":{"i": "Сумма углов 180°.", "s": ["15x = 180 → x = 12.", "A = 78°, B = 38°, C = 64°.", "78 − 38 = 40°."], "n": ["Остальные — неверный x."], "t": "Проверка: 78 + 38 + 64 = 180 ✓."},
"17":{"i": "Катеты = гипотенуза/√2.", "s": ["Катет = 12/√2 → квадрат катета = 72.", "S = ½ · 72 = 36."], "n": ["E — без ½.", "A, B, D — неверно."], "t": "S = c²/4 для равнобедренного прямоугольного."},
"18":{"i": "2 части = 16 → 1 часть = 8.", "s": ["10 · 8 = 80."], "n": ["Остальные — неверно."], "t": "Найдите одну часть."},
"19":{"i": "Группируем полный квадрат и используем разность квадратов.", "s": ["4x² + 4x + 1 = (2x + 1)².", "(2x + 1)² − y² = (2x + 1 − y)(2x + 1 + y)."], "n": ["Остальные — знаки не совпадают при раскрытии."], "t": "Ищите a² − b²."},
"20":{"i": "Делим одно равенство на другое.", "s": ["xyz / (y²z) = x/y = 4/5 = 0,8."], "n": ["C — перевёрнуто.", "A, B, D — неверно."], "t": "Деление убирает z."},
"21":{"i": "Правильный восьмиугольник: центральный угол 45°.", "s": ["Между отрезками три стороны.", "x = 3 · 45° = 135°."], "n": ["E — 150° для 12-угольника.", "A, B, C — неверно."], "t": "360°/8 = 45°."},
"22":{"i": "Проверяем a² + b² = c².", "s": ["I: 64 + 225 = 289 = 17² ✓.", "II: 49 + 576 = 625 = 25² ✓.", "III: 81 + 1600 = 1681 = 41² ≠ 42² ✗."], "n": ["D, E — включают III."], "t": "9-40-41 — настоящая тройка, 42 — ловушка."},
"23":{"i": "Переносим всё влево.", "s": ["2x² − 5x − 3 = 0 → (2x + 1)(x − 3) = 0.", "x = −½ или 3."], "n": ["Остальные не удовлетворяют уравнению."], "t": "Проверка x = 3: 13 = 13 ✓."},
"24":{"i": "По графику: ветви вниз, вершина (−1; 6), пересечение с осью y в 5.", "s": ["a < 0, c = 5.", "Вершина x = −b/(2a) = −1 → b = −2 при a = −1.", "f(x) = −x² − 2x + 5. Проверка: f(−1) = −1 + 2 + 5 = 6 ✓."], "n": ["A, D — ветви вверх.", "B — вершина при x = 1.", "C — c = −5."], "t": "Свободный член = точка пересечения с осью y."},
"25":{"i": "Прямая пропорциональность: n/m = const.", "s": ["n/m = 5/4.", "n = 5/4 · 5 = 6,25."], "n": ["E (7,75) — неверно.", "A — обратная пропорциональность."], "t": "(Исходный ключ E — исправлено.)"},
"26":{"i": "НОК через простые множители.", "s": ["2⁴ · 3² · 5 = 720."], "n": ["A — 2³.", "B, C, E — не делятся на все три."], "t": "Проверка делением."},
"27":{"i": "Выражаем x и z через y.", "s": ["x = y + 1, z = y + 2.", "3y + 3 = 0 → y = −1, x = 0, z = 1."], "n": ["Остальные не проходят все три уравнения."], "t": "Подставьте варианты — быстро."},
"28":{"i": "Нечётное · нечётное = нечётное.", "s": ["I: mn нечётное ✓.", "II: m/n — не обязательно целое (3/5) ✗.", "III: mn + 1 чётное → квадрат чётный ✗."], "n": ["Остальные включают II или III."], "t": "Проверка: m = 3, n = 5."},
"29":{"i": "Поворот на 90° по часовой: (x; y) → (y; −x); отражение в оси x: (x; y) → (x; −y).", "s": ["A(1; 1) → (1; −1) → (1; 1).", "B(2; 3) → (3; −2) → (3; 2).", "C(4; 2) → (2; −4) → (2; 4)."], "n": ["D — без отражения.", "A, B, E — неверный поворот."], "t": "Итог двух преобразований = отражение в прямой y = x."},
"30":{"i": "Формула включений-исключений.", "s": ["Хоть что-то любят: 100 − 15 = 85.", "Оба: 66 + 32 − 85 = 13."], "n": ["Остальные — неверно."], "t": "|A ∪ B| = |A| + |B| − |A ∩ B|."}
}
