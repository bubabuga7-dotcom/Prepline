{
"1":{"i": "Внутренний + внешний = 180°.", "s": ["Внешний = (180 − 150)/2 = 15°.", "n = 360/15 = 24."], "n": ["Остальные — неверный внешний угол."], "t": "Через внешний угол — проще всего."},
"2":{"i": "20:24 = 8:24.", "s": ["Минутная: 24 · 6 = 144°.", "Часовая: 8 · 30 + 24 · 0,5 = 252°.", "252 − 144 = 108°."], "n": ["Остальные — без сдвига часовой стрелки."], "t": "Часовая стрелка: 0,5° в минуту."},
"3":{"i": "x(y + 1) = xy + x.", "s": ["x = 5/3 − 7/6 = ½; y = 7/2 − 7/6 = 7/3.", "(x + 1)(y + 1) = 3/2 · 10/3 = 5."], "n": ["Остальные — арифметика."], "t": "Или: xy + x + y + 1 = 7/6 + ½ + 7/3 + 1 = 5."},
"4":{"i": "Продолжения AC и HF отсекают по 1 с каждой стороны от DE.", "s": ["Внешний угол восьмиугольника 45°: C выше D на 1/√2 и левее на 1/√2.", "Прямая AC доходит до уровня DE ещё на 1 − 1/√2 левее.", "PD = 1, EQ = 1 → PQ = 3."], "n": ["Остальные — неверный наклон AC."], "t": "Удобно ввести координаты."},
"5":{"i": "Отмеченные углы — углы двух многоугольников, образованных пересечением.", "s": ["Каждая тройка отмеченных углов вместе с углом пересечения даёт 360° вокруг точки/в четырёхугольнике.", "Итого 2 · 360° = 720°."], "n": ["Остальные — неверный счёт."], "t": "Сумма углов четырёхугольника 360°."},
"6":{"i": "Сторона квадрата 5, ромб QRTU со стороной 5 и высотой 20/5 = 4.", "s": ["U = (3; 4) относительно Q.", "Часть ромба вне квадрата — треугольник с катетами 3 и 4: 6.", "Внутри квадрата: 20 − 6 = 14 → закрашено 25 − 14 = 11."], "n": ["A — 25 − 20.", "Остальные — неверно."], "t": "QU = 5, высота 4 → сдвиг 3 (3-4-5)."},
"7":{"i": "2(a + b) = 3(a − b).", "s": ["a = 5b → 5 : 1."], "n": ["Остальные — ошибки в знаках."], "t": "Проверка: 12 = 3 · 4 ✓."},
"8":{"i": "Подставляем варианты.", "s": ["60 + 30 = 90; 24 − 9 = 15 ✓."], "n": ["Остальные — не дают сумму 90 или разницу 15."], "t": "Сначала проверьте сумму."},
"10":{"i": "2x + 3y = 6x − y → y = x.", "s": ["(7x − x)/(2x) = 3."], "n": ["Остальные — неверно."], "t": "Найдите связь x и y."},
"11":{"i": "AI = IY, угол при Y между севером (на A) и I — 60° → треугольник равносторонний.", "s": ["Обратный пеленг: 060° + 180° = 240°."], "n": ["Остальные — неверно."], "t": "Обратный пеленг ±180°."},
"12":{"i": "Теорема синусов.", "s": ["PR/sin 45° = √6/sin 60°.", "PR = √6 · (√2/2)/(√3/2) = 2."], "n": ["Остальные — неверный угол."], "t": "Против известной стороны — известный угол."},
"13":{"i": "ab² = const.", "s": ["144 = 4b² → b = 6."], "n": ["A — b²."], "t": "Тот же вопрос был в mix-44."},
"14":{"i": "Подстановка.", "s": ["2 · 9 · 10⁻⁶ · 2,5 · 10⁴ = 0,45 = 4,5 · 10⁻¹."], "n": ["B — не стандартная форма."], "t": "1 ≤ a &lt; 10."},
"16":{"i": "Вычитаем дроби.", "s": ["(n + 1)/(n + 2) − n/(n + 1) = 1/((n + 1)(n + 2))."], "n": ["A — знак."], "t": "Тот же вопрос был в mix-25."},
"17":{"i": "Нет пересечения ⇔ D &lt; 0.", "s": ["3 и 4: x² + x + 5 = 0, D &lt; 0."], "n": ["Остальные пары пересекаются."], "t": "Приравняйте."},
"18":{"i": "Основание 2.", "s": ["n = 2p + 3q."], "n": ["C — 8 = 2³."], "t": "4 = 2², 8 = 2³."},
"19":{"i": "× 15: 15 : 10 : 12.", "s": ["C = 12 частей = 3000 → часть 250.", "37 · 250 = 9250."], "n": ["D (9000) — ключ ошибочен.", "A — C = 4/5 целого."], "t": "Тот же вопрос был в mix-8. (Исходный ключ D — исправлено.)"},
"20":{"i": "p + q = 3p − 3q → p = 2q.", "s": ["2q²/(5q²) = 2/5."], "n": ["Остальные — неверно."], "t": "Подставьте q = 1."},
"21":{"i": "Отражение в оси x, затем поворот по часовой.", "s": ["(3; −4) → (3; 4) → (4; −3)."], "n": ["B — против часовой."], "t": "По часовой: (x; y) → (y; −x)."},
"22":{"i": "Подставляем.", "s": ["2a + b = 7; −a + 4b = 7 → a = b = 7/3.", "a + b = 14/3."], "n": ["Остальные — неверно."], "t": "Вычтите уравнения."},
"23":{"i": "Четыре четверти = круг.", "s": ["(2r)² − πr² = r²(4 − π)."], "n": ["E — знак."], "t": "Сторона квадрата 2r."},
"24":{"i": "0,5 · 1,2 · 0,7 = 0,42.", "s": ["84 / 0,42 = 200."], "n": ["Остальные — сложили проценты."], "t": "Множители перемножаются."},
"25":{"i": "x² + 2x − 8 ≥ 0 → (x + 4)(x − 2) ≥ 0.", "s": ["x ≤ −4 или x ≥ 2."], "n": ["D — знаки корней."], "t": "≥ 0 — снаружи."},
"26":{"i": "Вторая дробь — четверть первой.", "s": ["(1 + ¼) = 5/4 → 5√11/(3√11 + 16)."], "n": ["Остальные — изменён знаменатель."], "t": "Выносите общий множитель."},
"27":{"i": "Z + 35 + Z = 140.", "s": ["Z = 52,5, M = 87,5 → 5 : 3."], "n": ["Остальные — неверно."], "t": "Сократите на 17,5."},
"28":{"i": "НОК = 180 с.", "s": ["3600 / 180 = 20."], "n": ["Остальные — неверный НОК."], "t": "Тот же вопрос был в mix-5."},
"29":{"i": "Каждый вписанный квадрат — половина площади предыдущего.", "s": ["256 → 128 → 64 → 32.", "Закрашено: 64 − 32 = 32."], "n": ["C — 16."], "t": "Вершины на серединах → площадь ÷ 2."},
"30":{"i": "½ · a · 2a = 18 → a² = 18.", "s": ["c² = a² + 4a² = 90 → 3√10."], "n": ["Остальные — неверно."], "t": "c = a√5."}
}
