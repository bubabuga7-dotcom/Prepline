{
"1":{"i": "Расстояние до y = 2x − 1 пропорционально |2x − y − 1|.", "s": ["A: 2, B: −2, C: −2, D: −4, E: 2 → у D модуль 4, у остальных 2. Ответ D."], "n": ["Остальные — на одинаковом расстоянии."], "t": "Подставьте точки в 2x − y − 1."},
"2":{"i": "Вода × 1,09 = 40.", "s": ["40 : 1,09 ≈ 36,7 см³. Ответ A."], "n": ["E — 40 · 0,91 + …"], "t": "Делите на 1,09, а не вычитайте 9%."},
"3":{"i": "x² < 9 → −3 < x < 3; 2x + 3 ≥ 1 → x ≥ −1.", "s": ["−1 ≤ x < 3 (в варианте E минус потерян при наборе). Ответ E."], "n": ["B, C — только одно условие."], "t": "Пересечение условий."},
"4":{"i": "∠RTS = 180 − 126 = 54° = ∠P → RT ∥ QP → △SRT ~ △SQP.", "s": ["QR = RS → k = ½ → площадь QSP = 4 · c/2 = 2c. Ответ D."], "n": ["C — k вместо k²."], "t": "Площади ∝ k²."},
"5":{"i": "JK = 2; M — вершина прямого угла: JM = √2, расстояние от M до JK = 1.", "s": ["Высота L до JK = √3 → LM = √3 − 1 ≈ 0,732. Ответ D."], "n": ["C — 2/3."], "t": "Медиана из прямого угла = половина гипотенузы."},
"6":{"i": "Возводим в квадрат: 4x³y⁶/z.", "s": ["Ответ B."], "n": ["C — y⁵."], "t": "(x^{3/2})² = x³."},
"7":{"i": "y = 2x − 5 → 4x² + (2x − 5)² + 10(2x − 5) = 47.", "s": ["8x² − 25 = 47 → x = 3, y = 1. Ответ A."], "n": ["Остальные не подходят."], "t": "Подстановка."},
"8":{"i": "ab² = 9 · 16 = 144.", "s": ["4b² = 144 → b = 6. Ответ A."], "n": ["B — без квадрата."], "t": "Обратная пропорциональность квадрату."},
"10":{"i": "Смещения 1, ½, ½.", "s": ["√(1 + ¼ + ¼) = √(3/2). Ответ B."], "n": ["C — √(5)/2."], "t": "Пространственный Пифагор."},
"11":{"i": "(x − 1,5)² + (y − 0,5)² = 9.", "s": ["x² − 3x + y² − y + 2,5 − 9 = 0; × 2: 2x² − 6x + 2y² − 2y − 13 = 0. Ответ C."], "n": ["A — знак при y."], "t": "Раскройте и умножьте на 2."},
"12":{"i": "× 6: 3(x + 5) − 2(2x − 1) = 24.", "s": ["−x + 17 = 24 → x = −7. Ответ C."], "n": ["A — знак при 1."], "t": "Избавьтесь от знаменателей."},
"13":{"i": "x² < 4 → −2 < x < 2; x ≥ 1.", "s": ["1 ≤ x < 2. Ответ C."], "n": ["B — строгий знак не там."], "t": "Пересечение."},
"14":{"i": "Числитель 3,27846·10⁶.", "s": ["3,27846·10⁶ / 1,623·10¹¹ ≈ 2,02·10⁻⁵ = 0,0000202. Ответ B."], "n": ["A — без 2."], "t": "3,246 / 1,623 = 2."},
"15":{"i": "Расстояние от прямого угла до гипотенузы = r → катеты r√2, площадь r².", "s": ["r² − πr²/4 = (1 − π/4)r². Ответ A."], "n": ["E — квадрат 2r²."], "t": "Касательная ⟂ радиусу."},
"16":{"i": "Числитель 2800; знаменатель 0,0004 + 0,0003 = 0,0007.", "s": ["2800 / 0,0007 = 4·10⁶ → √ = 2000. Ответ E."], "n": ["C — ошибка в порядке."], "t": "1/2500 = 0,0004."},
"17":{"i": "2/x + 1 = (y − 3)².", "s": ["2/x = (y − 3)² − 1 = (y − 4)(y − 2) → x = 2/((y − 4)(y − 2)). Ответ A."], "n": ["D — знаки."], "t": "Разность квадратов."},
"18":{"i": "(x − 4)(x + 4)/((x + 2)(x + 4)) = (x − 4)/(x + 2) = y.", "s": ["x − 4 = xy + 2y → x = (2y + 4)/(1 − y). Ответ B."], "n": ["D — знак."], "t": "Сократите, затем выразите x."},
"19":{"i": "Боковые (62 − 32)/2 = 15; проекция (25 − 7)/2 = 9 → h = 12.", "s": ["Горизонталь от W до Y: 9 + 7 = 16 → WY = √(256 + 144) = 20. Ответ C."], "n": ["A — боковая сторона."], "t": "Опустите высоту из Y."},
"20":{"i": "AB ∥ CD → △ABE ~ △DCE: AE/DE = BE/CE.", "s": ["2/5 = x/(6 + x) → 3x = 12 → x = 4. Ответ A."], "n": ["C — 6 + x − 2."], "t": "«Бабочка»."},
"21":{"i": "Хорда CD = 2 = r → центральный угол 60°.", "s": ["Сегмент: 4π/6 − √3 ≈ 2,094 − 1,732 = 0,362. Ответ A."], "n": ["Остальные — другой сегмент."], "t": "Сектор − треугольник."},
"22":{"i": "Множитель: 1,5² · 0,8 / 2 = 0,9.", "s": ["Уменьшение на 10%. Ответ A."], "n": ["B — знак."], "t": "Перемножьте множители."},
"23":{"i": "∠BDC = ∠BAC (опираются на дугу BC); ∠ABC = 90°.", "s": ["BC = √(400 − 144) = 16 → sin = 16/20 = 0,8. Ответ C."], "n": ["A — cos."], "t": "Вписанные углы на одну дугу равны."},
"24":{"i": "t² = 8πlR²(W + w/3)/(n r⁴ g).", "s": ["W = n r⁴ g t²/(8πlR²) − w/3. Ответ A."], "n": ["B — лишний корень."], "t": "4π² · 2/π = 8π."},
"25":{"i": "Минутная 270°, часовая 270 + 22,5 = 292,5°.", "s": ["22,5°. Ответ D."], "n": ["A — без сдвига часовой."], "t": "Часовая: 0,5° в минуту."},
"26":{"i": "I: FD и GA — параллельные диагонали боковых граней ✔.", "s": ["II: △GCF и △AHD — равные прямоугольные треугольники с катетами-рёбрами ✔.", "III: AF и GD — диагонали куба ✔. Ответ E."], "n": ["Все три верны."], "t": "Проверяйте каждое."},
"27":{"i": "6Σd²/(n(n² − 1)) = 1 − r.", "s": ["Σd² = (1 − r)(n³ − n)/6. Ответ E."], "n": ["D — 1 + r.", "C — n³ − 1."], "t": "n(n² − 1) = n³ − n."},
"28":{"i": "Наклон 4y + 3x = 8: −3/4 → перпендикуляр 4/3.", "s": ["3(y − 2) = 4(x + 6) → 3y − 4x = 30. Ответ D."], "n": ["A — неверная константа."], "t": "k₁k₂ = −1."},
"29":{"i": "√(1,6·10⁷) = 4000; (1,2·10³)² = 1,44·10⁶.", "s": ["8·10⁻⁵ / 4000 = 2·10⁻⁸; × 1,44·10⁶ = 2,88·10⁻². Ответ B."], "n": ["A — порядок."], "t": "Считайте мантиссы и степени отдельно."},
"30":{"i": "32^{1/5} = 2, 9⁰ = 1, 81^{3/4} = 27.", "s": ["(3/27)⁻¹ = 9. Ответ B."], "n": ["A — 9⁰ = 9."], "t": "Любое число в степени 0 = 1."}
}
