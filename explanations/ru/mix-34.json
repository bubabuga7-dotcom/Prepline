{
"1":{"i": "Умножаем всё на 6, чтобы убрать дроби.", "s": ["3(x − 2) − 4(3 − x) &lt; 6(x − 4).", "3x − 6 − 12 + 4x &lt; 6x − 24 → 7x − 18 &lt; 6x − 24.", "x &lt; −6."], "n": ["A — перевёрнут знак.", "C, D, E — ошибки при раскрытии скобок."], "t": "−⅔(3 − x) = −2 + ⅔x — следите за знаком."},
"2":{"i": "Возводим дробь в квадрат, затем умножаем на 1/10.", "s": ["(5x³y^½ / z^(3/2))² = 25x⁶y/z³.", "25/10 = 5/2 → 5x⁶y/(2z³)."], "n": ["A, B — забыли 1/10.", "D — без 2 в знаменателе.", "E — неверно."], "t": "(y^½)² = y; (z^(3/2))² = z³."},
"3":{"i": "Сторона = периметр/4, площадь = сторона².", "s": ["Сторона: 9 − √3.", "(9 − √3)² = 81 − 18√3 + 3 = 84 − 18√3."], "n": ["A — забыли (√3)² = 3.", "C, E — это не площадь.", "D — неверное удвоенное произведение."], "t": "(a − b)² = a² − 2ab + b²."},
"4":{"i": "Упрощаем корни во второй скобке.", "s": ["√24 = 2√6 → вторая скобка = √6.", "(√12 − √8) · √6 = √72 − √48 = 6√2 − 4√3."], "n": ["D — знаки наоборот.", "A, C, E — неверные корни."], "t": "√72 = 6√2, √48 = 4√3."},
"5":{"i": "Умножаем на p и собираем S.", "s": ["S = pq(S − r) = pqS − pqr.", "pqr = pqS − S = S(pq − 1).", "S = pqr/(pq − 1)."], "n": ["A — знак в знаменателе.", "B — знак числителя.", "C, D — неверно."], "t": "Все слагаемые с S — в одну сторону."},
"6":{"i": "Дуга RQ с центром P → PR = PQ = x; дуга PR с центром Q → QR = QP = x.", "s": ["Все стороны равны x → треугольник равносторонний.", "S = (√3/4)x²."], "n": ["D (x²/4) — без √3.", "A, B, E — неверная формула."], "t": "Радиусы одной дуги равны. (Исходный ключ D — исправлено.)"},
"7":{"i": "y = z/x².", "s": ["x² = 9 · 10⁸.", "2,7 · 10⁶ / (9 · 10⁸) = 0,3 · 10⁻² = 0,003."], "n": ["B, E — ошибка в степени на 2.", "A, D — неверно."], "t": "10⁶/10⁸ = 10⁻²."},
"8":{"i": "Общий знаменатель x²(x − 2).", "s": ["2x(x − 2) + x² − 3(x − 2).", "2x² − 4x + x² − 3x + 6 = 3x² − 7x + 6."], "n": ["A, B, C — неверные числители.", "D — неверный знаменатель."], "t": "Каждый числитель домножаем на недостающий множитель."},
"9":{"i": "Объём = конус + полушар.", "s": ["⅓πr²h + ⅔πr³ = ⅔πr³(1 + h/(2r))."], "n": ["B, C, D — корни здесь ни при чём.", "E — удвоено: ⅔πr²(2r + h) = (4/3)πr³ + ⅔πr²h."], "t": "В варианте A в скане потеряна r: должно быть h/(2r)."},
"10":{"i": "NQ = RQ − RN, обе длины — через катет PR = 8.", "s": ["RQ = 8/tg 36°.", "RN = 8 · tg 25°.", "NQ = 8/tg 36° − 8 tg 25°."], "n": ["A, D, E — угол 44° или половина катета.", "C — cot вместо tg."], "t": "tg угла = противолежащий / прилежащий."},
"11":{"i": "1 км = 1000 м, 1 мин = 60 с.", "s": ["V км/мин = 1000V/60 м/с = 50V/3."], "n": ["B — делили на 3600 (часы).", "Остальные — неверно."], "t": "Минуты, а не часы."},
"12":{"i": "Касательная ⊥ радиусу ON.", "s": ["Наклон ON: 6/4 = 3/2 → касательная −2/3.", "y − 6 = −⅔(x − 4) → y = −2x/3 + 26/3."], "n": ["C — неверный свободный член.", "B — наклон не тот.", "D, E — неверно."], "t": "k₁ · k₂ = −1."},
"14":{"i": "Оставшееся = n · ¾ · ⅗.", "s": ["После еды: ¾n.", "Отдала ⅖ → осталось ⅗ · ¾n = 9n/20."], "n": ["A, D — отданная часть.", "C, E — неверно."], "t": "«Of the remaining» — от остатка."},
"15":{"i": "Диагонали ромба перпендикулярны и проходят через N.", "s": ["Наклон PR: 2 → QS: −½.", "y − 3 = −½(x − 2) → y = −x/2 + 4."], "n": ["E — знак наклона не тот.", "A, B, C — неверно."], "t": "Диагонали ромба — перпендикулярны."},
"16":{"i": "Угол 3x − 80 отмечен как больший (рефлексный) угол в центре; меньший центральный = 2 · вписанный.", "s": ["Меньший центральный угол: 360 − (3x − 80) = 440 − 3x.", "440 − 3x = 2(x − 15) → 470 = 5x → x = 94.", "x + 3° = 97°."], "n": ["Остальные — взяли меньший угол как 3x − 80."], "t": "Посмотрите, какой угол отмечен дугой в центре."},
"17":{"i": "PS — общий катет двух прямоугольных треугольников.", "s": ["RS = k, SQ = 2k.", "PS² = 36b² − k² = 144a² − 4k² → 3k² = 144a² − 36b² → k² = 48a² − 12b².", "PS² = 36b² − 48a² + 12b² = 48(b² − a²)."], "n": ["A, B, D, E — неверно составлены уравнения."], "t": "Приравняйте два выражения для PS²."},
"18":{"i": "3p/(4q) = 8/21.", "s": ["p/q = 8 · 4/(21 · 3) = 32/63."], "n": ["A — без коэффициентов 3 и 4.", "C — перевёрнуто.", "D, E — неверно."], "t": "Перемножайте крест-накрест."},
"19":{"i": "Путь = площадь под графиком скорость–время.", "s": ["½ · 10 · p + 30 · p + ½ · 20 · p = 45p.", "45p = 1260 → p = 28."], "n": ["Остальные — неверная площадь трапеции."], "t": "Трапеция: ½(60 + 30) · p = 45p."},
"20":{"i": "Находим k из наклона, затем уравнение прямой.", "s": ["((1 − k) − 1)/(7 − 2k − 1) = −k/(6 − 2k) = ¼ → k = −3.", "P(−5; 1), Q(7; 4).", "y = 1 + ¼(x + 5) → при x = 0: r = 9/4."], "n": ["Остальные — неверный k."], "t": "Проверка: (4 − 1)/(7 + 5) = ¼ ✓."},
"21":{"i": "Фигура = треугольник ABC + треугольник ACD.", "s": ["S(ABC) = ½ · 3 · 5 = 7,5; AC = √34.", "Подобие: AB/AC = BC/CD → CD = 3√34/5.", "S(ACD) = ½ · √34 · 3√34/5 = 10,2.", "Итого 17,7."], "n": ["Остальные — неверное соответствие сторон."], "t": "Прямые углы B и C — соответственные."},
"22":{"i": "Вершина x = −p/2.", "s": ["−p/2 = 1,5 → p = −3.", "2,25 − 4,5 + q = 4 → q = 6,25.", "q − p = 9,25."], "n": ["A — знак.", "Остальные — неверно."], "t": "Подставьте вершину в уравнение, чтобы найти q."},
"23":{"i": "У дельтоида два противоположных угла равны (S = Q).", "s": ["x + 2x + 3x + 3x = 360 → 9x = 360 → x = 40."], "n": ["Остальные — не учли, что четвёртый угол равен 3x."], "t": "Сумма углов четырёхугольника 360°."},
"24":{"i": "Площадь правильного 12-угольника через радиус: 12 · ½R² sin 30°.", "s": ["12 · ½ · 36 · ½ = 108.", "Шестиугольник: (3√3/2)x² = 108 → x² = 72/√3 = 24√3."], "n": ["A — удвоено.", "Остальные — неверно."], "t": "Площадь 12-угольника = 3R²."},
"25":{"i": "RV ∥ LU → треугольники QRV и QLU подобны.", "s": ["36/(33 + 3x) = 30/(30 + 2x) → 18x = 90 → x = 5.", "LU = 40, LQ = 48.", "VQ = √(36² − 30²) = 6√11; UQ = √(48² − 40²) = 8√11.", "VU = 2√11."], "n": ["Остальные — неверно."], "t": "LQ = LR + RQ = 12 + 36."},
"27":{"i": "y = (x − q)² + r — вершинная форма.", "s": ["Вершина по графику (3; −4) → r = −4."], "n": ["B — знак.", "C — это q.", "D, E — корни/перехват."], "t": "x² − 2xq + q² = (x − q)²."},
"28":{"i": "s = k√t → s² ∝ t.", "s": ["(45/36)² = 1,5625.", "t = 0,4 · 1,5625 = 0,625."], "n": ["A — линейно.", "Остальные — неверно."], "t": "Квадрат отношения s."},
"29":{"i": "Все рёбра 6; высота из прямоугольного треугольника с полудиагональю.", "s": ["Полудиагональ основания: 3√2.", "h = √(36 − 18) = 3√2.", "V = ⅓ · 36 · 3√2 = 36√2."], "n": ["A — без √2.", "Остальные — неверно."], "t": "Боковое ребро, высота и полудиагональ — прямоугольный треугольник."},
"30":{"i": "Апофема — катет прямоугольного треугольника с полустороной 4.", "s": ["Центральный угол на сторону: 72° → половина 36°.", "Угол между стороной и радиусом: 54°.", "Апофема = 4 · tg 54°."], "n": ["A, C — неверные углы.", "D, E — неверно."], "t": "Апофема = (a/2)·tg 54° для пятиугольника."}
}
