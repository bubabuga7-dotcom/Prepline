{
"2":{"i": "Множитель (x − a) подходит, если при x = a выражение равно 0.", "s": ["x = 1: 6 + 7 − 18 + 5 = 0.", "Значит, x − 1 — множитель."], "n": ["A: x = −1 даёт 24, а не 0.", "E: x = 2 даёт 45."], "t": "Подставляйте число с противоположным знаком."},
"3":{"i": "Площадь трапеции = полусумма оснований × высота.", "s": ["(18x + 10x) : 2 = 14x.", "14x · 3x = 42x²."], "n": ["E — забыли поделить на 2.", "C — поделили лишний раз."], "t": "Боковая сторона L не нужна."},
"4":{"i": "Все 60 таблеток делятся на непересекающиеся группы.", "s": ["12 + 7 + 11 + 6 + 3x = 60, 3x = 24, x = 8.", "С витамином A: только A (12) + A и B (8) + A и C (8) + все три (6) = 34."], "n": ["C — забыли «все три».", "E — лишняя группа."], "t": "Нарисуйте три круга и впишите числа."},
"5":{"i": "Лист = дно + 4 стенки.", "s": ["Объём: x · x · y = 40, значит y = 40/x².", "Дно: x². Стенки: 4 · x · y = 4x · 40/x² = 160/x.", "S = x² + 160/x."], "n": ["C — забыли сократить x.", "E — 8 стенок."], "t": "Крышки нет — только 5 граней."},
"6":{"i": "Касательная BF: BF² = FD · FE.", "s": ["FE = 18 + 14 = 32, BF² = 18 · 32 = 576, BF = 24.", "В прямоугольном треугольнике OBF: OF = r + 16.", "(r + 16)² = r² + 576, 32r = 320, r = 10."], "n": ["A — половина радиуса.", "C — диаметр."], "t": "Радиус в точке касания перпендикулярен касательной."},
"7":{"i": "DE параллельна BC, поэтому ∠ACB = ∠AED.", "s": ["∠ACB = 50°.", "∠BCD = 50° − 30° = 20°."], "n": ["C — это ∠DCE.", "E — весь ∠ACB."], "t": "Соответственные углы при параллельных равны."},
"9":{"i": "Упрощаем корни.", "s": ["4√12 = 8√3; 12√108 = 72√3; 10√128 = 80√2; 8√50 = 40√2.", "(80√3 − 120√2) : 10 = 8√3 − 12√2."], "n": ["A, B — не поделили на 10."], "t": "√108 = 6√3, √128 = 8√2."},
"10":{"i": "Умножаем на (√3 + √2).", "s": ["Знаменатель: 3 − 2 = 1.", "3√2(√3 + √2) = 3√6 + 6."], "n": ["D — знак.", "E — потеряли 3."], "t": "(a − b)(a + b) = a² − b²."},
"11":{"i": "Квадрат и 4 полукруга радиусом a/2.", "s": ["4 полукруга = 2 круга: 2 · π · a²/4 = πa²/2.", "Итого a² + πa²/2."], "n": ["A — посчитали один круг.", "D, E — без квадрата."], "t": "Диаметр полукруга равен стороне."},
"12":{"i": "Число машин пропорционально углу.", "s": ["Жёлтых: 50/360 · 180 = 25.", "Чёрных столько же: 25."], "n": ["B — неверно."], "t": "180 машин на 360° — по 2° на машину."},
"14":{"i": "Приравниваем: одна точка пересечения.", "s": ["x² + bx + 4 = 3x + 4, x² + (b − 3)x = 0.", "Корни 0 и 3 − b. Совпадают при b = 3."], "n": ["B — знак."], "t": "Один корень — когда дискриминант равен 0."},
"15":{"i": "Спортом занимаются 50 − 15 = 35.", "s": ["Оба вида: 25 + 25 − 35 = 15.", "15/50 = 3/10."], "n": ["B — неверно."], "t": "Общих считаем один раз."},
"16":{"i": "По шагам.", "s": ["8 ♦ 2 = √16 = 4.", "4 ♦ 9 = √36 = 6.", "4 ♦ 6 = √24 = 2√6."], "n": ["B — √48."], "t": "√24 = √(4 · 6)."},
"17":{"i": "Выбор мальчиков и девочек независим — перемножаем.", "s": ["Мальчики: 10 · 9 : 2 = 45.", "Девочки: 7 · 6 · 5 : 6 = 35.", "45 · 35 = 1575."], "n": ["Остальные — переставлены цифры."], "t": "Порядок выбора не важен."},
"18":{"i": "Половина — брусок 3 × 3 × 1,5.", "s": ["2 · 9 + 4 · 4,5 = 36."], "n": ["C — половина поверхности куба без новой грани."], "t": "Разрез добавляет грань."},
"19":{"i": "Ребро = ³√216 = 6. «Периметр» куба — сумма 12 рёбер.", "s": ["12 · 6 = 72 см."], "n": ["A — одно ребро.", "B — 4 ребра."], "t": "У куба 12 рёбер."},
"20":{"i": "Сейчас Рону 7k, Гермионе 4k.", "s": ["7k − 10 = 2(4k − 10), k = 10.", "70 + 40 = 110."], "n": ["Остальные — неверно."], "t": "10 лет назад вычитаем у обоих."},
"21":{"i": "Крыша — равнобедренный прямоугольный треугольник с гипотенузой 10.", "s": ["Катет: 10 : √2 = 5√2, два катета: 10√2.", "Периметр: 10 + 8 + 8 + 10√2 = 26 + 10√2."], "n": ["B — один катет."], "t": "Верхняя сторона прямоугольника внутри — не считается."},
"22":{"i": "Мать M, Алекс A.", "s": ["M − 5 = 3(A − 5), M + 5 = 2(A + 5).", "3A − 10 = 2A + 5, A = 15, M = 35."], "n": ["Остальные — неверно."], "t": "Проверка: 30 = 3 · 10; 40 = 2 · 20."},
"23":{"i": "Пусть n учеников ниже 60.", "s": ["50n + 75(20 − n) = 70 · 20.", "1500 − 25n = 1400, n = 4."], "n": ["D — это остальные 16."], "t": "Средние — через суммы."},
"24":{"i": "Убираем дробь и собираем x.", "s": ["y(2x + 1) = 4x − 3.", "2xy − 4x = −3 − y.", "x = (y + 3)/(4 − 2y)."], "n": ["C — знак у 3.", "E — знак в знаменателе."], "t": "Все x — в одну сторону."},
"25":{"i": "Коробки независимы — перемножаем.", "s": ["2/5 · 3/8 = 6/40 = 3/20."], "n": ["E — 3/40 (поделили лишний раз)."], "t": "Красный из первой: 2 из 5."},
"26":{"i": "Совпадают каждые НОК = 180 с.", "s": ["3600 : 180 = 20."], "n": ["Остальные — неверный НОК."], "t": "Тот же вопрос был в mix-5."},
"27":{"i": "Радиус 5.", "s": ["Цилиндр: π · 25 · 10 = 250π.", "Шар: 4/3 · π · 125 = 500π/3.", "250 : 500/3 = 3 : 2."], "n": ["E — перевёрнуто."], "t": "Шар — 2/3 цилиндра."},
"28":{"i": "Убираем корень.", "s": ["(y − 1)² = (x + 3)/x = 1 + 3/x.", "3/x = y² − 2y = y(y − 2).", "x = 3/(y(y − 2))."], "n": ["C — забыли вычесть 1."], "t": "Разбейте (x + 3)/x на 1 + 3/x."},
"29":{"i": "Вместе — через НОК(40, 42).", "s": ["НОК = 840 с = 14 мин.", "10:14."], "n": ["D — удвоенный."], "t": "Тот же вопрос был в mix-6."},
"30":{"i": "НОД всегда делит НОК. 2520 = 2³ · 3² · 5 · 7.", "s": ["49 = 7², а в 2520 только одна семёрка.", "49 не делит 2520 — не может быть НОД."], "n": ["Остальные делят 2520."], "t": "Проверьте деление: 2520 : 49 не целое."}
}
